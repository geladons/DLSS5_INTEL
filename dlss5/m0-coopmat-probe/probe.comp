// M0 cooperative-matrix probe shader (GL_KHR_cooperative_matrix).
// Shape constants M/N/K and SUBGROUP_SIZE are injected by the build via
// glslangValidator -D flags to match the runtime-enumerated device config.
#version 460
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require

#ifndef M
#define M 16
#endif
#ifndef N
#define N 16
#endif
#ifndef K
#define K 16
#endif
#ifndef SUBGROUP_SIZE
#define SUBGROUP_SIZE 32
#endif

layout(local_size_x = SUBGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly  coherent buffer Abuf { float16_t A[]; };
layout(std430, binding = 1) readonly  coherent buffer Bbuf { float16_t B[]; };
#ifdef C_F32
layout(std430, binding = 2) writeonly coherent buffer Cbuf { float C[]; };
#else
layout(std430, binding = 2) writeonly coherent buffer Cbuf { float16_t C[]; };
#endif

void main()
{
    coopmat<float16_t, gl_ScopeSubgroup, M, K, gl_MatrixUseA> mA;
    coopmat<float16_t, gl_ScopeSubgroup, K, N, gl_MatrixUseB> mB;
#ifdef C_F32
    coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> acc;
#else
    coopmat<float16_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator> acc;
#endif

    coopMatLoad(mA, A, 0u, K, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(mB, B, 0u, N, gl_CooperativeMatrixLayoutRowMajor);

#ifdef C_F32
    acc = coopmat<float, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);
#else
    acc = coopmat<float16_t, gl_ScopeSubgroup, M, N, gl_MatrixUseAccumulator>(0.0);
#endif

    acc = coopMatMulAdd(mA, mB, acc);

#ifdef C_F32
    coopMatStore(acc, C, 0u, N, gl_CooperativeMatrixLayoutRowMajor);
#else
    coopMatStore(acc, C, 0u, N, gl_CooperativeMatrixLayoutRowMajor);
#endif
}
