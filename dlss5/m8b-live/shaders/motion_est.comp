#version 460
// SPDX-License-Identifier: Apache-2.0
// ============================================================================
// Block motion estimation for the motion-compensated residual hold
// (v10). One workgroup (64 threads = one per 8x8 pixel) per image block;
// dispatch is (ceil(netW/8), ceil(netH/8), 1). Writes bufMv[block] =
// (mvx, mvy, conf, 0) in NET pixels: the displacement that carries
// content FROM the previous frame's position (x - mvx, y - mvy) INTO
// pixel (x, y) - temporal_nr/temporal_stats warp their E/P/A/R reads by
// this vector so the temporal state follows the content, not the screen
// cell.
//
//   cur luma  = BT.601 of col01 = fv[p*16+4..6] * 8 + 0.5
//   prev luma = BT.601 of P     = hsPrev[3N + p*3 + 0..2]  (last frame's
//               input as stored by temporal_nr - same domain, no decode)
//
// Integer full search over (dx, dy) in [-12,12]^2 of SAD over the block,
// cur(x,y) vs prev(x-dx, y-dy), prev coords clamped to the image. A
// ZERO-MOTION BIAS keeps still content exactly still: (0,0) is chosen
// whenever SAD(0,0) <= SADmin*(1+pc.c[1]) + 64*pc.c[2]/255 - pc.c[1] is
// D5C_MV_ZBIAS (relative slack, default 0) and pc.c[2] is D5C_MV_ZABS
// (absolute slack in units of 64/255, default 1 = half a luma LSB over
// the block). Without it, 1-2 LSB input noise picks a random +-1 vector
// on static regions and the warp would drag state sideways every frame.
// Sub-pixel parabolic refine in x and y on the +-1 SAD neighbours
// applies to EVERY interior pick - including (0,0): the bias only
// settles the INTEGER competition, but a real sub-pixel displacement
// still tilts the SAD landscape (S at the shift-side neighbour drops
// relative to the far side), so the refined offset recovers the drift
// the bias just overrode. Without it a slow sub-pixel zoom leaves whole
// block regions pinned at (0,0) - the residual state stays
// screen-anchored while the content creeps (flow flicker, owner-visible
// judder on the GTA IV loading portrait). Blocks whose final refined
// vector is shorter than pc.c[3] (D5C_MV_SUBT, net pixels) are written
// back as exact (0,0): refined noise on truly static blocks concentrates
// below ~0.1-0.2 px while real drift sits higher, so the threshold keeps
// static regions on the byte-exact v9 path. conf = 1 - SADmin/SAD(0,0)
// is informational.
//
// histValid==0 (reset frame) or ANY out-of-range P tap in the block's
// search window (uninitialised bufHist on the first-ever frame) ->
// mv = (0,0), conf = 0: consumers treat (0,0) as the identity warp and
// their own P/A/R validity still gates the hold.
//
// push a.x = TOK (= netW*netH), a.y = netW, a.z = netH, d.x = histValid;
// c[0] = D5C_MV_EMA (mv EMA weight), c[1] = D5C_MV_ZBIAS, c[2] =
// D5C_MV_ZABS, c[3] = D5C_MV_SUBT (sub-pixel noise floor, net px),
// d[1] = D5C_MV_IMPT ((0,0)-pick refine confidence gate, SAD units),
// d[2] = D5C_RF_MREL (motion-envelope release factor).
//
// bufMv[block] = (mvx, mvy, conf, env): env is the MOTION ENVELOPE for
// residual attenuation (v13) - env = max(|mv|, MREL * env_prev) where
// env_prev is this block's previous-frame .w (same read-modify-write
// lifetime as the EMA prev slot: the buffer persists across frames and
// only this workgroup touches the element). Fast attack on the
// measured motion, exponential release so temporal_nr's attenuation
// gate decays ~60 frames after motion stops (MREL 0.95) instead of
// snapping. Reset/invalid frames write env = 0.
// ============================================================================
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 3) readonly buffer FeatV { float fv[]; };
layout(std430, set = 0, binding = 17) readonly buffer HistPrev { float hsP[]; };
// Read+write: each workgroup EMA-smooths its own block's vector against
// last frame's value (temporal consistency test - real drift keeps one
// direction while refined noise is zero-mean, so the EMA separates slow
// drift from SAD-flat noise jitter far better than a magnitude test).
// The read-modify-write touches only this workgroup's own element and
// consumers run in later dispatches, so no barrier is needed.
layout(std430, set = 0, binding = 18) buffer Mvs { vec4 mvs[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

shared float sCur[64];      // this block's current luma
shared float sPrev[1024];   // 32x32 prev luma window: origin (bx*8-12, by*8-12)
shared float sSad[625];     // SAD per integer offset, idx = (dy+12)*25+(dx+12)
shared float sDc[64];       // per-pixel (0,0) diff for the DC/fade check
shared uint  sBad;          // out-of-range P tap count in the window

void main() {
    const int netW = pc.a.y, netH = pc.a.z;
    const uint N = uint(pc.a.x);
    const int bx = int(gl_WorkGroupID.x), by = int(gl_WorkGroupID.y);
    const uint tid = gl_LocalInvocationID.x;
    if (tid == 0u) sBad = 0u;
    barrier();

    // Current luma (edge blocks clamp their last row/col).
    {
        const int lx = int(tid & 7u), ly = int(tid >> 3);
        const int px = min(bx * 8 + lx, netW - 1);
        const int py = min(by * 8 + ly, netH - 1);
        const uint p = uint(py) * uint(netW) + uint(px);
        sCur[tid] = 0.299 * (fv[p * 16u + 4u] * 8.0 + 0.5)
                  + 0.587 * (fv[p * 16u + 5u] * 8.0 + 0.5)
                  + 0.114 * (fv[p * 16u + 6u] * 8.0 + 0.5);
    }
    // Previous luma: the 32x32 window the search can reach (block origin
    // minus the +-12 range). Same NaN-safe range test temporal_nr uses -
    // uninitialised bufHist fails it.
    for (uint i = tid; i < 1024u; i += 64u) {
        const int rx = int(i & 31u), ry = int(i >> 5);
        const int sx = clamp(bx * 8 - 12 + rx, 0, netW - 1);
        const int sy = clamp(by * 8 - 12 + ry, 0, netH - 1);
        const uint sp = uint(sy) * uint(netW) + uint(sx);
        const float r = hsP[3u * N + sp * 3u + 0u];
        const float g = hsP[3u * N + sp * 3u + 1u];
        const float b = hsP[3u * N + sp * 3u + 2u];
        if (!(r >= -0.01 && r <= 1.01) || !(g >= -0.01 && g <= 1.01)
            || !(b >= -0.01 && b <= 1.01))
            atomicAdd(sBad, 1u);
        sPrev[i] = 0.299 * r + 0.587 * g + 0.114 * b;
    }
    barrier();

    const uint bIdx = gl_WorkGroupID.y * ((uint(netW) + 7u) / 8u)
                    + gl_WorkGroupID.x;
    if (pc.d.x == 0.0 || sBad != 0u) {
        if (tid == 0u) mvs[bIdx] = vec4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    // Integer SAD for every offset, spread across the 64 threads.
    for (uint i = tid; i < 625u; i += 64u) {
        const int dy = int(i / 25u) - 12;
        const int dx = int(i % 25u) - 12;
        float s = 0.0;
        for (int yy = 0; yy < 8; ++yy) {
            const int pr = (yy + 12 - dy) * 32 + (12 - dx);
            for (int xx = 0; xx < 8; ++xx)
                s += abs(sCur[yy * 8 + xx] - sPrev[pr + xx]);
        }
        sSad[i] = s;
    }
    // (0,0)-tap raw diff per pixel, for the DC-corrected still-match:
    // sPrev origin is (bx*8-12, by*8-12) so the identity tap sits at
    // window offset (12,12).
    {
        const int lx = int(tid & 7u), ly = int(tid >> 3);
        sDc[tid] = sCur[tid] - sPrev[(ly + 12) * 32 + (lx + 12)];
    }
    barrier();
    if (tid != 0u) return;

    // DC-corrected (0,0) SAD: remove the block's mean diff, then re-sum.
    // A brightness ramp (fade/exposure/flash) leaves |d - dc| ~= noise,
    // so s0dc beats every displacement the raw SAD "found"; real motion
    // keeps the corrected mismatch large.
    float s0dc;
    {
        float dcs = 0.0;
        for (uint i = 0u; i < 64u; ++i) dcs += sDc[i];
        const float dc = dcs * (1.0 / 64.0);
        float a = 0.0;
        for (uint i = 0u; i < 64u; ++i) a += abs(sDc[i] - dc);
        s0dc = a;
    }
    const uint i00 = 12u * 25u + 12u;          // (dx,dy) = (0,0)
    const float s0 = sSad[i00];
    float sBest = s0;
    uint iBest = i00;
    for (uint i = 0u; i < 625u; ++i) {
        if (sSad[i] < sBest) { sBest = sSad[i]; iBest = i; }
    }
    // DC-corrected still-match (v15): if the (0,0) difference is
    // explained by a per-block brightness offset, the frame changed by
    // a fade/exposure ramp/flash, not by displacement - and the best
    // SAD offset is a spurious "match" the brightness shift let win by
    // luck. Charging the attenuation envelope or warping the residual
    // state on it damps the whole frame for ~60 MREL release frames
    // (the post-transition "enhancement crawl": output visibly re-
    // grows its residual for ~3 s after every GTA IV fade/logo/menu
    // cut - field report + real-dump reproduction 2026-10-12). Fade
    // frames: ~97% of moved blocks DC-explained; real camera motion:
    // ~8-14%. sDc was reduced across the block below.
    float sPick = sBest;
    uint iPick = iBest;
    if (s0dc <= sBest
        || s0 <= sBest * (1.0 + pc.c[1]) + 64.0 * pc.c[2] * (1.0 / 255.0)) {
        // Zero-motion bias: stay exactly still on matches within the
        // pushed slack of the best - static blocks must produce mv=(0,0)
        // so the v9 path is preserved verbatim on still content.
        // pc.c[1]=D5C_MV_ZBIAS (relative term), pc.c[2]=D5C_MV_ZABS
        // (absolute, units of 64/255).
        sPick = s0; iPick = i00;
    }
    int dx = int(iPick % 25u) - 12;
    int dy = int(iPick / 25u) - 12;
    float mvx = float(dx), mvy = float(dy);
    // Parabolic sub-pixel refine on the +-1 SAD neighbours of the pick -
    // run for EVERY interior pick including (0,0): a sub-pixel drift the
    // zero-bias pinned still shows as a SAD slope, and the refined
    // fraction moves the residual state with the content instead of
    // leaving it screen-anchored. imp accumulates the predicted SAD drop
    // at the refined offset (den * delta^2 / 2 per axis) - the evidence
    // that the sub-pixel motion is real.
    float imp = 0.0;
    if (dx > -12 && dx < 12 && dy > -12 && dy < 12) {
        const uint ix = uint(dy + 12) * 25u + uint(dx + 12);
        const uint iy = ix;
        float den = 2.0 * (sSad[ix - 1u] - 2.0 * sPick + sSad[ix + 1u]);
        if (den > 1e-6) {
            const float r = clamp((sSad[ix - 1u] - sSad[ix + 1u]) / den,
                                  -0.5, 0.5);
            mvx += r;
            imp += den * r * r * 0.5;
        }
        den = 2.0 * (sSad[iy - 25u] - 2.0 * sPick + sSad[iy + 25u]);
        if (den > 1e-6) {
            const float r = clamp((sSad[iy - 25u] - sSad[iy + 25u]) / den,
                                  -0.5, 0.5);
            mvy += r;
            imp += den * r * r * 0.5;
        }
    }
    // Confidence gate for (0,0) picks: the sub-pixel case is only accepted
    // when the predicted improvement beats pc.d[1] (D5C_MV_IMPT, SAD
    // units). imp ~ local gradient * drift evidence, so detailed content
    // with real drift passes and SAD-flat blocks (flat sky, codec grain -
    // where a random parabola fit produces a meaningless +-0.5 vector)
    // stay exact (0,0). Pinning flat content is also visually free:
    // there is no detail for the residual to mis-track.
    if (iPick == i00 && imp < pc.d[1]) {
        mvx = 0.0;
        mvy = 0.0;
    }
    // Temporal smoothing: report the EMA of the refined vector (pc.c[0] =
    // D5C_MV_EMA, weight of the new sample; 1.0 = raw). Vectors >= 1 px
    // snap instantly - the +-0.5-clamped sub-pixel refine cannot reach 1
    // px, so the EMA only ever sees the noise-prone sub-pixel range and
    // real integer pans/cuts keep zero lag. A direction reversal
    // (dot(rf, prev) < 0) restarts the filter at the new sample instead
    // of integrating backwards - real drift never reverses in a frame.
    // tid0's program order reads before it writes; no other workgroup
    // touches this element. prevV.w is last frame's motion envelope
    // (env_prev for the MREL release below).
    const vec4 prevV = mvs[bIdx];
    const vec2 prev = prevV.xy;
    const vec2 rf = vec2(mvx, mvy);
    vec2 em;
    if (dot(rf, rf) >= 1.0) em = rf;
    else if (dot(rf, prev) < 0.0) em = rf * pc.c[0];
    else em = prev + (rf - prev) * pc.c[0];
    // Sub-pixel gate: EMA'd vectors shorter than pc.c[3] (D5C_MV_SUBT)
    // collapse to exact (0,0) - residual noise level in the smoothed
    // estimate - and also reset the stored EMA state so a near-threshold
    // block cannot slowly integrate noise across the gate.
    if (dot(em, em) < pc.c[3] * pc.c[3]) em = vec2(0.0, 0.0);
    const float conf = 1.0 - sBest / (s0 + 1e-6);
    // Motion envelope for residual attenuation: instant attack on the
    // reported vector, MREL-decay release (pc.d[2] = D5C_RF_MREL).
    const float env = max(length(em), pc.d[2] * prevV.w);
    mvs[bIdx] = vec4(em.x, em.y, conf, env);
}
