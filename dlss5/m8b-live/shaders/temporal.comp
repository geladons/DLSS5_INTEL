#version 460
// ============================================================================
// M8b temporal pass (2026-09-22) - vendor compose_temporal at token res.
// PORT of work/mlx-dlss/python/mlxdlss/temporal.py compose_temporal (lines
// ~172-190) with identity reprojection (no motion vectors -> sample_history
// at exact texel centres = the pixel itself, so features 7-9 already carry
// the history sample; features.comp wrote them from binding 13 this frame).
//
// Per token (288 = netW*netH):
//   color01   = features[4..6]  * 8 + 0.5   (inverse of scaled_color)
//   hist01    = features[7..9]  * 8 + 0.5   (vendor decode, temporal.py:184)
//   headc     = head[c] - rowDC[c]          (calibrated: the measured head DC
//               (-1.3/-1.3/-0.5, docs/m6b-graph-design.md:391) is an input-
//               distribution bias of the 24x12 token grid; the vendor graph
//               expects near-zero-mean head. Same compensation as headpack.)
//   logit     = half(head[3] - rowDC[3]); alpha = clamp(sigmoid(logit)*half(0.73974609375), 0, 1)
//   predicted = clamp(color01 + half(headc) * 0.25, 0, 1)
//   out       = predicted + alpha * (hist01 - predicted)
//   hist next = scaled_color(out)  -> binding 13 (read by features next frame)
//   residual  = (out - color01) * 4 -> binding 4 (compose applies vendor *0.25)
//
// Three passes (push a.z = mode), extending headpack's lesson to the full
// temporal residual (bug B1 recurrence, 2026-09-22 live A/B: the temporal
// history term re-introduced per-row bias -> colored horizontal lines):
//   mode 0: atomicAdd per-token-ROW sums of the 4 raw head channels -> dc[0..95]
//   mode 1: temporal compose (below), write provisional residual + history,
//           atomicAdd per-row sums of the residual -> dc[96..191]
//   mode 2: residual -= rowMean(residual)  => per-row zero-mean, no row lines.
// Host zeroes dc (1024 B) before mode 0.
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_atomic_float : require
#include "publish.glsl"

// --- local half rounding (hr_*): manual bit manipulation, bit-exact vs numpy
// float16. shaders/publish.glsl's half_round is a NO-OP on this Arc driver
// (packHalf2x16 round-trip gets folded away; see shaders/m8/publish.glsl).
uint hr_bits(uint bx) {
    uint sign = (bx >> 16) & 0x8000u;
    uint mant = bx & 0x7FFFFFu;
    int e = int((bx >> 23) & 0xFFu);
    if (e == 255) {
        if (mant == 0u) return sign | 0x7C00u;
        uint m16 = mant >> 13;
        return sign | 0x7C00u | (m16 != 0u ? m16 : 1u);
    }
    int hexp = e - 112;
    if (hexp >= 31) return sign | 0x7C00u;
    if (hexp <= 0) {
        if (hexp < -10) return sign;
        mant |= 0x800000u;
        int shift = 14 - hexp;
        uint m = mant >> shift;
        uint rem = mant & ((1u << shift) - 1u);
        uint halfway = 1u << (shift - 1);
        if (rem > halfway || (rem == halfway && (m & 1u) != 0u)) {
            m++;
            if (m == 0x400u) return sign | 0x400u;
        }
        return sign | m;
    }
    uint m = mant >> 13;
    uint rem = mant & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (m & 1u) != 0u)) {
        m++;
        if (m == 0x400u) { m = 0u; hexp++; if (hexp >= 31) return sign | 0x7C00u; }
    }
    return sign | (uint(hexp) << 10) | m;
}
float hr_widen(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint e = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    uint b;
    if (e == 0u) {
        if (mant == 0u) b = sign;
        else {
            int exp = -1;
            while ((mant & 0x400u) == 0u) { mant <<= 1; --exp; }
            mant &= 0x3FFu;
            b = sign | (uint(114 + exp) << 23) | (mant << 13);
        }
    } else if (e == 31u) {
        b = sign | 0x7F800000u | (mant << 13);
    } else {
        b = sign | ((e - 15u + 127u) << 23) | (mant << 13);
    }
    return uintBitsToFloat(b);
}
float halfr(float x) { return hr_widen(hr_bits(floatBitsToUint(x))); }

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 3) readonly buffer FeatV { float fv[]; };
layout(std430, set = 0, binding = 4) buffer Resid { float rs[]; };
layout(std430, set = 0, binding = 13) writeonly buffer Hist { float hs[]; };
layout(std430, set = 0, binding = 14) readonly buffer HeadRaw { float hd[]; };
layout(std430, set = 0, binding = 15) buffer HeadDC { float dc[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

void main() {
    uint p = gl_GlobalInvocationID.x;
    if (p >= uint(pc.a.x)) return;
    uint row = p / uint(pc.a.y);   // a.y = cols (12), like headpack
    float inv = 1.0 / float(pc.a.y);
    if (pc.a.z == 0u) {            // mode 0: per-row DC of the raw head -> dc[0..95]
        for (uint c = 0u; c < 4u; ++c)
            atomicAdd(dc[row * 4u + c], hd[p * 16u + c]);
        return;
    }
    if (pc.a.z == 1u) {            // mode 1: temporal compose, provisional residual
        float logit = halfr(hd[p * 16u + 3u] - dc[row * 4u + 3u] * inv);
        float alpha = clamp(1.0 / (1.0 + exp(-logit)) * halfr(0.73974609375), 0.0, 1.0);
        for (uint c = 0u; c < 3u; ++c) {
            float col01 = fv[p * 16u + 4u + c] * 8.0 + 0.5;
            float h01   = fv[p * 16u + 7u + c] * 8.0 + 0.5;
            float hr    = halfr(hd[p * 16u + c] - dc[row * 4u + c] * inv);
            float predicted = clamp(col01 + hr * 0.25, 0.0, 1.0);
            float outp = predicted + alpha * (h01 - predicted);
            float r = (outp - col01) * 4.0;
            rs[p * 4u + c] = r;
            atomicAdd(dc[96u + row * 4u + c], r);   // residual row sums
        }
        rs[p * 4u + 3u] = 0.0;
        return;
    }
    // mode 2: per-row zero-mean residual + history written from the CORRECTED
    // output (history must track what is actually displayed).
    for (uint c = 0u; c < 3u; ++c) {
        float r = rs[p * 4u + c] - dc[96u + row * 4u + c] * inv;
        rs[p * 4u + c] = r;
        float col01 = fv[p * 16u + 4u + c] * 8.0 + 0.5;
        float outp = clamp(col01 + r * 0.25, 0.0, 1.0);
        float s = halfr(outp);              // scaled_color(out): 3 half roundings
        s = halfr(s - 0.5);
        s = halfr(s * 0.125);
        hs[p * 3u + c] = s;
    }
}
