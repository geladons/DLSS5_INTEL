#version 460
// ============================================================================
// M3 decode — B8G8R8A8 storage image -> float RGB in [0,1], packed 3 floats/px.
// PORT of reference nr_decode8(..., bgra=1): src/ref/nr_image.c:36-44.
//   DXGI desktop capture is B8G8R8A8 -> bgra=1: R=src[2], G=src[1], B=src[0].
//
// DRIVER-MEASURED SWIZZLE (2026-09-22, Arc 101.8805, M9b features diff vs the
// torch reference): with layout(rgba8) on a VK_FORMAT_B8G8R8A8_UNORM view this
// driver REVERSES the texel — imageLoad returns .x=R .y=G .z=B .w=A (NOT the
// format-name order .x=B.. the old comment claimed). bufRgb came out BGR and
// the network was fed R/B-swapped colour (live featV ch4 == reference ch6
// EXACTLY, 5000-px probe). encode.comp below relies on the same reversal on
// stores. Read: R=c.x, G=c.y, B=c.z. Output: packed RGB float32 HWC.
// ============================================================================
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba8, set = 0, binding = 0) uniform readonly image2D imgIn;
layout(std430, set = 0, binding = 1) writeonly buffer RgbFull { float v[]; };

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(imgIn);
    if (xy.x >= sz.x || xy.y >= sz.y) return;
    vec4 c = imageLoad(imgIn, xy);          // driver-measured: .x=R .y=G .z=B .w=A
    uint p = uint(xy.y) * uint(sz.x) + uint(xy.x);
    v[p * 3u + 0u] = c.x;                   // R (driver-reversed rgba8 view, see header)
    v[p * 3u + 1u] = c.y;                   // G
    v[p * 3u + 2u] = c.z;                   // B
}
