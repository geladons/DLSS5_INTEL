#version 460
// ============================================================================
// M3 encode — float RGB -> B8G8R8A8 bytes, alpha FORCED opaque (M8B fix).
// PORT of nr_encode8(), src/ref/nr_image.c:46-63 (bgra=1 path):
//   value = value==value ? unit(value) : 0      (NaN -> 0, unit = clamp01)
//   out[p*4 + (2-c)] = (uint8)(value*255 + 0.5) (B first: c=0 R -> byte 2 ...)
//   out[p*4 + 3] = raw alpha
//
// DRIVER-MEASURED SWIZZLE (2026-09-22, Arc 101.8805): layout(rgba8) on a
// VK_FORMAT_B8G8R8A8_UNORM view REVERSES the texel on stores too — value.x
// lands in byte 2, value.z in byte 0 (the old ".x=B" comment assumed the
// format-name order and was wrong; decode.comp has the matching read-side
// note + the features-vs-torch diff that proved it). So an IDENTITY
// vec4(R,G,B,A) store produces the required B,G,R,A byte order here.
//
// Two uses (push b.z): 0 = FULL-frame final image (region pixels from Final,
//   letterbox bars / outside-region from the native decode -> bars untouched,
//   exactly like the reference where every output pass is region-scoped,
//   nr_daemon.py letterbox notes); 1 = region-extent nr_out image (NrOut only).
//
//   b.z = 0: a = (fullW, fullH, regionLeft, regionTop), b = (regionW, regionH, 0, mode)
//   b.z = 1: a unused;                            b = (regionW, regionH, 1, 0)
// M8B (2026-09-20): b.w = 1 = feedback-cancellation ACCUMULATE mode (overlay
// runs only). `fin`/region and `nat`/outside carry SIGNED deltas; the output
// byte is lastPresented(byte) + delta, clamped to [0,255] — i.e. the presented
// frame moves at most +/-maxDelta per channel per processed frame, which is
// what makes the overlay feedback loop bounded. b.w = 0 = legacy direct color.
// ============================================================================
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(rgba8, set = 0, binding = 0) uniform readonly image2D imgIn;   // native (alpha)
layout(std430, set = 0, binding = 1) readonly buffer RgbFull { float nat[]; };
layout(std430, set = 0, binding = 6) readonly buffer Final { float fin[]; };
layout(std430, set = 0, binding = 7) readonly buffer NrOut { float nro[]; };
layout(rgba8, set = 0, binding = 9)  writeonly uniform image2D imgOut; // final or nrout
layout(std430, set = 0, binding = 10) readonly buffer LastP { uint lastp[]; }; // BGRA u32/px
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

float enc(float value) {
    value = (value == value) ? clamp(value, 0.0, 1.0) : 0.0;
    return float(int(value * 255.0 + 0.5)) / 255.0;   // C cast truncates after +0.5
}

void main() {
    ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    ivec2 sz = imageSize(imgOut);
    if (xy.x >= sz.x || xy.y >= sz.y) return;
    uint fullW = uint(pc.a.x);
    int left = pc.a.z, top = pc.a.w;
    float a = 1.0;   // M8B DARKNESS FIX (2026-09-20): the presented overlay is
                     // composited OPAQUE (compositeAlpha=OPAQUE, non-layered
                     // window); never propagate capture alpha into the final
                     // image. (Desktop captures happen to be A=255 anyway.)

    if (pc.b.z == 0 && pc.b.w != 0) {                   // ACCUMULATE (feedback cancellation)
        bool inRegion = xy.x >= left && xy.x < left + pc.b.x &&
                        xy.y >= top  && xy.y < top  + pc.b.y;
        vec3 d;                                          // R,G,B deltas
        if (inRegion) {
            uint rp = uint(xy.y - top) * uint(pc.b.x) + uint(xy.x - left);
            d = vec3(fin[rp * 3u], fin[rp * 3u + 1u], fin[rp * 3u + 2u]);
        } else {
            uint np = uint(xy.y) * fullW + uint(xy.x);
            d = vec3(nat[np * 3u], nat[np * 3u + 1u], nat[np * 3u + 2u]);
        }
        uint np = uint(xy.y) * fullW + uint(xy.x);
        uint lp = lastp[np];
        int r = clamp(int((lp >> 16) & 0xFFu) + int(round(d.x * 255.0)), 0, 255);
        int g = clamp(int((lp >> 8) & 0xFFu)  + int(round(d.y * 255.0)), 0, 255);
        int b = clamp(int(lp & 0xFFu)         + int(round(d.z * 255.0)), 0, 255);
        // driver-reversed store: .x -> byte2 (=R), .z -> byte0 (=B)
        imageStore(imgOut, xy, vec4(float(r) * (1.0 / 255.0), float(g) * (1.0 / 255.0),
                                    float(b) * (1.0 / 255.0), a));
        return;
    }

    vec3 rgb;
    if (pc.b.z == 0) {                                  // full-frame final
        bool inRegion = xy.x >= left && xy.x < left + pc.b.x &&
                        xy.y >= top  && xy.y < top  + pc.b.y;
        if (inRegion) {
            int rx = xy.x - left;
            int ry = xy.y - top;
            int rw = pc.b.x;
            int rh = pc.b.y;
            uint rp = uint(ry) * uint(rw) + uint(rx);
            vec3 c = vec3(fin[rp * 3u], fin[rp * 3u + 1u], fin[rp * 3u + 2u]);
            if (pc.c[0] > 0.0f) {
                // Contrast-Adaptive Sharpening (CAS)
                int up_y = max(ry - 1, 0);
                int dn_y = min(ry + 1, rh - 1);
                int lt_x = max(rx - 1, 0);
                int rt_x = min(rx + 1, rw - 1);
                uint up_idx = (uint(up_y) * uint(rw) + uint(rx)) * 3u;
                uint dn_idx = (uint(dn_y) * uint(rw) + uint(rx)) * 3u;
                uint lt_idx = (uint(ry) * uint(rw) + uint(lt_x)) * 3u;
                uint rt_idx = (uint(ry) * uint(rw) + uint(rt_x)) * 3u;
                vec3 up = vec3(fin[up_idx], fin[up_idx + 1u], fin[up_idx + 2u]);
                vec3 dn = vec3(fin[dn_idx], fin[dn_idx + 1u], fin[dn_idx + 2u]);
                vec3 lt = vec3(fin[lt_idx], fin[lt_idx + 1u], fin[lt_idx + 2u]);
                vec3 rt = vec3(fin[rt_idx], fin[rt_idx + 1u], fin[rt_idx + 2u]);

                vec3 mn = min(min(up, dn), min(lt, rt));
                vec3 mx = max(max(up, dn), max(lt, rt));
                vec3 min_c = min(mn, c);
                vec3 max_c = max(mx, c);
                vec3 amp = clamp(min(min_c, vec3(1.0) - max_c) / max(max_c, vec3(1e-5)), vec3(0.0), vec3(1.0));
                vec3 w = -sqrt(amp) * (pc.c[0] * 0.18);
                rgb = clamp((c + w * (up + dn + lt + rt)) / (vec3(1.0) + 4.0 * w), 0.0, 1.0);
            } else {
                rgb = c;
            }
        } else {
            uint np = uint(xy.y) * fullW + uint(xy.x);
            rgb = vec3(nat[np * 3u], nat[np * 3u + 1u], nat[np * 3u + 2u]);
        }
    } else {                                            // region nr_out
        uint rp = uint(xy.y) * uint(pc.b.x) + uint(xy.x);
        rgb = vec3(nro[rp * 3u], nro[rp * 3u + 1u], nro[rp * 3u + 2u]);
    }
    // driver-reversed store: identity RGBA lands as B,G,R,A bytes (see header)
    imageStore(imgOut, xy, vec4(enc(rgb.r), enc(rgb.g), enc(rgb.b), a));
}
