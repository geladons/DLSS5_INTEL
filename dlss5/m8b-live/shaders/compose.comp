#version 460
// ============================================================================
// M3 compose — the residual composite over the letterbox region.
// PORT of nr_compose(), src/ref/nr_image.c:53-76, at intensity = 1.0 with no
// control mask — i.e. exactly MLX-DLSS compose_head's vendor recipe
// (docs/ARCHITECTURE.md:60-62):
//
//   predicted = unit(source + half(head.rgb) * 0.25)          (nr_image.c:66)
//   output    = unit(source + blend * (predicted - source))   (nr_image.c:67)
//
// which IS the task's "final = native + (nr_out - nr_in)": nr_in = source,
// nr_out = predicted. The C deliberately keeps both the subtract and the add
// even at blend 1 (comment at nr_image.c:58-60: folding them removes an FP32
// rounding and can change encoded pixels) — preserved here.
// `half()` = fp16 rounding -> half_round() (publish.glsl:16, bit-exact vs
// numpy float16). unit() = clamp to [0,1] (nr_image.c:22-28). No NaN guard
// needed: this shader only reads finite floats (encode does the NaN map, as in
// nr_encode8).
//
// Also emits nr_out (= predicted) for the m3_nr_out.bmp artifact.
// The temporal gate (head.a, history_weight) is UNUSED on this still-frame
// path — no history exists for frame 0 (vendor first-frame layout, and
// nr_frame.py compose() takes the same branch).
//
//   push a = (fullStridePx, regionTop, regionLeft, 0);  b = (regionW, regionH, 0, 0)
// M8B (2026-09-20): c = (maxDelta01, accumulateMode, strength, 0). maxDelta01 clamps
// the composite (enhancement) delta to +/-maxDelta/255 so the feedback loop
// through the overlay cannot diverge (0 or >1 = legacy unclamped). In
// accumulate mode (overlay present, c.y > 0.5) `fin` carries the SIGNED
// composite delta (clamped) instead of the full output color — encode adds it
// onto the last presented frame (feedback-cancellation accumulation domain).
// M8B UX (2026-09-20): c.z = strength (0..2, default 1) scales the network
// residual AFTER the hpfilter high-pass (final = native + strength*hp(delta))
// — the residual buffer already had its low-frequency/color component removed
// by shaders/hpfilter.comp (unless --colorpass 1).
// M8B UX-2 (2026-09-21): d.x = residual gate threshold (1/255 units; 0 = off).
// The feedback loop adds the network residual onto the accumulation EVERY
// processed frame, so on a near-static screen (corrected ~ 0 exactly, 8-bit
// echo) a deterministic zero-input residual pattern integrates frame over
// frame — the accumulating BLUE TINT (owner bug #2; cursor activity and the
// --refresh-ms cadence both force processing while the background is static).
// The gate weights the residual by the MAGNITUDE OF THE REAL CHANGE at the
// pixel: w = clamp(max|corrected_rgb|*255 / d.x, 0..1), fin = corrected +
// w*residual. Unchanged pixels (corrected == 0) add exactly nothing -> no
// integration, by construction. Pixels that changed by >= d.x/255 get the
// full residual; a linear ramp between. Enhancement of moving/video content
// is unaffected (corrected is large there); static backgrounds are stable.
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#include "publish.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 1) readonly buffer RgbFull { float nat[]; };
layout(std430, set = 0, binding = 5) readonly buffer HeadUp { float hup[]; };
layout(std430, set = 0, binding = 6) writeonly buffer Final { float fin[]; };
layout(std430, set = 0, binding = 7) writeonly buffer NrOut { float nro[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

void main() {
    uint p = gl_GlobalInvocationID.x;              // index within the region
    uint n = uint(pc.b.x) * uint(pc.b.y);
    if (p >= n) return;
    uint x = p % uint(pc.b.x);
    uint y = p / uint(pc.b.x);

    uint natP = (uint(pc.a.y) + y) * uint(pc.a.x) + (uint(pc.a.z) + x);
    float m = pc.c.x > 0.0 && pc.c.x < 1.0 ? pc.c.x : 1.0;   // composite (net residual) clamp
    float str = pc.c.z > 0.0 ? pc.c.z : 1.0;                 // --strength (default 1)
    // residual gate (accumulate mode only): weight by real per-pixel change
    float w = 1.0;
    if (pc.c.y > 0.5 && pc.d.x > 0.0) {
        float cr = abs(nat[natP * 3u + 0u]);
        float cg = abs(nat[natP * 3u + 1u]);
        float cb = abs(nat[natP * 3u + 2u]);
        float mag = max(max(cr, cg), cb) * 255.0;
        w = clamp(mag / pc.d.x, 0.0, 1.0);
    }
    for (uint c = 0u; c < 3u; ++c) {
        float source = nat[natP * 3u + c];
        float halfv = half_round(hup[p * 4u + c]) * 0.25 * str;
        if (pc.c.y > 0.5) {
            // Accumulate mode (feedback cancellation): fin = corrected(source)
            // + the network's composite residual, where ONLY the residual is
            // clamped to +/-maxDelta/255 — the tight divergence bound lives on
            // what the net ADDS, never on real content (else the screen could
            // never appear from black). encode adds fin onto lastPresented:
            //   presented(n) = capture(n) + deltaNet(n)   [echo cancels exactly]
            // The gate w suppresses the residual wherever the pixel did not
            // change (static background) so the residual cannot integrate.
            float delta = clamp(halfv, -m, m);
            fin[p * 3u + c] = source + w * delta;
            nro[p * 3u + c] = clamp(source + w * delta, 0.0, 1.0);
        } else {
            float predicted = clamp(source + halfv, 0.0, 1.0);
            float finalv = clamp(source + 1.0 * (predicted - source), 0.0, 1.0);
            fin[p * 3u + c] = finalv;
            nro[p * 3u + c] = predicted;
        }
    }
}
