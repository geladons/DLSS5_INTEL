#version 460
// ============================================================================
// M9B compose — the vendor compose_head recipe (composition.py:11-32) on the
// RAW network head at FULL network extent:
//   residual  = half(head[..., :3]) * 0.25 * gain
//   predicted = clamp(source + residual, 0, 1)
//   output    = clamp(source + blend * (predicted - source), 0, 1)  (blend = 1)
//
// The head comes straight from the 71-block U-Net (binding 5 = the oHEAD range
// of the chain device buffer, [TOK0,16] fp32, token == network pixel, region
// origin == network origin). The old pipeline (288-token miniature + rescale
// pair + per-row DC removal + hpfilter + residual gate) is GONE — the model
// runs at vendor fidelity, so the residual is the real neural detail and
// --gain defaults to 1.0 (vendor scale).
//
// Accumulate mode (c.y > 0.5) survives only for the legacy feedback path when
// the overlay cannot be excluded from capture: fin = corrected(source) +
// clamp(residual, +/-maxDelta/255); encode adds fin onto lastPresented.
//
//   push a = (fullStridePx, regionTop, regionLeft, netW)
//        b = (regionW, regionH, 0, 0)
//        c = (maxDelta01, accumulateMode, gain, 0)
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#include "publish.glsl"

// --- local half rounding (hr_*): manual bit manipulation. publish.glsl's
// half_round (packHalf2x16 round-trip) is folded to a NO-OP by this Arc
// driver (see shaders/m8/publish.glsl header) — the vendor half() rounding of
// the head residual would silently vanish. Bit-exact vs numpy float16.
uint hr_bits(uint bx) {
    uint sign = (bx >> 16) & 0x8000u;
    uint mant = bx & 0x7FFFFFu;
    int e = int((bx >> 23) & 0xFFu);
    if (e == 255) {
        if (mant == 0u) return sign | 0x7C00u;
        uint m16 = mant >> 13;
        return sign | 0x7C00u | (m16 != 0u ? m16 : 1u);
    }
    int hexp = e - 112;
    if (hexp >= 31) return sign | 0x7C00u;
    if (hexp <= 0) {
        if (hexp < -10) return sign;
        mant |= 0x800000u;
        int shift = 14 - hexp;
        uint m = mant >> shift;
        uint rem = mant & ((1u << shift) - 1u);
        uint halfway = 1u << (shift - 1);
        if (rem > halfway || (rem == halfway && (m & 1u) != 0u)) {
            m++;
            if (m == 0x400u) return sign | 0x400u;
        }
        return sign | m;
    }
    uint m = mant >> 13;
    uint rem = mant & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (m & 1u) != 0u)) {
        m++;
        if (m == 0x400u) { m = 0u; hexp++; if (hexp >= 31) return sign | 0x7C00u; }
    }
    return sign | (uint(hexp) << 10) | m;
}
float hr_widen(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint e = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    uint b;
    if (e == 0u) {
        if (mant == 0u) b = sign;
        else {
            int exp = -1;
            while ((mant & 0x400u) == 0u) { mant <<= 1; --exp; }
            mant &= 0x3FFu;
            b = sign | (uint(114 + exp) << 23) | (mant << 13);
        }
    } else if (e == 31u) {
        b = sign | 0x7F800000u | (mant << 13);
    } else {
        b = sign | ((e - 15u + 127u) << 23) | (mant << 13);
    }
    return uintBitsToFloat(b);
}
float halfr(float x) { return hr_widen(hr_bits(floatBitsToUint(x))); }

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 1) readonly buffer RgbFull { float nat[]; };
layout(std430, set = 0, binding = 5) readonly buffer HeadRaw { float head[]; };
layout(std430, set = 0, binding = 6) writeonly buffer Final { float fin[]; };
layout(std430, set = 0, binding = 7) writeonly buffer NrOut { float nro[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

void main() {
    uint p = gl_GlobalInvocationID.x;              // index within the region
    uint n = uint(pc.b.x) * uint(pc.b.y);
    if (p >= n) return;
    uint x = p % uint(pc.b.x);
    uint y = p / uint(pc.b.x);

    uint natP = (uint(pc.a.y) + y) * uint(pc.a.x) + (uint(pc.a.z) + x);
    uint hP = (y * uint(pc.a.w) + x) * 16u;        // head token (region origin == net origin)
    float m = pc.c.x > 0.0 && pc.c.x < 1.0 ? pc.c.x : 1.0;   // accumulate clamp
    float gain = pc.c.z;
    for (uint c = 0u; c < 3u; ++c) {
        float source = nat[natP * 3u + c];
        float halfv = halfr(head[hP + c]) * 0.25 * gain;
        if (pc.c.y > 0.5) {
            // Legacy accumulate mode (feedback cancellation).
            float delta = clamp(halfv, -m, m);
            fin[p * 3u + c] = source + delta;
            nro[p * 3u + c] = clamp(source + delta, 0.0, 1.0);
        } else {
            // Vendor compose_head at intensity 1 (composition.py:23-32).
            float predicted = clamp(source + halfv, 0.0, 1.0);
            float finalv = clamp(source + 1.0 * (predicted - source), 0.0, 1.0);
            fin[p * 3u + c] = finalv;
            nro[p * 3u + c] = predicted;
        }
    }
}
