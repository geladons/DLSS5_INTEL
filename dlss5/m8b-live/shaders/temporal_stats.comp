#version 460
// SPDX-License-Identifier: Apache-2.0
// ============================================================================
// Gain-anchor statistics pass (chain only). Runs AFTER the 71-block chain,
// BEFORE temporal_nr rewrites the head. Two jobs:
//
//   1. Accumulate this frame's PRE-SCALE output luma (the network's
//      reconstruction blended toward history by learned alpha - exactly
//      what temporal_nr emits before the gain-anchor multiply) into
//      stats[1] -
//      fixed-point Q8 per pixel, one shared-memory partial per workgroup.
//      stats[0] was already accumulated by features.comp on the input.
//   2. Rotate last frame's next-slots into the prev slots:
//      stats[2]=stats[4] (prev input sum), stats[3]=stats[5] (prev achieved
//      output sum), stats[6]=stats[7] (gain EMA produced by temporal_nr).
//      The rotation lives HERE, not in temporal_nr, so no invocation can
//      observe torn prev sums mid-dispatch, and temporal_nr's read of the
//      EMA never races its own write (it writes the spare slot [7]).
//
// temporal_nr then forces the frame's global gain to an EMA of gNet
// (pc.c.x = smoothing alpha there), so network exposure "breathing" and
// jitter are low-passed while real lighting changes still track.
//
// stats layout (u32, Q8 luma sums):
//   [0] cur input luma sum      (features.comp, zeroed each frame)
//   [1] cur predicted luma sum  (here, zeroed each frame)
//   [2] prev input luma sum     (rotated from [4]; diagnostic)
//   [3] prev achieved out sum   (rotated from [5]; diagnostic)
//   [4] next input sum          (temporal_nr, single-invocation store)
//   [5] next achieved out sum   (temporal_nr, single-invocation store)
//   [6] gain EMA, Q16           (temporal_nr reads; rotated here from [7])
//   [7] next gain EMA, Q16      (temporal_nr writes; survives across frames)
// ============================================================================
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 3) readonly buffer FeatV { float fv[]; };
// Previous-frame temporal state (host copies bufHist -> bufHistPrev
// before this dispatch): all prior-state reads (E/P/A/R, incl. the
// motion-warped taps) come from here - never the live binding-13 store
// temporal_nr is about to rewrite.
layout(std430, set = 0, binding = 17) readonly buffer HistPrev { float hsP[]; };
// Per-8x8-block motion vectors (motion_est.comp), same warp source as
// temporal_nr.comp.
layout(std430, set = 0, binding = 18) readonly buffer Mvs { vec4 mvs[]; };
layout(std430, set = 0, binding = 14) readonly buffer HeadRaw { float head[]; };
layout(std430, set = 0, binding = 16) buffer Stats { uint stats[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

// Same blockMv as temporal_nr.comp - pc.c[2]==0 nearest block, !=0
// bilinear between the four nearest block centres (8i+3.5), constant
// extrapolation outside the centre hull.
vec2 blockMv(int px, int py, int netW, int netH) {
    const int BW = (netW + 7) / 8, BH = (netH + 7) / 8;
    if (pc.c[2] == 0.0)
        return mvs[uint(py / 8) * uint(BW) + uint(px / 8)].xy;
    const float ux = (float(px) - 3.5f) * 0.125f;
    const float uy = (float(py) - 3.5f) * 0.125f;
    int i0 = clamp(int(floor(ux)), 0, BW - 1);
    int j0 = clamp(int(floor(uy)), 0, BH - 1);
    const int i1 = min(i0 + 1, BW - 1), j1 = min(j0 + 1, BH - 1);
    const float fx = (i1 == i0) ? 0.0f : clamp(ux - float(i0), 0.0f, 1.0f);
    const float fy = (j1 == j0) ? 0.0f : clamp(uy - float(j0), 0.0f, 1.0f);
    const vec2 m00 = mvs[uint(j0) * uint(BW) + uint(i0)].xy;
    const vec2 m10 = mvs[uint(j0) * uint(BW) + uint(i1)].xy;
    const vec2 m01 = mvs[uint(j1) * uint(BW) + uint(i0)].xy;
    const vec2 m11 = mvs[uint(j1) * uint(BW) + uint(i1)].xy;
    return mix(mix(m00, m10, fx), mix(m01, m11, fx), fy);
}

// Same residual-domain hold as temporal_nr.comp (0..1 domain; see that
// file for the full rationale + bufHist layout: [0,3N) emit history E,
// [3N,6N) previous-frame input P, [6N,9N) drift anchor A, [9N,10N)
// refresh budget R). stats[1] must mirror the value temporal_nr
// actually emits pre-anchor: emit = col01 + rh (the held residual
// Eb - P) plus a proportional step toward the fresh residual
// rc = cand - col01 while a refresh burst is armed (|col01 - A| > D_REF
// re-anchors, R_FRAMES budget; per-channel step max(R_STEP_MIN,
// R_FRAC*|rc - rh|) = exponential convergence); fresh uncapped on
// !valid / dF > IN_CUT / dr >= DB_CUT. Read-only view of hs - this
// pass runs before temporal_nr's write. Constants MUST stay identical
// to temporal_nr.comp.
const float DB_CUT    = 128.0 / 255.0;
const float IN_CUT    =  24.0 / 255.0;
const float D_REF     =  12.0 / 255.0;
const float R_DONE    =   6.0 / 255.0;
const float R_STEP_MIN=   1.0 / 255.0;
const float R_FRAC    =   0.25;
const float R_FRAMES  =  16.0;
// (moving-pixel fraction is pc.c[1] = D5C_MV_BETA; pc.c[2] = D5C_MV_INTERP)

shared uint sLum;
void main() {
    uint p = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationIndex == 0u) sLum = 0u;
    barrier();
    // rotate next -> prev BEFORE this frame's temporal_nr reads/writes
    if (p == 0u) {
        stats[2] = stats[4];
        stats[3] = stats[5];
        stats[6] = stats[7];
    }
    if (p < uint(pc.a.x)) {
        // accumulate the PRE-SCALE output luma: what temporal_nr will emit
        // before the gain-anchor multiply - i.e. pred blended toward the
        // (already AABB-clamped) history by learned alpha.
        float logit = head[p * 4u + 3u];
        float alpha = clamp(1.0 / (1.0 + exp(-logit)) * 0.73974609375, 0.0, 1.0);
        float luma = 0.0;
        const vec3 W = vec3(0.299, 0.587, 0.114);
        float col01[3], h01[3];
        for (uint c = 0u; c < 3u; ++c) {
            col01[c] = fv[p * 16u + 4u + c] * 8.0 + 0.5;
            h01[c]   = fv[p * 16u + 7u + c] * 8.0 + 0.5;
        }
        // Same per-pixel blend gate as temporal_nr: fv[15] carries the
        // factor features.comp measured on the UNCLAMPED history (luma +
        // max-channel distance, soft smoothstep band). stats[1] must
        // equal what temporal_nr actually emits pre-anchor, else the
        // anchor would chase a history pull that was never applied.
        // NOTE: temporal_nr's residual hold sits BELOW the gain anchor
        // on the pre-anchor blend - the value this pass must mirror - so
        // the same residual comparison runs here (same metric, same
        // constants, same P/A/R validity + pc.d.x==0 reset bypass; the
        // only difference is nr emits the gain-anchored residual while
        // this pass uses the pre-anchor rc). Keeping stats[1] honest is
        // what lets the anchor's deadzone latch k=1 once the image pins.
        float gate = fv[p * 16u + 15u];
        alpha *= gate;
        // fv[15] is already 0 on a history-reset frame (features' own
        // histValid path) AND pc.d.x is pushed 0 on the same frames -
        // stats[1] then accumulates the unblended prediction, matching
        // what temporal_nr emits (pc.d.x==0 forces !valid -> fresh emit,
        // see below).
        float cand[3];
        for (uint c = 0u; c < 3u; ++c) {
            float pred = clamp(col01[c] + head[p * 4u + c] * 0.25, 0.0, 1.0);
            cand[c] = pred + alpha * (h01[c] - pred);
        }
        // Same motion-compensated residual hold as temporal_nr on the
        // same stored values (read-only here; E/P/A/R come from the
        // hsPrev snapshot at q = p - mv, integer warp verbatim /
        // fractional bilinear on P, A and the decoded emit + nearest R).
        // Held residual rh = Ew - P needs no gate special-casing:
        // fv[15]==0 pixels re-emit their held residual tracked onto the
        // current input like any other.
        const uint N = uint(pc.a.x);
        const int netW = pc.a.y, netH = pc.a.z;
        const int px = int(p % uint(netW)), py = int(p / uint(netW));
        vec2 mv = blockMv(px, py, netW, netH);
        // Same D5C_MV_PIXSTATIC (pc.c[3], LSB) per-pixel override as
        // temporal_nr: unwarped input delta within the threshold forces
        // mv=(0,0) -> the v9 static path.
        if (pc.c[3] > 0.0) {
            const float dF0 = max(abs(col01[0] - hsP[3u * N + p * 3u + 0u]),
                                  max(abs(col01[1] - hsP[3u * N + p * 3u + 1u]),
                                      abs(col01[2] - hsP[3u * N + p * 3u + 2u])));
            if (dF0 <= pc.c[3] * (1.0 / 255.0)) mv = vec2(0.0);
        }
        const float qx = float(px) - mv.x;
        const float qy = float(py) - mv.y;
        bool stValid = (qx >= 0.0 && qx <= float(netW - 1)
                        && qy >= 0.0 && qy <= float(netH - 1));
        float aP[3], aA[3], Ew[3];
        float Rw = 0.0;
        if (stValid) {
            if (mv.x == floor(mv.x) && mv.y == floor(mv.y)) {
                const uint sp = uint(int(qy)) * uint(netW) + uint(int(qx));
                for (uint c = 0u; c < 3u; ++c) {
                    float v = hsP[3u * N + sp * 3u + c];
                    if (!(v >= -0.01 && v <= 1.01)) stValid = false;
                    aP[c] = v;
                    float w = hsP[6u * N + sp * 3u + c];
                    if (!(w >= -0.01 && w <= 1.01)) stValid = false;
                    aA[c] = w;
                    float sraw = hsP[sp * 3u + c];
                    if (!(sraw > -1e9 && sraw < 1e9)) sraw = 0.0;
                    Ew[c] = floor(clamp(sraw * 8.0 + 0.5, 0.0, 1.0) * 255.0 + 0.5)
                            * (1.0 / 255.0);
                }
                Rw = hsP[9u * N + sp];
                if (!(Rw >= 0.0 && Rw <= R_FRAMES)) stValid = false;
            } else {
                const int x0 = int(floor(qx)), y0 = int(floor(qy));
                const float fx = qx - float(x0), fy = qy - float(y0);
                for (uint c = 0u; c < 3u; ++c) { aP[c] = 0.0; aA[c] = 0.0; Ew[c] = 0.0; }
                for (int ty = 0; ty < 2; ++ty) {
                    for (int tx = 0; tx < 2; ++tx) {
                        const int sx = clamp(x0 + tx, 0, netW - 1);
                        const int sy = clamp(y0 + ty, 0, netH - 1);
                        const uint sp = uint(sy) * uint(netW) + uint(sx);
                        const float wgt = (tx == 0 ? 1.0 - fx : fx)
                                        * (ty == 0 ? 1.0 - fy : fy);
                        for (uint c = 0u; c < 3u; ++c) {
                            float v = hsP[3u * N + sp * 3u + c];
                            if (!(v >= -0.01 && v <= 1.01)) stValid = false;
                            aP[c] += wgt * v;
                            float w = hsP[6u * N + sp * 3u + c];
                            if (!(w >= -0.01 && w <= 1.01)) stValid = false;
                            aA[c] += wgt * w;
                            float sraw = hsP[sp * 3u + c];
                            if (!(sraw > -1e9 && sraw < 1e9)) sraw = 0.0;
                            Ew[c] += wgt * floor(clamp(sraw * 8.0 + 0.5, 0.0, 1.0)
                                                 * 255.0 + 0.5) * (1.0 / 255.0);
                        }
                    }
                }
                const int nx = clamp(int(floor(qx + 0.5)), 0, netW - 1);
                const int ny = clamp(int(floor(qy + 0.5)), 0, netH - 1);
                Rw = hsP[9u * N + uint(ny) * uint(netW) + uint(nx)];
                if (!(Rw >= 0.0 && Rw <= R_FRAMES)) stValid = false;
            }
        }
        bool valid = stValid && (pc.d.x != 0.0);
        float rh[3], rc[3];
        for (uint c = 0u; c < 3u; ++c) {
            rh[c] = Ew[c] - aP[c];
            rc[c] = cand[c] - col01[c];
        }
        float dF = max(abs(col01[0] - aP[0]),
                       max(abs(col01[1] - aP[1]),
                           abs(col01[2] - aP[2])));
        float dA = max(abs(col01[0] - aA[0]),
                       max(abs(col01[1] - aA[1]),
                           abs(col01[2] - aA[2])));
        float drl = abs(0.299 * (rc[0] - rh[0])
                      + 0.587 * (rc[1] - rh[1])
                      + 0.114 * (rc[2] - rh[2]));
        float drc = max(abs(rc[0] - rh[0]),
                        max(abs(rc[1] - rh[1]),
                            abs(rc[2] - rh[2])));
        float dr = max(drl, 2.5 * drc);
        float emitT[3];
        if (!valid || dF > IN_CUT || dr >= DB_CUT) {
            for (uint c = 0u; c < 3u; ++c) emitT[c] = cand[c];
        } else {
            // Same moving/anchor/budget decision as temporal_nr (Rn is
            // only bookkeeping there; what matters here is whether the
            // refresh step applies): warped pixels refresh every frame
            // at pc.c[1] * min(|mv|, 1) with no budget, still pixels
            // keep the v9 path.
            const float mvl = length(mv);
            const bool moving = (mvl > 0.01);
            float Rn = Rw;
            bool refresh = moving;
            if (!moving) {
                if (dA > D_REF) Rn = R_FRAMES;
                if (Rn > 0.0) {
                    if (dr < R_DONE) {
                        Rn = 0.0;
                    } else {
                        refresh = true;
                        Rn = Rn - 1.0;
                    }
                }
            }
            for (uint c = 0u; c < 3u; ++c) {
                float e = rc[c] - rh[c];
                float capc = refresh ? (moving ? min(mvl, 1.0) * max(R_STEP_MIN,
                                                                    pc.c[1] * abs(e))
                                               : max(R_STEP_MIN, R_FRAC * abs(e)))
                                     : 0.0;
                emitT[c] = col01[c] + rh[c] + clamp(e, -capc, capc);
            }
        }
        // Same emit as temporal_nr (pre-anchor candidate cand), snapped
        // to the byte grid exactly like the store there.
        for (uint c = 0u; c < 3u; ++c) {
            float b = floor(clamp(emitT[c], 0.0, 1.0) * 255.0 + 0.5);
            luma += W[c] * (b * (1.0 / 255.0));
        }
        atomicAdd(sLum, uint(luma * 256.0 + 0.5));
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && sLum != 0u) atomicAdd(stats[1], sLum);
}
