#version 460
// ============================================================================
// SPDX-License-Identifier: Apache-2.0
// Derived from dlss-nr-on-intel (Apache-2.0); upstream notice retained.
// M3 feature assembly — the 16-channel network input volume, one pixel/thread.
// PORT of nr_features(), src/ref/nr_image.c:84-112 (the C transcription of
// MLX-DLSS make_features + apply_history; the NumPy original is the vendored
// work/mlx-dlss features.py, ABSENT from this clone — the C is the ground
// truth available in-tree).
//
// Per pixel, channels (nr_image.c:96-110):
//   0..2  deterministic noise (3 ch)   -- REAL PORT (2026-09-22), see below
//   3     1.0                          (const)
//   4..6  scaled colour: half(half(half(rgb)-0.5)*0.125)   (nr_image.c:96)
//   7..9  history: temporal mode = scaled previous composed output (binding 13,
//         written by temporal.comp last frame); first frame / reseed / temporal
//         off = scaled colour (first-frame layout, nr_image.c:98-101)
//   10..14 controls = (half(style), half(tone), half(structure), -1, -1)
//   15    0.0 on x16 (vendor contract); the fp32 fv[15] instead carries the
//         temporal blend gate for temporal_nr/temporal_stats (computed on
//         the unclamped history - see below).
//
// NOISE PORT: the vendor deterministic_noise() (work/mlx-dlss/python/mlxdlss/
// features.py:87) IS portable, the old "cannot be ported" comment was wrong.
// All integer steps are uint32-exact (identical wraparound in GLSL); the only
// approximate ops are the four transcendentals (log/cos/sin in fp32), whose
// ulp-level differences are absorbed by the final half() rounding. Keyed by
// (y, x, frame_index) exactly like the vendor; Box-Muller Gaussian, near
// zero-mean. The old integer-hash stand-in fed the graph a wrong conditioning
// signal every frame (owner: "digital garbage on dynamic content").
//
//   push a = (netW, netH, regionW, regionH);  b = (frameIndex, regionLeft, regionTop, fullW)
//        c = (style, tone, structure, 0)   (style/tone/structure host-half-rounded)
//        d = (histValid, 0, 0, 0)          (1 = channels 7-9 from binding 13)
//
// M9B (2026-09-22): the network extent is now the VENDOR-ALIGNED full
// resolution of the region (multiple of 64, >= 320), not the old 12x24
// miniature. Colour is read straight from the full-res decoded desktop
// (binding 1, bufRgb) at the region offset; network pixels outside the region
// use the vendor mirror extension (index 2*extent-2-x, clamped at 0 —
// features.py extended_indices). Noise stays keyed by NETWORK coordinates
// (x, y), exactly like the vendor (regenerated in the extension).
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require
#include "publish.glsl"

// --- local half rounding (hr_*): the m8 manual bit-manipulation version. ---
// shaders/publish.glsl's half_round (packHalf2x16 round-trip) is folded to a
// NO-OP by this Arc driver (see shaders/m8/publish.glsl header) - the vendor
// rounding points in this shader would silently vanish. Bit-exact vs numpy
// float16 over ordinary values, subnormals and overflow.
uint hr_bits(uint bx) {
    uint sign = (bx >> 16) & 0x8000u;
    uint mant = bx & 0x7FFFFFu;
    int e = int((bx >> 23) & 0xFFu);
    if (e == 255) {
        if (mant == 0u) return sign | 0x7C00u;
        uint m16 = mant >> 13;
        return sign | 0x7C00u | (m16 != 0u ? m16 : 1u);
    }
    int hexp = e - 112;
    if (hexp >= 31) return sign | 0x7C00u;
    if (hexp <= 0) {
        if (hexp < -10) return sign;
        mant |= 0x800000u;
        int shift = 14 - hexp;
        uint m = mant >> shift;
        uint rem = mant & ((1u << shift) - 1u);
        uint halfway = 1u << (shift - 1);
        if (rem > halfway || (rem == halfway && (m & 1u) != 0u)) {
            m++;
            if (m == 0x400u) return sign | 0x400u;
        }
        return sign | m;
    }
    uint m = mant >> 13;
    uint rem = mant & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (m & 1u) != 0u)) {
        m++;
        if (m == 0x400u) { m = 0u; hexp++; if (hexp >= 31) return sign | 0x7C00u; }
    }
    return sign | (uint(hexp) << 10) | m;
}
float hr_widen(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint e = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    uint b;
    if (e == 0u) {
        if (mant == 0u) b = sign;
        else {
            int exp = -1;
            while ((mant & 0x400u) == 0u) { mant <<= 1; --exp; }
            mant &= 0x3FFu;
            b = sign | (uint(114 + exp) << 23) | (mant << 13);
        }
    } else if (e == 31u) {
        b = sign | 0x7F800000u | (mant << 13);
    } else {
        b = sign | ((e - 15u + 127u) << 23) | (mant << 13);
    }
    return uintBitsToFloat(b);
}
float halfr(float x) { return hr_widen(hr_bits(floatBitsToUint(x))); }

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 1) readonly buffer RgbFull { float nat[]; };
layout(std430, set = 0, binding = 3) writeonly buffer Features { float f[]; };
// binding 4 = the chain input oX16 (f16 [TOK,16]): features now emits the
// packed half volume itself with float16_t() - the exact RNE conversion
// featpack.comp applied - so the standalone featpack dispatch is gone.
layout(std430, set = 0, binding = 4) writeonly buffer FeatX16 { float16_t x16[]; };
layout(std430, set = 0, binding = 13) readonly buffer Hist { float hist[]; };
// Gain-anchor luma statistics (chain-side temporal_nr only): stats[0]
// accumulates the CURRENT input luma sum for this frame; the engine
// zeroes it before this dispatch. One shared-memory partial per workgroup
// keeps this to a handful of global atomics. m8b-live binds the buffer
// and never reads it.
layout(std430, set = 0, binding = 16) buffer Stats { uint stats[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

// --- vendor deterministic_noise, features.py:60-109 (uint32-exact) ---
uint dynamic_shift_mix(uint v) {
    uint shift = (v >> 28u) + 4u;
    uint mixed = v ^ (v >> shift);
    return mixed * 0x108EF2D9u;
}
float uniform24(uint v) {
    uint m = dynamic_shift_mix(v);
    uint bits = (m >> 30u) ^ (m >> 8u);
    return float(bits + 1u) * 5.960464477539063e-8;   // 2^-24
}
vec3 deterministicNoise(uint x, uint y, uint frame) {
    uint seed = y * 0xD8163841u;
    seed ^= x * 0x8DA6B343u;
    seed ^= frame * 0x9E3779B9u;   // (frame_index * k) & 0xFFFFFFFF == uint wrap
    seed ^= 0x243F6A88u;
    uint multiplied = dynamic_shift_mix(seed);
    uint mixed = multiplied ^ (multiplied >> 22u);
    float raU = uniform24(mixed * 0xCAA5B80Du + 0x21DD796Bu);
    float abU = uniform24(mixed * 0x83232C31u + 0x3463E0ACu);
    float rbU = uniform24(mixed * 0x2C9277B5u + 0xAC564B05u);
    float aaU = uniform24(mixed * 0xFA6DC5F9u + 0x4712A88Eu);
    float ra = sqrt(-2.0 * log(raU));
    float rb = sqrt(-2.0 * log(rbU));
    const float tau = 6.2831854820251465;
    float aa = tau * aaU;
    float ab = tau * abU;
    return vec3(halfr(rb * cos(aa)),
                halfr(rb * sin(aa)),
                halfr(ra * cos(ab)));
}

shared uint sLum;
void main() {
    uint p = gl_GlobalInvocationID.x;
    if (gl_LocalInvocationIndex == 0u) sLum = 0u;
    barrier();
    uint netW = uint(pc.a.x), netH = uint(pc.a.y);
    uint n = netW * netH;
    if (p < n) {
    uint x = p % netW;
    uint y = p / netW;

    // vendor mirror extension (features.py:60-68): network pixels past the
    // region read the mirrored source pixel, index 2*extent-2-i clamped at 0.
    uint regW = uint(pc.a.z), regH = uint(pc.a.w);
    uint sx = x < regW ? x : uint(max(0, 2 * int(regW) - 2 - int(x)));
    uint sy = y < regH ? y : uint(max(0, 2 * int(regH) - 2 - int(y)));
    uint fullW = uint(pc.b.w);
    uint srcP = (uint(pc.b.z) + sy) * fullW + (uint(pc.b.y) + sx);

    float scaled[3];
    vec3 raw;
    for (uint c = 0u; c < 3u; ++c) {
        raw[c] = nat[srcP * 3u + c];
        float v = raw[c];
        // scaled_color, nr_image.c:96 — three FP16 roundings (ARCHITECTURE.md:49)
        v = halfr(v);
        v = halfr(v - 0.5);
        v = halfr(v * 0.125);
        scaled[c] = v;
    }
    // input luma for the gain anchor (0..1 domain, Q8 fixed point per pixel)
    float lumIn = dot(raw, vec3(0.299, 0.587, 0.114));
    atomicAdd(sLum, uint(lumIn * 256.0 + 0.5));

    float ctrl0 = halfr(pc.c.x);
    float ctrl1 = halfr(pc.c.y);
    float ctrl2 = halfr(pc.c.z);
    float ctrl3 = -1.0;
    float ctrl4 = -1.0;
    if (pc.d.z > 0.5) {
        ctrl3 = pc.c.w < 0.0 ? -1.0 : halfr(pc.c.w);
        ctrl4 = pc.d.y < 0.0 ? -1.0 : halfr(pc.d.y);
    }
    vec3 n3 = deterministicNoise(x, y, uint(pc.b.x));

    float o[16];
    float histC[3];
    // fv[15] side channel: the per-pixel temporal blend gate (0 = history
    // rejected). x16 ch15 keeps the vendor zero contract - the gate only
    // exists in the fp32 volume temporal_nr/temporal_stats read.
    float hGate = 0.0;
    o[0]  = n3.x;
    o[1]  = n3.y;
    o[2]  = n3.z;
    o[3]  = 1.0;
    o[4]  = scaled[0];
    o[5]  = scaled[1];
    o[6]  = scaled[2];
    if (pc.d.x != 0) {   // temporal: reprojected (identity-UV) display history
        // AABB colour clamp (TAA): the previous OUTPUT may only reach
        // colours actually present in the 3x3 CURRENT-source neighbourhood.
        // A stale bright spot on a now-dark region (moved cursor, panned
        // clothing, FG interval gap) is pulled inside the local range
        // instead of being dragged by the alpha blend - kills ghost trails,
        // the sustained overbright patch the field showed (partial-blend
        // equilibrium), and the periodic bright snaps at the threshold.
        float lo[3] = { 1e9, 1e9, 1e9 };
        float hi[3] = { -1e9, -1e9, -1e9 };
        for (int dy = -1; dy <= 1; ++dy) {
            for (int dx = -1; dx <= 1; ++dx) {
                uint nx = uint(clamp(int(sx) + dx, 0, int(regW) - 1));
                uint ny = uint(clamp(int(sy) + dy, 0, int(regH) - 1));
                uint np = (uint(pc.b.z) + ny) * fullW + (uint(pc.b.y) + nx);
                for (uint c = 0u; c < 3u; ++c) {
                    float v = nat[np * 3u + c];
                    v = halfr(v); v = halfr(v - 0.5); v = halfr(v * 0.125);
                    lo[c] = min(lo[c], v);
                    hi[c] = max(hi[c], v);
                }
            }
        }
        const float M = 0.004;   // ~8/255 slack in scaled space (grain wiggle)
        histC[0] = clamp(hist[p * 3u + 0u], lo[0] - M, hi[0] + M);
        histC[1] = clamp(hist[p * 3u + 1u], lo[1] - M, hi[1] + M);
        histC[2] = clamp(hist[p * 3u + 2u], lo[2] - M, hi[2] + M);
        // Blend gate measured on the UNCLAMPED history (raw bufHist vs the
        // current colour). The clamped value stays the blend target, but a
        // distance taken on it under-fires exactly where needed: the clamp
        // pins a stale history to the 3x3 box edge, deflating the metric.
        // Luma alone is also chroma-blind - an isoluminant white->blue
        // drift passes untouched - so dm takes the max of the BT.601 luma
        // distance and the max per-channel distance at 2.5x weight: a
        // ~10/255 single-channel excursion fully releases the pull inside
        // the same 0.02..0.10 soft smoothstep band (a hard gate oscillates).
        float hu[3] = { hist[p * 3u + 0u] * 8.0 + 0.5,
                        hist[p * 3u + 1u] * 8.0 + 0.5,
                        hist[p * 3u + 2u] * 8.0 + 0.5 };
        float dm = max(abs(0.299 * (hu[0] - raw[0])
                         + 0.587 * (hu[1] - raw[1])
                         + 0.114 * (hu[2] - raw[2])),
                       2.5 * max(abs(hu[0] - raw[0]),
                                 max(abs(hu[1] - raw[1]),
                                     abs(hu[2] - raw[2]))));
        float hg = smoothstep(0.02, 0.10, dm);   // 1 = moved: reject history
        hGate = 1.0 - hg;
        // Motion-gated history for the NETWORK input (x16 only): the AABB
        // clamp keeps the blend-side copy bounded, but at a just-vacated
        // edge the 3x3 neighbourhood still spans both sides, the clamp
        // stays loose, and the net reads a stale history it enhances as if
        // the moved object were still here - a residual lift the
        // temporal_nr blend gate cannot remove because it lives inside
        // pred (measured: vac_edge +12.5 LSB). Where the unclamped dm says
        // this pixel's reprojection is not honest, the net gets a mix
        // toward the first-frame layout (hist==col01, its own "no history"
        // state) - a benign mis-fire on strongly enhanced still pixels:
        // the fallback is in-distribution and the blend-side history still
        // anchors the output.
        o[7] = mix(histC[0], scaled[0], hg);
        o[8] = mix(histC[1], scaled[1], hg);
        o[9] = mix(histC[2], scaled[2], hg);
    } else {
        o[7]  = scaled[0];   // first-frame history layout (nr_image.c:99-101)
        o[8]  = scaled[1];
        o[9]  = scaled[2];
    }
    o[10] = ctrl0;
    o[11] = ctrl1;
    o[12] = ctrl2;
    o[13] = ctrl3;       // Phase 30 skin structure
    o[14] = ctrl4;       // Phase 30 auto-mask structure
    o[15] = 0.0;
    for (uint c = 0u; c < 16u; ++c) {
        // fv[7..9] keep the AABB-clamped history for the BLEND side
        // (temporal_nr/temporal_stats read fv; the net reads x16's gated
        // copy - the two volumes intentionally differ only there).
        f[p * 16u + c] = (c >= 7u && c <= 9u && pc.d.x != 0) ? histC[c - 7u]
                       : (c == 15u) ? hGate : o[c];
        x16[p * 16u + c] = float16_t(o[c]);   // == featpack's f[i] -> float16_t
    }
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u && sLum != 0u) atomicAdd(stats[0], sLum);
}
