#version 460
#extension GL_GOOGLE_include_directive : require

// AMD FSR 1.0 RCAS (Robust Contrast Adaptive Sharpening)
// Workgroup 64x1 remapped to 8x8 pixels with ARmp8x8

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D InputTexture;
layout(set = 0, binding = 1, rgba8) writeonly uniform image2D OutputTexture;

layout(push_constant) uniform PushConsts {
    uvec4 Const0;
    uvec2 OutSize;
} pc;

#define A_GPU 1
#define A_GLSL 1
#include "fsr/ffx_a.h"

#define FSR_RCAS_F 1

AF4 FsrRcasLoadF(ASU2 p) {
    return texelFetch(InputTexture, ivec2(p), 0);
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}

#include "fsr/ffx_fsr1.h"

void main() {
    AU2 gxy = ARmp8x8(gl_LocalInvocationID.x) + gl_WorkGroupID.xy * 8u;
    if (gxy.x >= pc.OutSize.x || gxy.y >= pc.OutSize.y) return;
    AF3 c;
    FsrRcasF(c.r, c.g, c.b, gxy, pc.Const0);
    imageStore(OutputTexture, ivec2(gxy), vec4(c, 1.0));
}
