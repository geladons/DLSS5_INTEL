#version 450
// ============================================================================
// DLSS 5 Stage 4: Frame Generation (FSR 3.1 / Optical Flow Interpolation)
// Computes bidirectional motion estimation and motion-compensated warping
// to synthesize an intermediate frame F_interp between F0 (t-1) and F1 (t).
//
// Push constants:
//   a = (canvasW, canvasH, searchRadius, searchStep)
//   b = (mode, 0, 0, 0)
//   c = (factor, occlThreshold, 0, 0)
//   d = (0, 0, 0, 0)
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#include "publish.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 1) readonly buffer PrevFrame { uint bufPrev[]; };
layout(std430, set = 0, binding = 2) readonly buffer CurrFrame { uint bufCurr[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OutFrame { uint bufOut[]; };

layout(push_constant) uniform Push {
    ivec4 a;
    ivec4 b;
    vec4 c;
    vec4 d;
} pc;

vec4 getPixel(int x, int y, int frameId) {
    x = clamp(x, 0, pc.a.x - 1);
    y = clamp(y, 0, pc.a.y - 1);
    uint idx = uint(y * pc.a.x + x);
    uint raw = (frameId == 0) ? bufPrev[idx] : bufCurr[idx];
    float b = float(raw & 0xFFu) * (1.0 / 255.0);
    float g = float((raw >> 8) & 0xFFu) * (1.0 / 255.0);
    float r = float((raw >> 16) & 0xFFu) * (1.0 / 255.0);
    float a = float((raw >> 24) & 0xFFu) * (1.0 / 255.0);
    return vec4(r, g, b, a);
}

float getLuma(vec3 rgb) {
    return dot(rgb, vec3(0.299, 0.587, 0.114));
}

vec4 sampleBilinear(vec2 pos, int frameId) {
    pos = clamp(pos, vec2(0.0), vec2(float(pc.a.x - 1), float(pc.a.y - 1)));
    int x0 = int(floor(pos.x));
    int y0 = int(floor(pos.y));
    int x1 = min(x0 + 1, pc.a.x - 1);
    int y1 = min(y0 + 1, pc.a.y - 1);
    float fx = pos.x - float(x0);
    float fy = pos.y - float(y0);

    vec4 c00 = getPixel(x0, y0, frameId);
    vec4 c10 = getPixel(x1, y0, frameId);
    vec4 c01 = getPixel(x0, y1, frameId);
    vec4 c11 = getPixel(x1, y1, frameId);

    vec4 c0 = mix(c00, c10, fx);
    vec4 c1 = mix(c01, c11, fx);
    return mix(c0, c1, fy);
}

uint packBGRA(vec4 col) {
    uint b = uint(clamp(col.z * 255.0 + 0.5, 0.0, 255.0));
    uint g = uint(clamp(col.y * 255.0 + 0.5, 0.0, 255.0));
    uint r = uint(clamp(col.x * 255.0 + 0.5, 0.0, 255.0));
    uint a = uint(clamp(col.w * 255.0 + 0.5, 0.0, 255.0));
    return b | (g << 8) | (r << 16) | (a << 24);
}

vec2 findMotion(ivec2 pos) {
    vec4 c0_center = getPixel(pos.x, pos.y, 0);
    vec4 c1_center = getPixel(pos.x, pos.y, 1);
    float l0_center = getLuma(c0_center.rgb);
    float l1_center = getLuma(c1_center.rgb);

    float minErr = abs(l0_center - l1_center) + length(c0_center.rgb - c1_center.rgb) * 0.5;
    vec2 bestOffset = vec2(0.0);

    // Early exit for static pixels
    if (minErr < 0.012) {
        return vec2(0.0);
    }

    // Stage 1: Coarse Diamond Search Pattern (8 candidates)
    const ivec2 coarseCandidates[8] = ivec2[](
        ivec2(-8, 0), ivec2(8, 0), ivec2(0, -8), ivec2(0, 8),
        ivec2(-4, -4), ivec2(4, -4), ivec2(-4, 4), ivec2(4, 4)
    );

    for (int i = 0; i < 8; ++i) {
        ivec2 d = coarseCandidates[i];
        vec4 s0 = getPixel(pos.x + d.x, pos.y + d.y, 0);
        vec4 s1 = getPixel(pos.x - d.x, pos.y - d.y, 1);

        float diffRgb = length(s0.rgb - s1.rgb);
        float diffLuma = abs(getLuma(s0.rgb) - getLuma(s1.rgb));
        float distPenalty = float(abs(d.x) + abs(d.y)) * 0.001;
        float err = diffRgb + diffLuma + distPenalty;

        if (err < minErr) {
            minErr = err;
            bestOffset = vec2(d);
        }
    }

    // Stage 2: Fine Diamond Refinement around best coarse candidate (8 candidates)
    const ivec2 fineCandidates[8] = ivec2[](
        ivec2(-2, 0), ivec2(2, 0), ivec2(0, -2), ivec2(0, 2),
        ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1)
    );

    vec2 base = bestOffset;
    for (int i = 0; i < 8; ++i) {
        ivec2 d = fineCandidates[i];
        vec2 cand = base + vec2(d);
        vec4 s0 = getPixel(pos.x + int(cand.x), pos.y + int(cand.y), 0);
        vec4 s1 = getPixel(pos.x - int(cand.x), pos.y - int(cand.y), 1);

        float diffRgb = length(s0.rgb - s1.rgb);
        float diffLuma = abs(getLuma(s0.rgb) - getLuma(s1.rgb));
        float err = diffRgb + diffLuma + float(abs(cand.x) + abs(cand.y)) * 0.001;

        if (err < minErr) {
            minErr = err;
            bestOffset = cand;
        }
    }

    // Stage 3: Subpixel luminance gradient optical flow refinement
    vec2 p0 = vec2(pos) + bestOffset;
    vec2 p1 = vec2(pos) - bestOffset;

    float l0_xp = getLuma(sampleBilinear(p0 + vec2(1.0, 0.0), 0).rgb);
    float l0_xm = getLuma(sampleBilinear(p0 - vec2(1.0, 0.0), 0).rgb);
    float l0_yp = getLuma(sampleBilinear(p0 + vec2(0.0, 1.0), 0).rgb);
    float l0_ym = getLuma(sampleBilinear(p0 - vec2(0.0, 1.0), 0).rgb);

    float l1_xp = getLuma(sampleBilinear(p1 + vec2(1.0, 0.0), 1).rgb);
    float l1_xm = getLuma(sampleBilinear(p1 - vec2(1.0, 0.0), 1).rgb);
    float l1_yp = getLuma(sampleBilinear(p1 + vec2(0.0, 1.0), 1).rgb);
    float l1_ym = getLuma(sampleBilinear(p1 - vec2(0.0, 1.0), 1).rgb);

    float gradX = 0.25 * ((l0_xp - l0_xm) + (l1_xp - l1_xm));
    float gradY = 0.25 * ((l0_yp - l0_ym) + (l1_yp - l1_ym));
    float gradT = getLuma(sampleBilinear(p0, 0).rgb) - getLuma(sampleBilinear(p1, 1).rgb);

    float gradLenSq = gradX * gradX + gradY * gradY;
    if (gradLenSq > 1e-4) {
        vec2 subDelta = -(gradT * vec2(gradX, gradY)) / (gradLenSq + 0.01);
        subDelta = clamp(subDelta, vec2(-0.5), vec2(0.5));
        bestOffset += subDelta;
    }

    return bestOffset;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= pc.a.x || pos.y >= pc.a.y) return;

    float factor = (pc.c.x > 0.0 && pc.c.x < 1.0) ? pc.c.x : 0.5;
    float occlThreshold = pc.c.y > 0.0 ? pc.c.y : 0.20;

    vec4 direct0 = getPixel(pos.x, pos.y, 0);
    vec4 direct1 = getPixel(pos.x, pos.y, 1);

    // Half-motion vector d
    vec2 halfMotion = findMotion(pos);

    // Warped coordinates:
    // When factor == 0.5: pos0 = pos + halfMotion, pos1 = pos - halfMotion
    vec2 pos0 = vec2(pos) + 2.0 * (1.0 - factor) * halfMotion;
    vec2 pos1 = vec2(pos) - 2.0 * factor * halfMotion;

    vec4 sample0 = sampleBilinear(pos0, 0);
    vec4 sample1 = sampleBilinear(pos1, 1);

    // Occlusion / disocclusion detection
    vec3 diff = abs(sample0.rgb - sample1.rgb);
    float maxDiff = max(diff.r, max(diff.g, diff.b));

    vec4 directBlend = mix(direct0, direct1, factor);
    vec4 warpedBlend = mix(sample0, sample1, factor);

    float occlFactor = smoothstep(occlThreshold * 0.75, occlThreshold * 1.5, maxDiff);
    vec3 outRgb = mix(warpedBlend.rgb, directBlend.rgb, occlFactor);

    // Preserve game HUD / UI alpha
    float outA = (abs(direct0.a - direct1.a) < 0.05) ? direct1.a : mix(direct0.a, direct1.a, factor);

    uint outIdx = uint(pos.y * pc.a.x + pos.x);
    bufOut[outIdx] = packBGRA(vec4(outRgb, outA));
}
