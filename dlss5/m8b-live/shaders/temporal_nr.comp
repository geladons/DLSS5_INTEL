#version 460
// SPDX-License-Identifier: Apache-2.0
// ============================================================================
// ChainEngine temporal conditioning (net-extent port of vendor
// compose_temporal, temporal.py:~172-190). Runs AFTER the 71-block chain,
// BEFORE compose. Rewrites the head in place and writes next-frame history:
//
//   col01     = fv[p*16+4+c] * 8 + 0.5    (scaled_color decode of source)
//   hist01    = fv[p*16+7+c] * 8 + 0.5    (features already substitute col01
//                                          on frame 1 via histValid=0)
//   alpha     = clamp(sigmoid(halfr(head[p*4+3])) * 0.73974609375, 0, 1)
//   predicted = clamp(col01 + halfr(head[p*4+c]) * 0.25, 0, 1)
//   outp      = predicted + alpha * (hist01 - predicted)
//   head[p*4+c] = halfr((outp - col01) * 4.0)     // corrected residual:
//                                        // compose's halfr(head)*0.25*gain
//                                        // reconstructs outp (gain=1) or a
//                                        // gain-scaled delta (gain!=1)
//   hs[p*3+c] = scaled_color(clamp(outp))          // next frame's history
//
// Vendor semantics kept: history domain is PRE-Phase30 (the neural output),
// so knob changes never contaminate the anchor; the full compose/encode tail
// (Phase30 intensity/colorStrength, delta residual, upscale reconstruction)
// is untouched.
//
// No atomics, no row-DC machinery (that correction was calibrated for the
// 288-token miniature; at full extent rows carry real content) -> fully
// deterministic per pixel.
//
// push a.x = pixel count (st[0].TOK = netW*netH), c.x = gain-anchor EMA
// alpha, d.x = histValid (pushed for parity/diagnostics; the reset-frame
// blend collapse rides in fv[15] instead - see the gate comment below).
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#include "publish.glsl"

// local half rounding (hr_*): publish.glsl half_round is a NO-OP on this Arc
// driver (packHalf2x16 fold); bit-exact vs numpy float16. Same as temporal.comp.
uint hr_bits(uint bx) {
    uint sign = (bx >> 16) & 0x8000u;
    uint mant = bx & 0x7FFFFFu;
    int e = int((bx >> 23) & 0xFFu);
    if (e == 255) {
        if (mant == 0u) return sign | 0x7C00u;
        uint m16 = mant >> 13;
        return sign | 0x7C00u | (m16 != 0u ? m16 : 1u);
    }
    int hexp = e - 112;
    if (hexp >= 31) return sign | 0x7C00u;
    if (hexp <= 0) {
        if (hexp < -10) return sign;
        mant |= 0x800000u;
        int shift = 14 - hexp;
        uint m = mant >> shift;
        uint rem = mant & ((1u << shift) - 1u);
        uint halfway = 1u << (shift - 1);
        if (rem > halfway || (rem == halfway && (m & 1u) != 0u)) {
            m++;
            if (m == 0x400u) return sign | 0x400u;
        }
        return sign | m;
    }
    uint m = mant >> 13;
    uint rem = mant & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (m & 1u) != 0u)) {
        m++;
        if (m == 0x400u) { m = 0u; hexp++; if (hexp >= 31) return sign | 0x7C00u; }
    }
    return sign | (uint(hexp) << 10) | m;
}
float hr_widen(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint e = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    uint b;
    if (e == 0u) {
        if (mant == 0u) b = sign;
        else {
            int exp = -1;
            while ((mant & 0x400u) == 0u) { mant <<= 1; --exp; }
            mant &= 0x3FFu;
            b = sign | (uint(114 + exp) << 23) | (mant << 13);
        }
    } else if (e == 31u) {
        b = sign | 0x7F800000u | (mant << 13);
    } else {
        b = sign | ((e - 15u + 127u) << 23) | (mant << 13);
    }
    return uintBitsToFloat(b);
}
float halfr(float x) { return hr_widen(hr_bits(floatBitsToUint(x))); }

// Residual-domain hold latch (constants in the 0..1 colour domain
// col01/Eb live in; 1 LSB = 1/255). Replaces the emit-verbatim hold +
// banded release, and the input-anchor conditioning on top of it. The
// pred=f(hist) -> emit -> fp16 store -> hist feedback never converged:
// on byte-identical input the emit wandered in a sustained period-2
// limit cycle (~55% of bytes changing per frame, +-4-5 LSB) - the
// owner-visible flicker. The old hold pinned that by re-emitting the
// stored byte while dist(cand, ref) < DB_HOLD - but pinned the OUTPUT,
// so faded-out or moved text left a permanent ghost where the input
// under the pixel changed.
//
// The latch now operates on the RESIDUAL r = emit - input instead:
//
//   bufHist layout (fp32, N = pc.a.x = TOK pixels):
//     [0,3N)   E - last emitted byte per channel (scaled_color store,
//                   unchanged; features.comp reads it as history)
//     [3N,6N)  P - previous frame's input col01 (rewritten EVERY frame)
//     [6N,9N)  A - anchor input: col01 at the last fresh emit / start of
//                   the current residual-refresh burst
//     [9N,10N) R - remaining refresh frames (0..R_FRAMES)
//
//   held residual  rh[c] = Eb[c] - P[c]      (last emit minus its input)
//   fresh residual rc[c] = cand[c] - col01[c] (pre-anchor blend candidate)
//
// A held pixel emits col01 + rh, plus a rate-limited step of the
// residual toward the fresh one. Static input (col01 == P) -> emit ==
// Eb byte-exact: the store lands on itself, the fv/x16 inputs freeze,
// the limit cycle pins - same fixed point the old hold needed. Slowly
// changing input -> the output tracks the input 1:1 while KEEPING the
// held residual, so no ghost of the old OUTPUT can survive an input
// change (text slides under a pixel -> emit moves with the new input,
// not with the old picture). The residual refresh is anchor-driven:
// dA = |col01 - A| is a distance from a FIXED anchor, so 1-2 LSB input
// noise cannot integrate toward it (bounded by the noise amplitude) -
// only a real, sustained input change > D_REF re-anchors and arms a
// refresh burst of at most R_FRAMES steps (terminates on static content
// by construction; it also ends early once rc matches rh within
// R_DONE). Each refresh step is PROPORTIONAL: the per-channel residual
// error e = rt - rh moves by max(R_STEP_MIN, R_FRAC*|e|) - exponential
// convergence toward rc. Small mismatches step at ~1/255/frame (below
// the compose gain amplification that made fixed 4/255 steps visible
// as output pops), large ghost-class mismatches still close fast
// (a 64/255 error clears in ~10 frames at x0.75 decay). A one-frame
// input jump > IN_CUT (real motion), a residual mismatch dr >= DB_CUT
// (scene cut / genuinely different enhancement), a reset frame
// (pc.d.x == 0), or uninitialised history all emit the fresh
// (gain-anchored) candidate uncapped and re-anchor. The drift/mismatch
// metrics keep the chroma-aware form (max(BT.601 luma dist, 2.5 * max
// channel dist)) so isoluminant chroma drift cannot sneak under a
// luma-only check, and they are measured on the pre-anchor candidate
// so temporal_stats mirrors them exactly.
const float DB_CUT    = 128.0 / 255.0; // residual mismatch >= this -> fresh
const float IN_CUT    =  24.0 / 255.0; // one-frame input jump -> fresh emit
const float D_REF     =  12.0 / 255.0; // input distance from anchor -> refresh
const float R_DONE    =   6.0 / 255.0; // residual match below -> refresh done
const float R_STEP_MIN=   1.0 / 255.0; // floor per refresh step (sub-visible)
const float R_FRAC    =   0.25;        // fraction of residual error per step
const float R_FRAMES  =  16.0;         // refresh frames per anchor event
// Warped-pixel refresh fraction is pc.c[1] (env D5C_MV_BETA, default 0.3);
// pc.c[2] != 0 (env D5C_MV_INTERP) bilinearly blends the per-block mv
// between block centres instead of nearest-block.

// (The earlier "direction trit" experiment - a per-channel reversal sign
// packed into the low mantissa bits of the history store - was removed:
// device readback showed the sustained static wander lived ENTIRELY in
// the fv[15]==0 pixel class that bypassed the latch outright, so a
// release-band reversal guard could never engage it. The banded latch
// below is what pins; plain scaled_color values are stored again.)

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 3) readonly buffer FeatV { float fv[]; };
layout(std430, set = 0, binding = 13) buffer Hist { float hs[]; };
// Previous-frame temporal state snapshot (host copies bufHist -> here
// before this dispatch): all prior-state reads go through hsPrev so
// the motion-compensated warps below can sample arbitrary source
// pixels without racing this pass's own writes to hs.
layout(std430, set = 0, binding = 17) readonly buffer HistPrev { float hsP[]; };
// Per-8x8-block motion vectors (motion_est.comp): vec4(mvx, mvy, conf, -)
// in net pixels; pixel p warps its state reads to q = p - mv.
layout(std430, set = 0, binding = 18) readonly buffer Mvs { vec4 mvs[]; };
layout(std430, set = 0, binding = 14) buffer HeadRaw { float head[]; };
// Gain-anchor luma sums (see temporal_stats.comp for the slot layout).
// Read by every invocation (uniform value -> broadcast); slots [4],[5]
// are written by invocation 0 only, disjoint from the read range.
layout(std430, set = 0, binding = 16) buffer Stats { uint stats[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

// Block motion for pixel (px,py). pc.c[2]==0: nearest block's vector.
// pc.c[2]!=0: bilinear blend of the four nearest BLOCK CENTRES (centre of
// block i sits at 8i+3.5); outside the centre hull the edge block's
// vector is used unchanged (constant extrapolation, no fade to zero).
vec2 blockMv(int px, int py, int netW, int netH) {
    const int BW = (netW + 7) / 8, BH = (netH + 7) / 8;
    if (pc.c[2] == 0.0)
        return mvs[uint(py / 8) * uint(BW) + uint(px / 8)].xy;
    const float ux = (float(px) - 3.5f) * 0.125f;
    const float uy = (float(py) - 3.5f) * 0.125f;
    int i0 = clamp(int(floor(ux)), 0, BW - 1);
    int j0 = clamp(int(floor(uy)), 0, BH - 1);
    const int i1 = min(i0 + 1, BW - 1), j1 = min(j0 + 1, BH - 1);
    const float fx = (i1 == i0) ? 0.0f : clamp(ux - float(i0), 0.0f, 1.0f);
    const float fy = (j1 == j0) ? 0.0f : clamp(uy - float(j0), 0.0f, 1.0f);
    const vec2 m00 = mvs[uint(j0) * uint(BW) + uint(i0)].xy;
    const vec2 m10 = mvs[uint(j0) * uint(BW) + uint(i1)].xy;
    const vec2 m01 = mvs[uint(j1) * uint(BW) + uint(i0)].xy;
    const vec2 m11 = mvs[uint(j1) * uint(BW) + uint(i1)].xy;
    return mix(mix(m00, m10, fx), mix(m01, m11, fx), fy);
}

void main() {
    uint p = gl_GlobalInvocationID.x;
    // Gain anchor (pc.c.x = max |gain| change per frame, 0 = off): the
    // network's mean output/input gain gNet is clamped to the previous
    // frame's achieved gain +/- R. Real exposure shifts still track
    // because input and output scale together; the free-run "breathing"
    // (network re-toning the same scene on pans) becomes a slow ramp.
    float k = 1.0;
    if (pc.c.x > 0.0) {
        // Residual-domain gain anchor. The network's global tone lift is
        // the mean residual dSum = pred_luma_sum - in_luma_sum (Q8 units,
        // same N both sides). stats[6] holds a SLEW-LIMITED track of it
        // (Q16 signed): the residual DC the emit is allowed to apply this
        // frame. Per-frame net noise is deadzoned out (k=1), while a
        // net-side re-tone can only grow the applied residual at
        // ~1.2/255 mean per frame - a global brightness slew limit. The
        // pre-slew build let a sub-threshold input shift that flipped
        // the net's tone decision land in ONE frame (flythrough pair
        // 64->65: input mad 2.45, no pixel >32; output mad 9.16, 45% of
        // pixels >8 - the field's "the picture literally pulses").
        float sIn  = float(stats[0]);
        float dCur = float(stats[1]) - sIn;
        float ema  = float(int(stats[6])) * (1.0 / 65536.0);
        float npx  = float(pc.a.x);
        // gate: residual DC too small to anchor reliably (flat input)
        if (abs(dCur) > npx * 0.5) {          // mean residual > ~0.5/256
            const float SLEW = 3.0;           // Q8/px per frame (~1.2/255)
            float maxStep = npx * SLEW;
            // Scene cuts / stream starts (histValid=0) reseed: a new
            // scene must not inherit the old scene's residual track.
            if (ema == 0.0 || pc.d.x == 0.0) ema = dCur;
            else ema += clamp(dCur - ema, -maxStep, maxStep);
            // k = ema/dCur makes the ACHIEVED residual ~= ema whenever
            // the net wants to grow it (same sign): the pop becomes a
            // ramp. Shrinking residuals apply immediately (k<=1 - never
            // hold stale enhancement). Opposite signs (the net flipped
            // tone polarity mid-slew) emit the neutral raw input until
            // ema crosses. Inside the noise deadzone k=1 outright so
            // per-frame jitter never modulates strength.
            float dz = 0.06 * max(abs(ema), npx * 0.5);
            k = (abs(dCur - ema) <= dz) ? 1.0
                                      : clamp(ema / dCur, 0.0, 1.0);
        } else if (ema == 0.0) {
            // first contact on a flat frame - seed the EMA at 0, no scale
        }
        if (p == 0u) {
            stats[4] = stats[0];
            stats[5] = stats[1];
            // new EMA goes to the spare slot - temporal_stats moves it to
            // [6] at the top of next frame, so no invocation ever reads
            // stats[6] while it is being written (intra-dispatch race).
            stats[7] = uint(int(ema * 65536.0));
        }
    }
    if (p >= uint(pc.a.x)) return;
    // head is compact [TOK,4] fp32 in the chain (only channels 0..3 exist);
    // temporal_nr is chain-only - m8b-live never builds this shader.
    uint hP = p * 4u;

    float logit = halfr(head[hP + 3u]);
    float alpha = clamp(1.0 / (1.0 + exp(-logit)) * halfr(0.73974609375), 0.0, 1.0);

    // History sanitisation moved UPSTREAM: features.comp AABB-clamps
    // channels 7-9 into the current 3x3 colour range before the network
    // and this blend see them (the scalar soft-reject that used to live
    // here oscillated at its boundary -> shimmer + sustained bright patch).
    float col01[3], h01[3];
    for (uint c = 0u; c < 3u; ++c) {
        col01[c] = fv[p * 16u + 4u + c] * 8.0 + 0.5;
        h01[c]   = fv[p * 16u + 7u + c] * 8.0 + 0.5;
    }

    // Per-pixel motion gate (hold_floor port): the history is identity-
    // reprojected, so on a pixel that MOVED h01 is stale and the alpha
    // blend would drag it into the output (ghost trails, colour drag).
    // fv[15] carries the gate factor computed UPSTREAM in features.comp
    // from the UNCLAMPED history vs the current colour - a combined
    // luma + max-channel distance collapsed across the same soft
    // ~5..25/255 smoothstep band: still pixels keep the full pull,
    // clearly-moved pixels reconstruct from the network alone. Measuring
    // on the raw history is required: the AABB clamp pins stale history
    // to the 3x3 box edge, deflating any clamp-side metric exactly where
    // the gate must fire; and a luma-only metric is chroma-blind
    // (isoluminant white->blue drift passed untouched). The clamped h01
    // above stays the blend TARGET - the clamp bounds how FAR history
    // may pull, the gate decides WHETHER it pulls at all.
    // fv[15] is also 0 on a history-reset frame (features' own histValid
    // path), collapsing the blend to outp=pred there - the reset-frame
    // full-strength fix needs no separate flag check here, and keying on
    // the pushed pc.d.x would silently disable the blend under a stale
    // engine (m12 deploys spv copies only). The flag is still pushed for
    // parity/diagnostics.
    float gate = fv[p * 16u + 15u];
    alpha *= gate;

    // Pass 1: the pre-anchor blend candidate (exactly what
    // temporal_stats.comp sums into stats[1]).
    float cand[3];
    for (uint c = 0u; c < 3u; ++c) {
        float pred = clamp(col01[c] + halfr(head[hP + c]) * 0.25, 0.0, 1.0);
        cand[c] = pred + alpha * (h01[c] - pred);
    }

    // Pass 2a: the gain-anchored candidate = what the emit WOULD be with
    // no latch. The anchor rescales the whole residual by k; it must be
    // composed INTO the release target rather than applied after the
    // latch - an anchor multiply downstream of a hold would drag the
    // "frozen" emit off history every time k jitters (measured: a
    // pre-anchor deadband never pinned for exactly that reason).
    float anchored[3];
    for (uint c = 0u; c < 3u; ++c)
        anchored[c] = col01[c] + (cand[c] - col01[c]) * k;

    // Residual hold: the latch reference is the last emit's RESIDUAL
    // rh = Eb - P (previous emitted byte minus the input it was produced
    // on), not the emit itself - so the emit moves WITH the input while
    // the enhancement offset stays pinned. Measured against the fresh
    // residual rc = cand - col01 through the same chroma-aware metric
    // features.comp uses for the fv[15] gate (max(BT.601 luma distance,
    // 2.5 * max per-channel distance)) so isoluminant chroma drift cannot
    // sneak under a luma-only check. Metrics use cand (pre-anchor) so
    // temporal_stats computes the identical d on identical inputs.
    //
    // Motion-compensated state fetch (v10): the residual state belongs
    // to the CONTENT, not the screen cell - on a pan the un-warped hold
    // kept enhancement detail anchored to screen position (measured:
    // 16.4% screen-fixed residual energy vs 7.5% temporal-off = the
    // owner's "phantoms on any motion"). E/P/A/R are therefore read
    // from hsPrev at q = p - mv, where this pixel's content sat last
    // frame. Integer mvs fetch the source pixel verbatim; fractional
    // mvs bilinear-blend P, A and the DECODED emit (each tap decoded to
    // 0..1 first, then blended - no re-snap, the blend is continuous)
    // and take R from the nearest tap. All taps must pass the same
    // NaN-safe range tests (uninitialised bufHist fails them) and q
    // must stay in the image - anything else takes the fresh path.
    const uint N = uint(pc.a.x);
    const int netW = pc.a.y, netH = pc.a.z;
    const int px = int(p % uint(netW)), py = int(p / uint(netW));
    vec2 mv = blockMv(px, py, netW, netH);
    // Per-pixel static override (pc.c[3] = D5C_MV_PIXSTATIC, in LSB):
    // a pixel whose UNWARPED input delta vs the same cell's previous
    // input is within the threshold is static no matter what the block
    // estimator said - force mv=(0,0) so the exact v9 path (unwarped
    // integer taps, anchor/budget, no BETA chase) applies. Blocks
    // touching motion otherwise contaminate their still pixels with
    // warped and bilinear-resampled state.
    if (pc.c[3] > 0.0) {
        const float dF0 = max(abs(col01[0] - hsP[3u * N + p * 3u + 0u]),
                              max(abs(col01[1] - hsP[3u * N + p * 3u + 1u]),
                                  abs(col01[2] - hsP[3u * N + p * 3u + 2u])));
        if (dF0 <= pc.c[3] * (1.0 / 255.0)) mv = vec2(0.0);
    }
    const float qx = float(px) - mv.x;
    const float qy = float(py) - mv.y;
    bool stValid = (qx >= 0.0 && qx <= float(netW - 1)
                    && qy >= 0.0 && qy <= float(netH - 1));
    float aP[3], aA[3], Ew[3];
    float Rw = 0.0;
    if (stValid) {
        if (mv.x == floor(mv.x) && mv.y == floor(mv.y)) {
            const uint sp = uint(int(qy)) * uint(netW) + uint(int(qx));
            for (uint c = 0u; c < 3u; ++c) {
                float v = hsP[3u * N + sp * 3u + c];
                if (!(v >= -0.01 && v <= 1.01)) stValid = false;
                aP[c] = v;
                float w = hsP[6u * N + sp * 3u + c];
                if (!(w >= -0.01 && w <= 1.01)) stValid = false;
                aA[c] = w;
                float sraw = hsP[sp * 3u + c];
                if (!(sraw > -1e9 && sraw < 1e9)) sraw = 0.0;
                Ew[c] = floor(clamp(sraw * 8.0 + 0.5, 0.0, 1.0) * 255.0 + 0.5)
                        * (1.0 / 255.0);
            }
            Rw = hsP[9u * N + sp];
            if (!(Rw >= 0.0 && Rw <= R_FRAMES)) stValid = false;
        } else {
            const int x0 = int(floor(qx)), y0 = int(floor(qy));
            const float fx = qx - float(x0), fy = qy - float(y0);
            for (uint c = 0u; c < 3u; ++c) { aP[c] = 0.0; aA[c] = 0.0; Ew[c] = 0.0; }
            for (int ty = 0; ty < 2; ++ty) {
                for (int tx = 0; tx < 2; ++tx) {
                    const int sx = clamp(x0 + tx, 0, netW - 1);
                    const int sy = clamp(y0 + ty, 0, netH - 1);
                    const uint sp = uint(sy) * uint(netW) + uint(sx);
                    const float wgt = (tx == 0 ? 1.0 - fx : fx)
                                    * (ty == 0 ? 1.0 - fy : fy);
                    for (uint c = 0u; c < 3u; ++c) {
                        float v = hsP[3u * N + sp * 3u + c];
                        if (!(v >= -0.01 && v <= 1.01)) stValid = false;
                        aP[c] += wgt * v;
                        float w = hsP[6u * N + sp * 3u + c];
                        if (!(w >= -0.01 && w <= 1.01)) stValid = false;
                        aA[c] += wgt * w;
                        float sraw = hsP[sp * 3u + c];
                        if (!(sraw > -1e9 && sraw < 1e9)) sraw = 0.0;
                        Ew[c] += wgt * floor(clamp(sraw * 8.0 + 0.5, 0.0, 1.0)
                                             * 255.0 + 0.5) * (1.0 / 255.0);
                    }
                }
            }
            const int nx = clamp(int(floor(qx + 0.5)), 0, netW - 1);
            const int ny = clamp(int(floor(qy + 0.5)), 0, netH - 1);
            Rw = hsP[9u * N + uint(ny) * uint(netW) + uint(nx)];
            if (!(Rw >= 0.0 && Rw <= R_FRAMES)) stValid = false;
        }
    }
    bool valid = stValid && (pc.d.x != 0.0);

    float rh[3], rc[3];
    for (uint c = 0u; c < 3u; ++c) {
        rh[c] = Ew[c] - aP[c];
        rc[c] = cand[c] - col01[c];
    }
    float dF = max(abs(col01[0] - aP[0]),
                   max(abs(col01[1] - aP[1]),
                       abs(col01[2] - aP[2])));
    float dA = max(abs(col01[0] - aA[0]),
                   max(abs(col01[1] - aA[1]),
                       abs(col01[2] - aA[2])));
    float drl = abs(0.299 * (rc[0] - rh[0])
                  + 0.587 * (rc[1] - rh[1])
                  + 0.114 * (rc[2] - rh[2]));
    float drc = max(abs(rc[0] - rh[0]),
                    max(abs(rc[1] - rh[1]),
                        abs(rc[2] - rh[2])));
    float dr = max(drl, 2.5 * drc);

    float An[3], Rn = 0.0;
    float emitT[3];
    if (!valid || dF > IN_CUT || dr >= DB_CUT) {
        // FRESH: real input jump / residual past the cut band / reset
        // frame / uninitialised history - emit the anchored candidate
        // uncapped, re-anchor, no refresh pending.
        for (uint c = 0u; c < 3u; ++c) { emitT[c] = anchored[c]; An[c] = col01[c]; }
    } else {
        // HELD: warped pixels refresh EVERY frame with no budget - while
        // content moves, P was written under a shifted footprint so rh is
        // stale by up to a frame of network boil; a steady pull toward
        // the fresh residual chases it without burning the anchor budget
        // meant for real input drift. The pull is SCALED by the motion
        // magnitude: frac = pc.c[1] * min(|mv|, 1) - a sub-pixel mv (slow
        // zoom drift recovered by the estimator's parabolic refine) gets
        // a proportional trickle instead of the full BETA, so the
        // static->moving transition is continuous rather than a discrete
        // path flip between neighbouring blocks (the loading-portrait
        // judder). Still pixels (mv == (0,0), guaranteed on static
        // content by the estimator's zero-motion bias + sub-pixel
        // threshold) keep the exact v9 path -> byte-identical output
        // frame to frame: distance from the FIXED anchor decides whether
        // the input has really moved (noise under D_REF can never trip
        // it); a trip re-anchors and arms a bounded R_FRAMES-step
        // residual refresh; an armed budget keeps stepping until it runs
        // out or rc converges.
        const float mvl = length(mv);
        const bool moving = (mvl > 0.01);
        bool refresh = moving;
        for (uint c = 0u; c < 3u; ++c) An[c] = aA[c];
        Rn = Rw;
        if (!moving) {
            if (dA > D_REF) {
                for (uint c = 0u; c < 3u; ++c) An[c] = col01[c];
                Rn = R_FRAMES;
            }
            if (Rn > 0.0) {
                if (dr < R_DONE) {
                    Rn = 0.0;
                } else {
                    refresh = true;
                    Rn = Rn - 1.0;
                }
            }
        }
        // emit = input + held residual, the residual stepped toward the
        // fresh (gain-anchored) one proportionally: moving pixels step
        // at min(|mv|,1) * max(R_STEP_MIN, BETA*|e|) per frame (the
        // magnitude scale keeps sub-pixel drift a gentle trickle), still
        // pixels at max(R_STEP_MIN, R_FRAC*|e|) while an armed budget
        // lasts, pure hold (cap 0) otherwise.
        for (uint c = 0u; c < 3u; ++c) {
            float rt = anchored[c] - col01[c];
            float e = rt - rh[c];
            float capc = refresh ? (moving ? min(mvl, 1.0) * max(R_STEP_MIN,
                                                                pc.c[1] * abs(e))
                                           : max(R_STEP_MIN, R_FRAC * abs(e)))
                                 : 0.0;
            emitT[c] = col01[c] + rh[c] + clamp(e, -capc, capc);
        }
    }

    // Pass 2b: snap the emit to the output byte grid so the emitted
    // value is always an exact display byte. The SAME value feeds the
    // head residual AND the history store - emitting and storing must
    // never diverge or the loop wanders again.
    for (uint c = 0u; c < 3u; ++c) {
        float b = floor(clamp(emitT[c], 0.0, 1.0) * 255.0 + 0.5); // emit byte
        float outp = b * (1.0 / 255.0);
        head[hP + c] = halfr((outp - col01[c]) * 4.0);
        float s = halfr(outp);                            // scaled_color(outp)
        s = halfr(s - 0.5);
        s = halfr(s * 0.125);
        hs[p * 3u + c] = s;
    }
    // Bookkeeping (every pixel, every frame): P becomes next frame's
    // previous input, A the (possibly re-anchored) drift reference, R
    // the remaining refresh budget.
    for (uint c = 0u; c < 3u; ++c) {
        hs[3u * N + p * 3u + c] = col01[c];
        hs[6u * N + p * 3u + c] = An[c];
    }
    hs[9u * N + p] = Rn;
}
