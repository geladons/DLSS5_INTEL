#version 460
// SPDX-License-Identifier: Apache-2.0
// ============================================================================
// ChainEngine temporal conditioning (net-extent port of vendor
// compose_temporal, temporal.py:~172-190). Runs AFTER the 71-block chain,
// BEFORE compose. Rewrites the head in place and writes next-frame history:
//
//   col01     = fv[p*16+4+c] * 8 + 0.5    (scaled_color decode of source)
//   hist01    = fv[p*16+7+c] * 8 + 0.5    (features already substitute col01
//                                          on frame 1 via histValid=0)
//   alpha     = clamp(sigmoid(halfr(head[p*4+3])) * 0.73974609375, 0, 1)
//   predicted = clamp(col01 + halfr(head[p*4+c]) * 0.25, 0, 1)
//   outp      = predicted + alpha * (hist01 - predicted)
//   head[p*4+c] = halfr((outp - col01) * 4.0)     // corrected residual:
//                                        // compose's halfr(head)*0.25*gain
//                                        // reconstructs outp (gain=1) or a
//                                        // gain-scaled delta (gain!=1)
//   hs[p*3+c] = scaled_color(clamp(outp))          // next frame's history
//
// Vendor semantics kept: history domain is PRE-Phase30 (the neural output),
// so knob changes never contaminate the anchor; the full compose/encode tail
// (Phase30 intensity/colorStrength, delta residual, upscale reconstruction)
// is untouched.
//
// No atomics, no row-DC machinery (that correction was calibrated for the
// 288-token miniature; at full extent rows carry real content) -> fully
// deterministic per pixel.
//
// push a.x = pixel count (st[0].TOK = netW*netH). Remaining fields unused.
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#include "publish.glsl"

// local half rounding (hr_*): publish.glsl half_round is a NO-OP on this Arc
// driver (packHalf2x16 fold); bit-exact vs numpy float16. Same as temporal.comp.
uint hr_bits(uint bx) {
    uint sign = (bx >> 16) & 0x8000u;
    uint mant = bx & 0x7FFFFFu;
    int e = int((bx >> 23) & 0xFFu);
    if (e == 255) {
        if (mant == 0u) return sign | 0x7C00u;
        uint m16 = mant >> 13;
        return sign | 0x7C00u | (m16 != 0u ? m16 : 1u);
    }
    int hexp = e - 112;
    if (hexp >= 31) return sign | 0x7C00u;
    if (hexp <= 0) {
        if (hexp < -10) return sign;
        mant |= 0x800000u;
        int shift = 14 - hexp;
        uint m = mant >> shift;
        uint rem = mant & ((1u << shift) - 1u);
        uint halfway = 1u << (shift - 1);
        if (rem > halfway || (rem == halfway && (m & 1u) != 0u)) {
            m++;
            if (m == 0x400u) return sign | 0x400u;
        }
        return sign | m;
    }
    uint m = mant >> 13;
    uint rem = mant & 0x1FFFu;
    if (rem > 0x1000u || (rem == 0x1000u && (m & 1u) != 0u)) {
        m++;
        if (m == 0x400u) { m = 0u; hexp++; if (hexp >= 31) return sign | 0x7C00u; }
    }
    return sign | (uint(hexp) << 10) | m;
}
float hr_widen(uint h) {
    uint sign = (h & 0x8000u) << 16;
    uint e = (h >> 10) & 0x1Fu;
    uint mant = h & 0x3FFu;
    uint b;
    if (e == 0u) {
        if (mant == 0u) b = sign;
        else {
            int exp = -1;
            while ((mant & 0x400u) == 0u) { mant <<= 1; --exp; }
            mant &= 0x3FFu;
            b = sign | (uint(114 + exp) << 23) | (mant << 13);
        }
    } else if (e == 31u) {
        b = sign | 0x7F800000u | (mant << 13);
    } else {
        b = sign | ((e - 15u + 127u) << 23) | (mant << 13);
    }
    return uintBitsToFloat(b);
}
float halfr(float x) { return hr_widen(hr_bits(floatBitsToUint(x))); }

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(std430, set = 0, binding = 3) readonly buffer FeatV { float fv[]; };
layout(std430, set = 0, binding = 13) writeonly buffer Hist { float hs[]; };
layout(std430, set = 0, binding = 14) buffer HeadRaw { float head[]; };
// Gain-anchor luma sums (see temporal_stats.comp for the slot layout).
// Read by every invocation (uniform value -> broadcast); slots [4],[5]
// are written by invocation 0 only, disjoint from the read range.
layout(std430, set = 0, binding = 16) buffer Stats { uint stats[]; };
layout(push_constant) uniform Push { ivec4 a; ivec4 b; vec4 c; vec4 d; } pc;

void main() {
    uint p = gl_GlobalInvocationID.x;
    // Gain anchor (pc.c.x = max |gain| change per frame, 0 = off): the
    // network's mean output/input gain gNet is clamped to the previous
    // frame's achieved gain +/- R. Real exposure shifts still track
    // because input and output scale together; the free-run "breathing"
    // (network re-toning the same scene on pans) becomes a slow ramp.
    float k = 1.0;
    if (pc.c.x > 0.0) {
        // Residual-domain gain anchor. The network's global tone lift is
        // the mean residual dSum = pred_luma_sum - in_luma_sum (Q8 units,
        // same N both sides). stats[6] holds its EMA (Q16 signed). The
        // applied residual is forced to the EMA -> per-frame breathing is
        // low-passed out while real tone shifts track within ~1/alpha
        // frames (a jump > 50% + floor snaps instantly = scene change).
        float sIn  = float(stats[0]);
        float dCur = float(stats[1]) - sIn;
        float ema  = float(int(stats[6])) * (1.0 / 65536.0);
        float npx  = float(pc.a.x);
        // gate: residual DC too small to anchor reliably (flat input)
        if (abs(dCur) > npx * 0.5) {          // mean residual > ~0.5/256
            float snap = abs(ema) * 0.5 + npx * 2.0;  // +2/256 mean floor
            if (ema == 0.0 || abs(dCur - ema) > snap) ema = dCur;
            else ema += (dCur - ema) * pc.c.x;
            k = clamp(ema / dCur, 0.25, 4.0);
        } else if (ema == 0.0) {
            // first contact on a flat frame - seed the EMA at 0, no scale
        }
        if (p == 0u) {
            stats[4] = stats[0];
            stats[5] = stats[1];
            // new EMA goes to the spare slot - temporal_stats moves it to
            // [6] at the top of next frame, so no invocation ever reads
            // stats[6] while it is being written (intra-dispatch race).
            stats[7] = uint(int(ema * 65536.0));
        }
    }
    if (p >= uint(pc.a.x)) return;
    // head is compact [TOK,4] fp32 in the chain (only channels 0..3 exist);
    // temporal_nr is chain-only - m8b-live never builds this shader.
    uint hP = p * 4u;

    float logit = halfr(head[hP + 3u]);
    float alpha = clamp(1.0 / (1.0 + exp(-logit)) * halfr(0.73974609375), 0.0, 1.0);

    // History sanitisation moved UPSTREAM: features.comp AABB-clamps
    // channels 7-9 into the current 3x3 colour range before the network
    // and this blend see them (the scalar soft-reject that used to live
    // here oscillated at its boundary -> shimmer + sustained bright patch).
    for (uint c = 0u; c < 3u; ++c) {
        float col01 = fv[p * 16u + 4u + c] * 8.0 + 0.5;
        float h01   = fv[p * 16u + 7u + c] * 8.0 + 0.5;
        float pred  = clamp(col01 + halfr(head[hP + c]) * 0.25, 0.0, 1.0);
        float outp  = pred + alpha * (h01 - pred);
        outp = col01 + (outp - col01) * k;              // gain anchor
        head[hP + c] = halfr((outp - col01) * 4.0);
        float s = halfr(clamp(outp, 0.0, 1.0));          // scaled_color(outp)
        s = halfr(s - 0.5);
        s = halfr(s * 0.125);
        hs[p * 3u + c] = s;
    }
}
