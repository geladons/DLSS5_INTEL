// ============================================================================
// DLSS 5 Frame Generation mode 2: anchor-to-anchor midpoint interpolation
// (Lossless-Scaling-class, +1 present of display latency).
//
// Unlike framegen.comp mode 1 (extrapolated residual transfer), the
// generated frame sits BETWEEN two real anchors, so motion error is
// bounded on both sides:
//
//   out = base + (1-conf) * mix( warp(procA - rawA, +2(1-t)*h),
//                                warp(procB - rawB, -2t*h), t )
//
// where h is a symmetric half-motion estimated on the RAW anchors
// (rawA -> rawB) and base is the REAL captured middle frame (midRaw,
// binding 10; without it, the unwarped rawA/rawB blend). The processed
// anchors contribute only their RESIDUAL (proc - raw): the generated
// frame is real midpoint content carrying the same neural + Phase30
// processing footprint as the anchors - the earlier colour-warped mix
// produced a smoothed, weaker frame that alternated character with the
// held anchors every other present (cadence flicker).
//
// Confidence gate: warped-sample disagreement + block-match error ->
// scale the transferred residual down (conf ~ 1 -> out ~= base) -
// always temporally honest, and the correct answer on scene cuts
// (every match fails -> output ~= midRaw).
//
// Push constants:
//   a = (canvasW, canvasH, searchRadius, searchStep)
//   b = (hasMid, 0, 0, 0)     hasMid: binding-10 midRaw valid
//   c = (factor, occlThreshold, 0, 0)
//   d = (0, 0, 0, 0)
//
// Bindings (shared setFrameGen_ layout):
//   1 = procA (older processed anchor, bufPrevFrame_)
//   2 = rawB  (newest raw anchor, bufCurrFrame_)
//   3 = out   (bufInterpOut_)
//   4 = rawA  (older raw anchor, bufPrevRaw_)
//   5 = procB (newest processed anchor, bufCurProc_)
//  10 = midRaw (real middle frame, bufMidRaw_)
// ============================================================================
#extension GL_GOOGLE_include_directive : require
#include "publish.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, set = 0, binding = 1) readonly buffer ProcA { uint bufProcA[]; };
layout(std430, set = 0, binding = 2) readonly buffer RawB { uint bufRawB[]; };
layout(std430, set = 0, binding = 3) writeonly buffer OutFrame { uint bufOut[]; };
layout(std430, set = 0, binding = 4) readonly buffer RawA { uint bufRawA[]; };
layout(std430, set = 0, binding = 5) readonly buffer ProcB { uint bufProcB[]; };
layout(std430, set = 0, binding = 10) readonly buffer MidRaw { uint bufMid[]; };

layout(push_constant) uniform Push {
    ivec4 a;
    ivec4 b;
    vec4 c;
    vec4 d;
} pc;

// frameId: 0=procA 1=rawB 2=rawA 3=procB 4=midRaw
vec4 getPixel(int x, int y, int frameId) {
    x = clamp(x, 0, pc.a.x - 1);
    y = clamp(y, 0, pc.a.y - 1);
    uint idx = uint(y * pc.a.x + x);
    uint raw = (frameId == 0) ? bufProcA[idx]
             : (frameId == 1) ? bufRawB[idx]
             : (frameId == 2) ? bufRawA[idx]
             : (frameId == 3) ? bufProcB[idx] : bufMid[idx];
    float b = float(raw & 0xFFu) * (1.0 / 255.0);
    float g = float((raw >> 8) & 0xFFu) * (1.0 / 255.0);
    float r = float((raw >> 16) & 0xFFu) * (1.0 / 255.0);
    float a = float((raw >> 24) & 0xFFu) * (1.0 / 255.0);
    return vec4(r, g, b, a);
}

float getLuma(vec3 rgb) {
    return dot(rgb, vec3(0.299, 0.587, 0.114));
}

vec4 sampleBilinear(vec2 pos, int frameId) {
    pos = clamp(pos, vec2(0.0), vec2(float(pc.a.x - 1), float(pc.a.y - 1)));
    int x0 = int(floor(pos.x));
    int y0 = int(floor(pos.y));
    int x1 = min(x0 + 1, pc.a.x - 1);
    int y1 = min(y0 + 1, pc.a.y - 1);
    float fx = pos.x - float(x0);
    float fy = pos.y - float(y0);

    vec4 c00 = getPixel(x0, y0, frameId);
    vec4 c10 = getPixel(x1, y0, frameId);
    vec4 c01 = getPixel(x0, y1, frameId);
    vec4 c11 = getPixel(x1, y1, frameId);

    vec4 c0 = mix(c00, c10, fx);
    vec4 c1 = mix(c01, c11, fx);
    return mix(c0, c1, fy);
}

uint packBGRA(vec4 col) {
    uint b = uint(clamp(col.z * 255.0 + 0.5, 0.0, 255.0));
    uint g = uint(clamp(col.y * 255.0 + 0.5, 0.0, 255.0));
    uint r = uint(clamp(col.x * 255.0 + 0.5, 0.0, 255.0));
    uint a = uint(clamp(col.w * 255.0 + 0.5, 0.0, 255.0));
    return b | (g << 8) | (r << 16) | (a << 24);
}

// 3x3 SAD block error between rawA(c0) and rawB(c1): mean abs rgb diff.
float anchorBlockErr(ivec2 c0, ivec2 c1) {
    float err = 0.0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            vec4 p0 = getPixel(c0.x + dx, c0.y + dy, 2);
            vec4 p1 = getPixel(c1.x + dx, c1.y + dy, 1);
            vec3 d = abs(p0.rgb - p1.rgb);
            err += (d.r + d.g + d.b) * 0.3333;
        }
    }
    return err * 0.1111;
}

// Symmetric anchor-to-anchor half-motion: find offset d with
// rawA(pos + d) ~= rawB(pos - d). 3x3 SAD keeps the match honest on
// animated grain; a distance prior prefers the smallest explaining
// vector. bestErr is the winning block error (confidence input).
vec2 findAnchorMotion(ivec2 pos, out float bestErr) {
    vec4 ra = getPixel(pos.x, pos.y, 2);
    vec4 rb = getPixel(pos.x, pos.y, 1);

    float minErr = anchorBlockErr(pos, pos);
    vec2 bestOffset = vec2(0.0);

    // Early exit for static pixels
    float lDiff = abs(getLuma(ra.rgb) - getLuma(rb.rgb))
                + length(ra.rgb - rb.rgb) * 0.5;
    if (lDiff < 0.012) {
        bestErr = 0.0;
        return vec2(0.0);
    }

    // Coarse search +-48 axial / +-32 diagonal half-motion: covers
    // ~96 px of anchor-to-anchor motion (two frame intervals) - camera
    // pans that defeated the +-24 one-sided matcher.
    const ivec2 coarseCandidates[22] = ivec2[](
        ivec2(-48, 0), ivec2(48, 0), ivec2(0, -48), ivec2(0, 48),
        ivec2(-32, -32), ivec2(32, -32), ivec2(-32, 32), ivec2(32, 32),
        ivec2(-24, 0), ivec2(24, 0), ivec2(0, -24), ivec2(0, 24),
        ivec2(-16, -16), ivec2(16, -16), ivec2(-16, 16), ivec2(16, 16),
        ivec2(-12, 0), ivec2(12, 0), ivec2(0, -12), ivec2(0, 12),
        ivec2(-6, -6), ivec2(6, -6)
    );

    for (int i = 0; i < 22; ++i) {
        ivec2 d = coarseCandidates[i];
        float err = anchorBlockErr(pos + d, pos - d)
                  + float(abs(d.x) + abs(d.y)) * 0.004;
        if (err < minErr) {
            minErr = err;
            bestOffset = vec2(d);
        }
    }

    // Fine +-2 / +-1 refinement around the best coarse candidate
    const ivec2 fineCandidates[8] = ivec2[](
        ivec2(-2, 0), ivec2(2, 0), ivec2(0, -2), ivec2(0, 2),
        ivec2(-1, -1), ivec2(1, -1), ivec2(-1, 1), ivec2(1, 1)
    );

    vec2 base = bestOffset;
    for (int i = 0; i < 8; ++i) {
        ivec2 d = fineCandidates[i];
        vec2 cand = base + vec2(d);
        float err = anchorBlockErr(pos + ivec2(int(cand.x), int(cand.y)),
                                   pos - ivec2(int(cand.x), int(cand.y)))
                  + float(abs(cand.x) + abs(cand.y)) * 0.004;
        if (err < minErr) {
            minErr = err;
            bestOffset = cand;
        }
    }

    // Subpixel luminance-gradient refinement on both anchors
    vec2 p0 = vec2(pos) + bestOffset;
    vec2 p1 = vec2(pos) - bestOffset;

    float l0_xp = getLuma(sampleBilinear(p0 + vec2(1.0, 0.0), 2).rgb);
    float l0_xm = getLuma(sampleBilinear(p0 - vec2(1.0, 0.0), 2).rgb);
    float l0_yp = getLuma(sampleBilinear(p0 + vec2(0.0, 1.0), 2).rgb);
    float l0_ym = getLuma(sampleBilinear(p0 - vec2(0.0, 1.0), 2).rgb);

    float l1_xp = getLuma(sampleBilinear(p1 + vec2(1.0, 0.0), 1).rgb);
    float l1_xm = getLuma(sampleBilinear(p1 - vec2(1.0, 0.0), 1).rgb);
    float l1_yp = getLuma(sampleBilinear(p1 + vec2(0.0, 1.0), 1).rgb);
    float l1_ym = getLuma(sampleBilinear(p1 - vec2(0.0, 1.0), 1).rgb);

    float gradX = 0.25 * ((l0_xp - l0_xm) + (l1_xp - l1_xm));
    float gradY = 0.25 * ((l0_yp - l0_ym) + (l1_yp - l1_ym));
    float gradT = getLuma(sampleBilinear(p0, 2).rgb) - getLuma(sampleBilinear(p1, 1).rgb);

    float gradLenSq = gradX * gradX + gradY * gradY;
    if (gradLenSq > 1e-4) {
        vec2 subDelta = -(gradT * vec2(gradX, gradY)) / (gradLenSq + 0.01);
        subDelta = clamp(subDelta, vec2(-0.5), vec2(0.5));
        bestOffset += subDelta;
    }

    bestErr = minErr;
    return bestOffset;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    if (pos.x >= pc.a.x || pos.y >= pc.a.y) return;

    float factor = (pc.c.x > 0.0 && pc.c.x < 1.0) ? pc.c.x : 0.5;
    float occlThreshold = pc.c.y > 0.0 ? pc.c.y : 0.20;

    // Symmetric half-motion on the raw anchors
    float matchErr;
    vec2 halfMotion = findAnchorMotion(pos, matchErr);

    // Warp the PROCESSED anchors minus their own RAW anchors: the neural +
    // Phase30 residual rides the motion onto the REAL middle frame. The
    // old form warped the processed colours directly - the generated
    // frame came out a two-anchor bilinear blur of already-processed
    // pixels: measurably smoother/weaker than the held processed anchor
    // it alternates with at 1:2 cadence (harness Temp/field_repro.py:
    // ~30% less residual magnitude, ~half the static residual grain, HF
    // split +0.44 LSB, chroma averaged between two anchors). That
    // periodic character alternation IS the cadence flicker the field
    // reported. Residual transfer sits the generated frame on real
    // midpoint content with the same processing footprint as the
    // anchors - the displayed G/P slots carry matching texture.
    vec2 pos0 = vec2(pos) + 2.0 * (1.0 - factor) * halfMotion;
    vec2 pos1 = vec2(pos) - 2.0 * factor * halfMotion;

    vec4 sample0 = sampleBilinear(pos0, 0);   // warped procA
    vec4 sample1 = sampleBilinear(pos1, 3);   // warped procB
    vec3 resA = sample0.rgb - sampleBilinear(pos0, 2).rgb;  // procA - rawA
    vec3 resB = sample1.rgb - sampleBilinear(pos1, 1).rgb;  // procB - rawB
    vec3 warpedRes = mix(resA, resB, factor);

    // Confidence: warped-sample disagreement OR hopeless block match.
    // Disagreement catches disocclusion/misses; matchErr catches
    // scene-wide motion beyond the search range. conf selects between the
    // motion-compensated residual and the same residual un-warped - the
    // base is always real content, so a failed match degrades to an
    // un-warped-residual frame, never a content mix and never a raw one.
    vec3 diff = abs(sample0.rgb - sample1.rgb);
    float maxDiff = max(diff.r, max(diff.g, diff.b));
    float occl = smoothstep(occlThreshold * 0.75, occlThreshold * 1.5, maxDiff);
    float badMatch = smoothstep(0.05, 0.30, matchErr);
    float conf = max(occl, badMatch);

    // Base: the real captured middle frame is always temporally honest
    // (scene cut -> every match fails -> out ~= midRaw + local residual:
    // still the correct midpoint content, now carrying the same
    // processing footprint as its neighbours). No midRaw -> unwarped RAW
    // anchor blend, so the residual still lands on content of the right
    // colour.
    vec4 directA = getPixel(pos.x, pos.y, 0);
    vec4 directB = getPixel(pos.x, pos.y, 3);
    vec3 base = (pc.b.x != 0)
              ? getPixel(pos.x, pos.y, 4).rgb
              : mix(getPixel(pos.x, pos.y, 2).rgb,
                    getPixel(pos.x, pos.y, 1).rgb, factor);

    // Residual continuity: scaling the transferred residual by (1-conf)
    // dropped it to zero wherever the anchor match failed - fast HUD
    // motion, rotating chroma, disocclusion - while the held anchors on
    // either side always carry full strength. The generated slot then
    // alternated residual strength with its neighbours every other
    // present (field: radar/HUD oscillation; harness: ~37% residual loss
    // inside rotating chroma, isolated raw-frame splats when conf ~ 1
    // globally). A failed match only invalidates the residual's
    // POSITION, not its existence: fall back to the UNWARPED anchor
    // residual at this pixel - the same residual state as the current
    // anchor generation, just not motion-compensated. The residual is
    // the enhancement field (detail/gain/temporal pull), not content:
    // even on a scene cut it adds a bounded +-residual pattern onto
    // still-correct base pixels, instead of splicing an unprocessed raw
    // frame between two processed ones.
    vec3 resLocalA = directA.rgb - getPixel(pos.x, pos.y, 2).rgb;
    vec3 resLocalB = directB.rgb - getPixel(pos.x, pos.y, 1).rgb;
    vec3 resLocal = mix(resLocalA, resLocalB, factor);
    vec3 outRgb = base + mix(warpedRes, resLocal, conf);
    float outA = (abs(directA.a - directB.a) < 0.05)
               ? directB.a : mix(directA.a, directB.a, factor);

    uint outIdx = uint(pos.y * pc.a.x + pos.x);
    bufOut[outIdx] = packBGRA(vec4(outRgb, outA));
}
