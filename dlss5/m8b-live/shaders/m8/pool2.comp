#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * pool2 -- M9 U-Net 2x2 average pool (nr_model.average_pool2) with zero
 * pad-to-multiple-of-8 (pad_spatial_end, bottom/right only) fused:
 *   out[y, x, c] = 0.25 * sum_{dy,dx in {0,1}} in[2y+dy, 2x+dx, c]
 *
 * Vectorized coalesced memory path (flags bit2):
 *   One invocation per (token, ch4) vec4 slot. Consecutive lanes touch consecutive
 *   128-bit memory addresses in DRAM -> 100% dense memory bus utilization (0 sector waste).
 *
 * Flags:
 *   bit0: input f16 (vs fp32)
 *   bit1: output e4m3 (vs half_round)
 *   bit2: 1 = vectorized 128-bit coalesced path; 0 = scalar token-thread path
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "publish.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf  { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Float4Buf { vec4      v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf   { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf  { f16vec4   v4[]; };

layout(push_constant, scalar) uniform Push {
    uint64_t a;      // in: fp32 or f16 [Hin*Win*C]
    uint64_t c;      // out: f16 [(Hpad/2)*(Wpad/2)*C]
    uint Hin, Win;   // valid input dims (pre-pad)
    uint Wpad;       // padded width (output width = Wpad/2)
    uint C;
    uint n;          // output token count = (Hpad/2)*(Wpad/2)
    uint flags;      // bit0: in f16; bit1: out e4m3; bit2: vectorized coalesced
} pc;

void main() {
    bool inF16 = (pc.flags & 1u) != 0u;
    bool outE4 = (pc.flags & 2u) != 0u;
    bool isVec = (pc.flags & 4u) != 0u;

    if (isVec) {
        uint c4 = pc.C / 4u;
        uint total_vec4 = pc.n * c4;
        uint idx = gl_GlobalInvocationID.x;
        if (idx >= total_vec4) return;
        uint t = idx / c4;
        uint ch4 = idx % c4;

        uint wout = pc.Wpad / 2u;
        uint y = t / wout, x = t % wout;
        uint y0 = y * 2u, x0 = x * 2u;

        vec4 acc = vec4(0.0);
        // np fold order of average_pool2: ((a[0,0]+a[1,0])+a[0,1])+a[1,1]
        for (uint dx = 0u; dx < 2u; ++dx)
            for (uint dy = 0u; dy < 2u; ++dy) {
                uint yy = y0 + dy, xx = x0 + dx;
                vec4 v = vec4(0.0);
                if (yy < pc.Hin && xx < pc.Win) {
                    uint src4 = (yy * pc.Win + xx) * c4 + ch4;
                    if (inF16) {
                        f16vec4 h4 = Half4Buf(pc.a).v4[src4];
                        v = vec4(f16_widen(float16BitsToUint16(h4.x)),
                                 f16_widen(float16BitsToUint16(h4.y)),
                                 f16_widen(float16BitsToUint16(h4.z)),
                                 f16_widen(float16BitsToUint16(h4.w)));
                    } else {
                        v = Float4Buf(pc.a).v4[src4];
                    }
                }
                acc += v;
            }
        vec4 m = acc * 0.25;
        uint dst4 = t * c4 + ch4;
        Half4Buf(pc.c).v4[dst4] = f16vec4(
            float16_t(outE4 ? e4m3(m.x) : half_round(m.x)),
            float16_t(outE4 ? e4m3(m.y) : half_round(m.y)),
            float16_t(outE4 ? e4m3(m.z) : half_round(m.z)),
            float16_t(outE4 ? e4m3(m.w) : half_round(m.w))
        );
        return;
    }

    // Scalar legacy path
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.n) return;
    uint wout = pc.Wpad / 2u;
    uint y = t / wout, x = t % wout;
    uint y0 = y * 2u, x0 = x * 2u;
    uint dst = t * pc.C;
    for (uint ch = 0u; ch < pc.C; ++ch) {
        float acc = 0.0;
        for (uint dx = 0u; dx < 2u; ++dx)
            for (uint dy = 0u; dy < 2u; ++dy) {
                uint yy = y0 + dy, xx = x0 + dx;
                float v = 0.0;
                if (yy < pc.Hin && xx < pc.Win) {
                    uint src = (yy * pc.Win + xx) * pc.C + ch;
                    v = inF16 ? f16_widen(uint(float16BitsToUint16(HalfBuf(pc.a).v[src])))
                              : FloatBuf(pc.a).v[src];
                }
                acc += v;
            }
        float m = acc * 0.25;
        HalfBuf(pc.c).v[dst + ch] = float16_t(outE4 ? e4m3(m) : half_round(m));
    }
}
