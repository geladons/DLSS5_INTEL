#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "publish.glsl"

/*
 * gemm_i8 -- INT8 Cooperative Matrix GEMM for Intel Arc Pro B50 (Battlemage Xe2).
 *
 * Hardware config: coopmat 8x16x32 A=i8 B=i8 C=i32 sat=0 scope=3 (Subgroup).
 * TM=8, TN=16, TK=32.
 * RM=4, RN=2 (BM=32, BN=32 tile per workgroup, preserving optimal Xe2 occupancy).
 * 1 subgroup of 32 invocations per workgroup (LOCAL_SIZE = 32).
 *
 * For K=32 shapes, (K + TK - 1)/TK = 1. The entire K-loop collapses into a single tile step (t=0),
 * eliminating software pipelining overhead and loop branching.
 * For K=128 shapes (e.g. weight2), the K-loop evaluates 4 tiles (128/32).
 *
 * Dequantization epilogue: Staged through shared memory for vendor-defined
 * cooperative matrix register lane de-swizzling and per-channel scale alignment.
 * Supports FP16 narrow output (with publish epilogues) and FP32 output (with fused residual add).
 * Also supports F_FUSED_I8_PRODUCER (writes INT8 activations + scales) and
 * F_FUSED_I8_CONSUMER (accumulates K-tiles with per-tile scales).
 */

const uint EPI_RESIDUAL_FP32 = 5u;
const uint EPI_RESIDUAL_F16  = 6u;
const uint EPI_COSQKV        = 7u;   // fused cosine_win publish (M12): Q/K cosine
                                     // norm + V e4m3 -> f16 oQW/oKW/oVW; the
                                     // fp32 C store is skipped entirely.
const uint EPI_GATHER_RES    = 8u;   // fused gather_residual (M13): window-order
                                     // proj tile -> image-order oRAW fp32 +
                                     // ffn_res*cos_skip + optional e4m3 pub.

// fp16-island rounding ops, verbatim from cosine_win.comp (EPI_COSQKV must
// reproduce that kernel's exact float math sequence for bit-exactness).
const float COSINE_NORM_FLOOR = 0.00006198883056640625;
float hmul(float l, float r) { precise float t = l * r; return half_round(t); }
float hadd(float l, float r) { precise float t = l + r; return half_round(t); }
float hfma(float l, float r, float acc) { precise float t = l * r + acc; return half_round(t); }

const uint F_TRANSPOSE          = 1u;
const uint F_NARROW             = 0x1000u;
const uint F_FUSED_I8_PRODUCER  = 0x2000u;
const uint F_FUSED_I8_CONSUMER  = 0x4000u;

layout(local_size_x = 32) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Int8Buf   { int8_t    v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf  { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Float4Buf { vec4      v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf   { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf  { f16vec4   v4[]; };

layout(push_constant, scalar) uniform Push {
    Int8Buf  a;
    Int8Buf  b;
    uint64_t c;          // HalfBuf if narrow (flags & 0x1000), FloatBuf if !narrow, Int8Buf if fused producer
    FloatBuf b_scale;   // per-channel scale B
    uint64_t a_scale;   // optional per-block scale A (if non-zero)
    uint32_t m, n, k, batch;
    uint32_t sa, sb, sc;    // per-batch element strides
    uint32_t flags;         // bit0: transpose B, bit12: narrow (0x1000), bit13: producer (0x2000), bit14: consumer (0x4000)
    uint32_t lda, ldb, ldc; // row strides; 0 = dense default
    float    scale_a;       // scalar scale A fallback
    uint64_t res;
    uint64_t skip;
    uint64_t out_scale;     // output scales if fused producer
    FloatBuf cosd;          // EPI_COSQKV: per-head attn_scale fp32 [H]
                            // (with epi==COSQKV: c/res/skip carry the oQW/oKW/oVW
                            //  f16 bases instead of their other meanings)
    uint gGeo0;             // EPI_GATHER_RES: Himg | (Wimg << 16)
    uint gGeo1;             // EPI_GATHER_RES: padTop | padLeft<<6 | gflags<<12 | wp8<<16
                            // (epi==GATHER_RES: c = image-order fp32 oRAW,
                            //  res = ffn residual, skip = attn_cos_skip,
                            //  cosd = e4m3 f16 publish dst, gated by gflags bit0)
} pc;

const uint TM = 8, TN = 16, TK = 32;
const uint RM = 4, RN = 2;
const uint BM = TM * RM, BN = TN * RN;

shared int32_t stage[BM * BN];
shared float   stage_f[BM * BN];

void main() {
    uint row = gl_WorkGroupID.y * BM;
    uint col = gl_WorkGroupID.x * BN;
    if (row >= pc.m || col >= pc.n) return;

    uint batch = gl_WorkGroupID.z;
    uint ao = batch * pc.sa;
    uint bo = batch * pc.sb;
    uint co = batch * pc.sc;

    uint lda = pc.lda != 0u ? pc.lda : pc.k;
    uint ldb = pc.ldb != 0u ? pc.ldb : ((pc.flags & 1u) != 0u ? pc.k : pc.n);
    uint ldc = pc.ldc != 0u ? pc.ldc : pc.n;

    coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[RM][RN];
    for (uint i = 0u; i < RM; i++) {
        for (uint j = 0u; j < RN; j++) {
            acc[i][j] = coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0);
        }
    }

    coopmat<int8_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a[RM];
    coopmat<int8_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b[RN];
    const uint tiles = (pc.k + TK - 1u) / TK;

    // --- CASE 1: FUSED CONSUMER (e.g. weight2 reading INT8 activations with per-tile scales) ---
    if ((pc.flags & F_FUSED_I8_CONSUMER) != 0u) {
        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            stage_f[e + 0u] = 0.0;
            stage_f[e + 1u] = 0.0;
            stage_f[e + 2u] = 0.0;
            stage_f[e + 3u] = 0.0;
        }
        subgroupMemoryBarrierShared();
        subgroupBarrier();

        uint num_k_tiles = (pc.k + TK - 1u) / TK;
        for (uint t = 0u; t < tiles; ++t) {
            coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> tile_acc[RM][RN];
            for (uint i = 0u; i < RM; i++) {
                for (uint j = 0u; j < RN; j++) {
                    tile_acc[i][j] = coopmat<int32_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(0);
                }
            }

            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[i], pc.a.v, ao + (row + i * TM) * lda + t * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);

            if ((pc.flags & 1u) != 0u) {
                for (uint j = 0u; j < RN; j++)
                    coopMatLoad(b[j], pc.b.v, bo + (col + j * TN) * ldb + t * TK, ldb,
                                gl_CooperativeMatrixLayoutColumnMajor);
            } else {
                for (uint j = 0u; j < RN; j++)
                    coopMatLoad(b[j], pc.b.v, bo + (t * TK) * ldb + col + j * TN, ldb,
                                gl_CooperativeMatrixLayoutRowMajor);
            }

            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    tile_acc[i][j] = coopMatMulAdd(a[i], b[j], tile_acc[i][j]);

            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    coopMatStore(tile_acc[i][j], stage, i * TM * BN + j * TN, BN,
                                 gl_CooperativeMatrixLayoutRowMajor);

            subgroupMemoryBarrierShared();
            subgroupBarrier();

            uint by = gl_WorkGroupID.z * ((pc.m + BM - 1u) / BM) + gl_WorkGroupID.y;
            float tile_scale_a = FloatBuf(pc.a_scale).v[by * num_k_tiles + t];
            for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
                stage_f[e + 0u] += float(stage[e + 0u]) * tile_scale_a;
                stage_f[e + 1u] += float(stage[e + 1u]) * tile_scale_a;
                stage_f[e + 2u] += float(stage[e + 2u]) * tile_scale_a;
                stage_f[e + 3u] += float(stage[e + 3u]) * tile_scale_a;
            }

            subgroupMemoryBarrierShared();
            subgroupBarrier();
        }

        uint epilogue = (pc.flags >> 8) & 0xFu;
        bool narrow = (pc.flags & F_NARROW) != 0u;

        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            uint r = row + e / BN;
            if (r >= pc.m) continue;
            uint c_base = col + (e % BN);
            uint at = co + r * ldc + c_base;

            vec4 v_out;
            for (uint k = 0u; k < 4u; ++k) {
                uint c = c_base + k;
                float scale_b = (c < pc.n) ? pc.b_scale.v[c] : 0.0;
                float val = stage_f[e + k] * scale_b;
                uint idx = at + k;
                float resVal = (epilogue == EPI_RESIDUAL_F16)
                    ? f16_widen(uint(float16BitsToUint16(HalfBuf(pc.res).v[idx])))
                    : FloatBuf(pc.res).v[idx];
                float skipVal = (c < pc.n) ? FloatBuf(pc.skip).v[c] : 0.0;
                v_out[k] = val + resVal * skipVal;
            }

            if (narrow) {
                if ((at & 3u) == 0u && (uint(pc.c) & 7u) == 0u) {
                    Half4Buf(pc.c).v4[at >> 2] = f16vec4(v_out);
                } else {
                    for (uint k = 0u; k < 4u; ++k) {
                        if (c_base + k < pc.n) HalfBuf(pc.c).v[at + k] = float16_t(v_out[k]);
                    }
                }
            } else {
                if ((at & 3u) == 0u && (uint(pc.c) & 15u) == 0u) {
                    Float4Buf(pc.c).v4[at >> 2] = v_out;
                } else {
                    for (uint k = 0u; k < 4u; ++k) {
                        if (c_base + k < pc.n) FloatBuf(pc.c).v[at + k] = v_out[k];
                    }
                }
            }
        }
        return;
    }

    if (tiles == 1u) {
        if ((pc.flags & 1u) != 0u) {
            // B is row-major (N, K): ColumnMajor load transposes to (K, N)
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[j], pc.b.v, bo + (col + j * TN) * ldb, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
        } else {
            // B is row-major (K, N)
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[j], pc.b.v, bo + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
        }
    } else {
        if ((pc.flags & 1u) != 0u) {
            for (uint t = 0u; t < tiles; ++t) {
                for (uint i = 0u; i < RM; i++)
                    coopMatLoad(a[i], pc.a.v, ao + (row + i * TM) * lda + t * TK, lda,
                                gl_CooperativeMatrixLayoutRowMajor);
                for (uint j = 0u; j < RN; j++)
                    coopMatLoad(b[j], pc.b.v, bo + (col + j * TN) * ldb + t * TK, ldb,
                                gl_CooperativeMatrixLayoutColumnMajor);
                for (uint i = 0u; i < RM; i++)
                    for (uint j = 0u; j < RN; j++)
                        acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
            }
        } else {
            for (uint t = 0u; t < tiles; ++t) {
                for (uint i = 0u; i < RM; i++)
                    coopMatLoad(a[i], pc.a.v, ao + (row + i * TM) * lda + t * TK, lda,
                                gl_CooperativeMatrixLayoutRowMajor);
                for (uint j = 0u; j < RN; j++)
                    coopMatLoad(b[j], pc.b.v, bo + (t * TK) * ldb + col + j * TN, ldb,
                                gl_CooperativeMatrixLayoutRowMajor);
                for (uint i = 0u; i < RM; i++)
                    for (uint j = 0u; j < RN; j++)
                        acc[i][j] = coopMatMulAdd(a[i], b[j], acc[i][j]);
            }
        }
    }

    // Epilogue: store accumulators into shared memory (hardware row-major de-swizzling)
    for (uint i = 0u; i < RM; i++)
        for (uint j = 0u; j < RN; j++)
            coopMatStore(acc[i][j], stage, i * TM * BN + j * TN, BN,
                         gl_CooperativeMatrixLayoutRowMajor);

    subgroupMemoryBarrierShared();
    subgroupBarrier();

    uint by = gl_WorkGroupID.z * ((pc.m + BM - 1u) / BM) + gl_WorkGroupID.y;
    float act_scale = (pc.a_scale != 0ul) ? FloatBuf(pc.a_scale).v[by] : pc.scale_a;
    uint epilogue = (pc.flags >> 8) & 0xFu;
    bool narrow = (pc.flags & F_NARROW) != 0u;

    if (epilogue == EPI_COSQKV) {
        // M12 cosw fusion on the int8 qkv path: identical math to the fp16
        // gemm EPI_COSQKV, except the staged value is int32 and goes through
        // the i8 dequant product first - val = i32acc * (act_scale * scale_b),
        // bit-identical to the fp32 the old epilogue wrote to oPROJW.
        uint Cq = pc.n / 3u;
        uint qkv = col / Cq;
        uint head = (col - qkv * Cq) / 32u;
        uint hcount = Cq / 32u;
        uint64_t dstBuf = (qkv == 0u) ? pc.c
                        : (qkv == 1u) ? pc.res : pc.skip;
        float scale = half_round(pc.cosd.v[head]);   // consumed by Q only

        uint lane = gl_LocalInvocationID.x;
        uint t = row + lane;
        if (t < pc.m) {
            uint outBase = ((gl_WorkGroupID.z * hcount + head) * 64u + t) * 32u;
            uint rb = lane * BN;
            if (qkv == 2u) {
                // V: dequant + plain e4m3 publish (cosine_win V block).
                for (uint k = 0u; k < 8u; k++) {
                    f16vec4 out4;
                    for (uint j = 0u; j < 4u; j++) {
                        uint c = col + k * 4u + j;
                        float scale_b = (c < pc.n) ? pc.b_scale.v[c] : 0.0;
                        float val = float(stage[rb + k * 4u + j]) * (act_scale * scale_b);
                        out4[j] = float16_t(e4m3(val));
                    }
                    Half4Buf(dstBuf).v4[(outBase >> 2) + k] = out4;
                }
            } else {
                // Q/K: dequant -> half_round -> cosine_win normalizeAndWrite().
                float h[32];
                for (uint k = 0u; k < 8u; k++)
                    for (uint j = 0u; j < 4u; j++) {
                        uint c = col + k * 4u + j;
                        float scale_b = (c < pc.n) ? pc.b_scale.v[c] : 0.0;
                        h[k * 4u + j] = half_round(float(stage[rb + k * 4u + j]) * (act_scale * scale_b));
                    }

                float partial[4][2];
                for (uint ln = 0u; ln < 4u; ln++)
                    for (uint parity = 0u; parity < 2u; parity++) {
                        uint ch = ln * 2u + parity;
                        float first  = hfma(h[ch + 8u],  h[ch + 8u],  hmul(h[ch],       h[ch]));
                        float second = hfma(h[ch + 24u], h[ch + 24u], hmul(h[ch + 16u], h[ch + 16u]));
                        partial[ln][parity] = hadd(first, second);
                    }
                float two[4][2], one[4][2];
                for (uint ln = 0u; ln < 4u; ln++)
                    for (uint p = 0u; p < 2u; p++) two[ln][p] = hadd(partial[ln][p], partial[ln ^ 2u][p]);
                for (uint ln = 0u; ln < 4u; ln++)
                    for (uint p = 0u; p < 2u; p++) one[ln][p] = hadd(two[ln][p], two[ln ^ 1u][p]);

                float norm = max(hadd(one[0][0], one[0][1]), half_round(COSINE_NORM_FLOOR));
                float reciprocal = half_round(inversesqrt(norm));

                for (uint k = 0u; k < 8u; k++) {
                    f16vec4 out4;
                    for (uint j = 0u; j < 4u; j++) {
                        float value = hmul(h[k * 4u + j], reciprocal);
                        if (qkv == 0u) value = hmul(value, scale);   // Q only
                        out4[j] = float16_t(e4m3(value));
                    }
                    Half4Buf(dstBuf).v4[(outBase >> 2) + k] = out4;
                }
            }
        }
        return;
    }

    // --- CASE 2: FUSED PRODUCER (e.g. weight1 writing INT8 activations + scales directly to O.oG3) ---
    if ((pc.flags & F_FUSED_I8_PRODUCER) != 0u) {
        float my_max = 0.0;
        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            uint r = row + e / BN;
            uint c_base = col + (e % BN);
            for (uint k = 0u; k < 4u; ++k) {
                uint c = c_base + k;
                float scale_b = (c < pc.n) ? pc.b_scale.v[c] : 0.0;
                float val = float(stage[e + k]) * (act_scale * scale_b);
                if (epilogue != 0u) val = publish(epilogue, val);
                stage_f[e + k] = val;
                if (r < pc.m && c < pc.n) {
                    my_max = max(my_max, abs(val));
                }
            }
        }

        float tile_max = subgroupMax(my_max);
        float tile_scale = (tile_max > 0.0) ? (tile_max / 127.0) : 1.0;
        float inv_tile_scale = 1.0 / tile_scale;

        uint num_col_tiles = (pc.n + BN - 1u) / BN;
        if (gl_LocalInvocationID.x == 0u) {
            FloatBuf(pc.out_scale).v[gl_WorkGroupID.y * num_col_tiles + gl_WorkGroupID.x] = tile_scale;
        }

        subgroupMemoryBarrierShared();
        subgroupBarrier();

        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            uint r = row + e / BN;
            if (r >= pc.m) continue;
            uint c_base = col + (e % BN);
            uint at = co + r * ldc + c_base;

            for (uint k = 0u; k < 4u; ++k) {
                if (c_base + k < pc.n) {
                    int q = int(round(stage_f[e + k] * inv_tile_scale));
                    Int8Buf(pc.c).v[at + k] = int8_t(clamp(q, -127, 127));
                }
            }
        }
        return;
    }

    if (epilogue == EPI_RESIDUAL_FP32 || epilogue == EPI_RESIDUAL_F16) {
        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            uint r = row + e / BN;
            if (r >= pc.m) continue;
            uint c_base = col + (e % BN);
            uint at = co + r * ldc + c_base;

            vec4 v_out;
            for (uint k = 0u; k < 4u; ++k) {
                uint c = c_base + k;
                float scale_b = (c < pc.n) ? pc.b_scale.v[c] : 0.0;
                float val = float(stage[e + k]) * (act_scale * scale_b);
                uint idx = at + k;
                float resVal = (epilogue == EPI_RESIDUAL_F16)
                    ? f16_widen(uint(float16BitsToUint16(HalfBuf(pc.res).v[idx])))
                    : FloatBuf(pc.res).v[idx];
                float skipVal = (c < pc.n) ? FloatBuf(pc.skip).v[c] : 0.0;
                v_out[k] = val + resVal * skipVal;
            }
            if (narrow) {
                if ((at & 3u) == 0u && (uint(pc.c) & 7u) == 0u) {
                    Half4Buf(pc.c).v4[at >> 2] = f16vec4(v_out);
                } else {
                    for (uint k = 0u; k < 4u; ++k) {
                        if (c_base + k < pc.n) HalfBuf(pc.c).v[at + k] = float16_t(v_out[k]);
                    }
                }
            } else {
                if ((at & 3u) == 0u && (uint(pc.c) & 15u) == 0u) {
                    Float4Buf(pc.c).v4[at >> 2] = v_out;
                } else {
                    for (uint k = 0u; k < 4u; ++k) {
                        if (c_base + k < pc.n) FloatBuf(pc.c).v[at + k] = v_out[k];
                    }
                }
            }
        }
    } else if (epilogue == EPI_GATHER_RES) {
        // M13 gather fusion on the int8 proj path: identical math to the fp16
        // gemm EPI_GATHER_RES, except the staged value is int32 and goes
        // through the i8 dequant product first - val = i32acc * (act_scale *
        // scale_b), bit-identical to the fp32 the old path wrote to oABW.
        uint Himg = pc.gGeo0 & 0xFFFFu;
        uint Wimg = pc.gGeo0 >> 16;
        uint padTop = pc.gGeo1 & 0x3Fu;
        uint padLeft = (pc.gGeo1 >> 6) & 0x3Fu;
        uint gfl = (pc.gGeo1 >> 12) & 0xFu;
        uint wp8 = pc.gGeo1 >> 16;
        bool pub = (gfl & 1u) != 0u;
        bool b16 = (gfl & 2u) != 0u;
        uint w = gl_WorkGroupID.z;             // window index
        uint wy = w / wp8, wx = w % wp8;

        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            uint tok = row + e / BN;           // window-local token i (0..63)
            if (tok >= pc.m) continue;
            uint ly = tok / 8u, lx = tok % 8u;
            int y = int(wy * 8u + ly) - int(padTop);
            int x = int(wx * 8u + lx) - int(padLeft);
            if (y < 0 || uint(y) >= Himg || x < 0 || uint(x) >= Wimg) continue;
            uint io4 = (uint(y) * Wimg + uint(x)) * pc.n + col + (e % BN);
            vec4 bv;
            if (b16) {
                f16vec4 r4 = Half4Buf(pc.res).v4[io4 >> 2];
                bv = vec4(f16_widen(uint(float16BitsToUint16(r4.x))),
                          f16_widen(uint(float16BitsToUint16(r4.y))),
                          f16_widen(uint(float16BitsToUint16(r4.z))),
                          f16_widen(uint(float16BitsToUint16(r4.w))));
            } else {
                bv = Float4Buf(pc.res).v4[io4 >> 2];
            }
            vec4 dv = Float4Buf(pc.skip).v4[(col + (e % BN)) >> 2];
            vec4 av;
            for (uint k = 0u; k < 4u; ++k)
                av[k] = float(stage[e + k]) * (act_scale * pc.b_scale.v[col + (e % BN) + k]);
            // per-element: val = a + b*cos. The standalone gather's driver
            // codegen contracts this to a single fma - emit fma() explicitly
            // so the fused epilogue rounds identically bit-for-bit.
            vec4 val = vec4(fma(bv.x, dv.x, av.x),
                            fma(bv.y, dv.y, av.y),
                            fma(bv.z, dv.z, av.z),
                            fma(bv.w, dv.w, av.w));
            Float4Buf(pc.c).v4[io4 >> 2] = val;
            if (pub)
                Half4Buf(uint64_t(pc.cosd)).v4[io4 >> 2] =
                    f16vec4(float16_t(e4m3(val.x)), float16_t(e4m3(val.y)),
                            float16_t(e4m3(val.z)), float16_t(e4m3(val.w)));
        }
    } else {
        for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
            uint r = row + e / BN;
            if (r >= pc.m) continue;
            uint c_base = col + (e % BN);
            uint at = co + r * ldc + c_base;

            vec4 v_out;
            for (uint k = 0u; k < 4u; ++k) {
                uint c = c_base + k;
                float scale_b = (c < pc.n) ? pc.b_scale.v[c] : 0.0;
                float val = float(stage[e + k]) * (act_scale * scale_b);
                if (epilogue != 0u) val = publish(epilogue, val);
                v_out[k] = val;
            }
            if (narrow) {
                if ((at & 3u) == 0u && (uint(pc.c) & 7u) == 0u) {
                    Half4Buf(pc.c).v4[at >> 2] = f16vec4(v_out);
                } else {
                    for (uint k = 0u; k < 4u; ++k) {
                        if (c_base + k < pc.n) HalfBuf(pc.c).v[at + k] = float16_t(v_out[k]);
                    }
                }
            } else {
                if ((at & 3u) == 0u && (uint(pc.c) & 15u) == 0u) {
                    Float4Buf(pc.c).v4[at >> 2] = v_out;
                } else {
                    for (uint k = 0u; k < 4u; ++k) {
                        if (c_base + k < pc.n) FloatBuf(pc.c).v[at + k] = v_out[k];
                    }
                }
            }
        }
    }
}
