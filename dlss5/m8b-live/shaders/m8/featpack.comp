#version 450
// ============================================================================
// M8b featpack — bridge the live features stage into the DLSSNR chain input.
// features.comp writes the 16-channel feature volume as fp32 (binding 3, the
// chain arena oFeatV slot); the chain's input adapter GEMM consumes f16 at
// oX16 (M8a layout). One thread per element, RNE fp32->f16 (same conversion
// the M8a host upload did with F16C, same RNE semantics on GPU).
//
//   push: { FloatBuf src; HalfBuf dst; uint n; }   n = TOK*16 = 4608
// ============================================================================
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf  { float16_t v[]; };

layout(push_constant, scalar) uniform Push { FloatBuf src; HalfBuf dst; uint n; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    pc.dst.v[i] = float16_t(pc.src.v[i]);
}
