#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * upmerge — M9 U-Net decoder merges with fused nearest-neighbour x2 upsample
 * (nr_model.nearest_upsample2_crop + decoder_input_merge / b70 pre-merge).
 * One invocation per TARGET token; loops channels.
 *
 * kind 0: decoder/upsample transition (b39, b48, b56, b62, b66):
 *             c[y,x,ch] = a[y/2, x/2, ch] + widen(b[y,x,ch]) * sin[ch]   (fp32 raw)
 *             h[y,x,ch] = e4m3(c)                                       (publish)
 *          a = projection GEMM output fp32 at the LOW scale [Hl*Wl*C]
 *          b = skip f16 (e4m3) at the TARGET scale [Ht*Wt*C]
 *          target dims (Ht, Wt) <= (2*Hl, 2*Wl) — the crop.
 * kind 1: b70 pre-merge (fp32 out, no publish):
 *             c[y,x,ch] = widen(a[y/2,x/2,ch]) * sin[ch] + widen(b[y,x,ch]) * cos[ch]
 *          a = f16 low-scale value (b69 out), b = full-resolution skip f16.
 * sin/cos tables are fp32 side tables (placeVecF16 widened on the host).
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "publish.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf  { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf   { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Float4Buf { vec4      v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf  { f16vec4   v4[]; };

layout(push_constant, scalar) uniform Push {
    uint64_t a;      // low-scale input (fp32 kind0 / f16 kind1)
    uint64_t b;      // skip f16 at target scale
    uint64_t c;      // out fp32 [Ht*Wt*C]
    uint64_t d;      // sin vector fp32 [C]
    uint64_t e;      // cos vector fp32 [C] (kind1 only)
    uint64_t h;      // out f16 publish (kind0 only)
    uint Wt, Ht;     // target dims
    uint Wl;         // low-scale width (H_l = Ht/2 covered by crop; only Wl needed)
    uint C;
    uint kind;
} pc;

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.Ht * pc.Wt) return;
    uint y = t / pc.Wt, x = t % pc.Wt;
    uint lowRow = (y / 2u) * pc.Wl + (x / 2u);
    uint C4 = pc.C / 4u;
    uint t4 = t * C4;
    uint lowRow4 = lowRow * C4;

    if (pc.kind == 0u) {
        for (uint ch4 = 0u; ch4 < C4; ++ch4) {
            f16vec4 b_raw = Half4Buf(pc.b).v4[t4 + ch4];
            vec4 bv = vec4(
                f16_widen(uint(float16BitsToUint16(b_raw.x))),
                f16_widen(uint(float16BitsToUint16(b_raw.y))),
                f16_widen(uint(float16BitsToUint16(b_raw.z))),
                f16_widen(uint(float16BitsToUint16(b_raw.w)))
            );
            vec4 sv = Float4Buf(pc.d).v4[ch4];
            vec4 av = Float4Buf(pc.a).v4[lowRow4 + ch4];

            precise float r0 = av.x + bv.x * sv.x;
            precise float r1 = av.y + bv.y * sv.y;
            precise float r2 = av.z + bv.z * sv.z;
            precise float r3 = av.w + bv.w * sv.w;

            Float4Buf(pc.c).v4[t4 + ch4] = vec4(r0, r1, r2, r3);
            Half4Buf(pc.h).v4[t4 + ch4] = f16vec4(
                float16_t(e4m3(r0)),
                float16_t(e4m3(r1)),
                float16_t(e4m3(r2)),
                float16_t(e4m3(r3))
            );
        }
    } else {
        for (uint ch4 = 0u; ch4 < C4; ++ch4) {
            f16vec4 b_raw = Half4Buf(pc.b).v4[t4 + ch4];
            vec4 bv = vec4(
                f16_widen(uint(float16BitsToUint16(b_raw.x))),
                f16_widen(uint(float16BitsToUint16(b_raw.y))),
                f16_widen(uint(float16BitsToUint16(b_raw.z))),
                f16_widen(uint(float16BitsToUint16(b_raw.w)))
            );
            vec4 sv = Float4Buf(pc.d).v4[ch4];
            f16vec4 a_raw = Half4Buf(pc.a).v4[lowRow4 + ch4];
            vec4 av = vec4(
                f16_widen(uint(float16BitsToUint16(a_raw.x))),
                f16_widen(uint(float16BitsToUint16(a_raw.y))),
                f16_widen(uint(float16BitsToUint16(a_raw.z))),
                f16_widen(uint(float16BitsToUint16(a_raw.w)))
            );
            vec4 cv = Float4Buf(pc.e).v4[ch4];

            precise float r0 = av.x * sv.x + bv.x * cv.x;
            precise float r1 = av.y * sv.y + bv.y * cv.y;
            precise float r2 = av.z * sv.z + bv.z * cv.z;
            precise float r3 = av.w * sv.w + bv.w * cv.w;

            Float4Buf(pc.c).v4[t4 + ch4] = vec4(r0, r1, r2, r3);
        }
    }
}
