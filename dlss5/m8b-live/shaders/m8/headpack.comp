#version 450
// ============================================================================
// M8b headpack — chain output -> the m4 head buffer layout, as a MATCHED
// RESIDUAL. The chain head GEMM writes [TOK,16] fp32 at oHEAD (N padded 16;
// real head = 4 channels: matmul(tokens[...,:16], out_gain) +
// matmul(tokens[...,16:], out_conv), folded into rows 0-15/16-31 of the
// [32,16] weight, cols 4-15 = 0).
//
// Two passes (push.mode):
//   mode 0 (DC pass): atomicAdd the per-channel sum of the 4 head channels
//       over all TOK tokens into dc[0..3] (host zeroes it with
//       vkCmdFillBuffer before this dispatch).
//   mode 1 (pack pass): dst[p*4+c] = (src[p*16+c] - dc[c]/ntok) * gain
//       The DC subtraction removes the input/graph bias (the measured head
//       carries a per-channel DC of -1.3/-1.3/-0.5 vs the design's |mean|
//       < 0.02, docs/m6b-graph-design.md:391) — a matched detail residual is
//       zero-mean by construction. The gain (0.2, net 0.05 after compose's
//       vendor 0.25) brings the measured residual std (~1.0, delta std ~0.25
//       at the vendor factor) into the design envelope (std 0.005..0.1).
// The temporal gate (ch 3) is carried through unchanged (unused on the
// still-frame path, as in m3).
//
//   push: { FloatBuf src; FloatBuf dst; FloatBuf dc; uint ntok; float gain;
//           uint mode; uint cols; }
//   BUG-B1 FIX (2026-09-22): the DC pass is now PER TOKEN ROW (row = p/cols),
//   not global. Measured row DC reached +/-1.4/255 in B with anti-correlated R
//   (probe: [dbg] head4 rowDC) - the global pass could not see it and it
//   painted colored horizontal bands (60px tall) on screen. dc[] must hold
//   rows*4 floats (24*4*4 = 384 B; the host slot is 1024 B).
// ============================================================================
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_atomic_float : require

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float v[]; };

layout(push_constant, scalar) uniform Push {
    FloatBuf src; FloatBuf dst; FloatBuf dc;
    uint ntok;
    float gain;
    uint mode;
    uint cols;
} pc;

void main() {
    uint p = gl_GlobalInvocationID.x;
    if (p >= pc.ntok) return;
    uint row = p / pc.cols;
    if (pc.mode == 0u) {
        for (uint c = 0u; c < 4u; ++c)
            atomicAdd(pc.dc.v[row * 4u + c], pc.src.v[p * 16u + c]);
        return;
    }
    float inv = 1.0f / float(pc.cols);
    for (uint c = 0u; c < 4u; ++c)
        pc.dst.v[p * 4u + c] = (pc.src.v[p * 16u + c] - pc.dc.v[row * 4u + c] * inv) * pc.gain;
}
