// SPDX-License-Identifier: Apache-2.0
#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * gemm — M7b cooperative-matrix GEMM, adapted from the reference
 * src/gpu/gemm_resident.comp (READ-ONLY study) to this prototype's shapes.
 *
 *   C[M,N] (+batch) = A[M,K] @ B[K,N]        (flags bit0 = 0: B row-major KxN)
 *   C[M,N] (+batch) = A[M,K] @ B[N,K]^T      (flags bit0 = 1: B row-major NxK,
 *                                             consumed via a ColumnMajor coopmat
 *                                             load = the transpose for free,
 *                                             design doc SS C.1 "matmul_nt")
 *
 * FP16 operands, FP32 accumulator (coopmat config 8x16x16 f16xf16->f32, M0-proven).
 * One subgroup per workgroup, register block RM=2 x RN=2 -> 16x32 tile; every shape
 * used by global block 31 is a whole multiple of 16x32 (M=288, N in {4096,1024,3072,
 * 288,32}), so no tail handling is needed at this prototype stage.
 *
 * A is float16 (a separate to_half pass handles fp32 carriers, exactly like the
 * reference runtime's rt.to_half; the design's in-kernel A_F32 fold is a later
 * optimization). Epilogues run on the accumulator's own components and the matrix
 * stores straight to global (reference notes/phase38 rule: store only into an array
 * of the matrix's own component type; the narrow f16 path stages through shared
 * memory for coalesced 4-wide stores).
 *
 * flags: bit0 TRANSPOSE_B | bit12 narrow(f16 out) | bits 8-11 EPI (0 NONE,1 E4M3,
 * 2 GATE, 3 GATE_E4M3, 4 HALF — design doc SS C.1, xmxres.EPI_*).
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

#include "publish.glsl"

const uint EPI_RESIDUAL_FP32 = 5u;
const uint EPI_RESIDUAL_F16  = 6u;
const uint EPI_COSQKV        = 7u;   // fused cosine_win publish (M12): Q/K cosine
                                     // norm + V e4m3 -> f16 oQW/oKW/oVW; the
                                     // fp32 C store is skipped entirely.

// fp16-island rounding ops, verbatim from cosine_win.comp (EPI_COSQKV must
// reproduce that kernel's exact float math sequence for bit-exactness).
const float COSINE_NORM_FLOOR = 0.00006198883056640625;
float hmul(float l, float r) { precise float t = l * r; return half_round(t); }
float hadd(float l, float r) { precise float t = l + r; return half_round(t); }
float hfma(float l, float r, float acc) { precise float t = l * r + acc; return half_round(t); }

layout(local_size_x = 32) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf  { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf { f16vec4   v4[]; };

layout(push_constant, scalar) uniform Push {
    HalfBuf a, b;
    FloatBuf c;      // fp32 out, or f16 out when bit12 of flags is set (bitcast)
    uint m, n, k, batch;
    uint sa, sb, sc; // per-batch element strides
    uint flags;
    uint lda, ldb, ldc;  // row strides; 0 = dense default (k / n / n)
    uint pad;
    uint64_t res;
    uint64_t skip;
    FloatBuf cosd;   // EPI_COSQKV: per-head attn_scale fp32 [H]
                     // (with epi==COSQKV: c/res/skip carry the oQW/oKW/oVW f16
                     //  bases instead of their residual-epilogue meanings)
} pc;

const uint TM = 8, TN = 16, TK = 16;
#ifndef GEMM_RN
#ifndef GEMM_RM
#define GEMM_RM 4
#endif
const uint RM = uint(GEMM_RM), RN = 2;   // default 32x32 tile per subgroup (optimal Xe2 occupancy)
#else
const uint RM = 2, RN = uint(GEMM_RN);   // M8a head variant: GEMM_RN=1 -> 16x16 tile
#endif
const uint BM = TM * RM, BN = TN * RN;

#ifndef ACC16
#define ACC16 1
#endif

#if ACC16
#define ACC float16_t
#else
#define ACC float
#endif

shared ACC stage[BM * BN];   // narrow-store staging only

void main() {
    uint row = gl_WorkGroupID.y * BM, col = gl_WorkGroupID.x * BN;
    if (row >= pc.m || col >= pc.n) return;
    uint batch = gl_WorkGroupID.z;
    uint ao = batch * pc.sa, bo = batch * pc.sb, co = batch * pc.sc;

    uint lda = pc.lda != 0u ? pc.lda : pc.k;
    uint ldb = pc.ldb != 0u ? pc.ldb : ((pc.flags & 1u) != 0u ? pc.k : pc.n);
    uint ldc = pc.ldc != 0u ? pc.ldc : pc.n;

    coopmat<ACC, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[RM][RN];
    for (uint i = 0u; i < RM; i++)
        for (uint j = 0u; j < RN; j++)
            acc[i][j] = coopmat<ACC, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(ACC(0.0));
    // K-loop software pipeline (M10): two tile slots, loads for t+1 issue
    // before the MMAs of t consume slot t, so global-load latency overlaps
    // XMX math. Math order is UNCHANGED (same TK tiles, same accumulate
    // sequence) - bit-exact vs the serial loop. Slot indices are compile-
    // time constants (dynamic coopmat array indexing would spill to scratch).
    coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a[2][RM];
    coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b[2][RN];
    const uint tiles = (pc.k + TK - 1u) / TK;

    if ((pc.flags & 1u) != 0u) {
        // B stored row-major as (N, K): element (n, k) at n*ldb + k. A ColumnMajor
        // coopmat load of that buffer yields the (K, N) tile = B^T.
        if (tiles == 1u) {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + (col + j * TN) * ldb, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
        } else if (tiles == 2u) {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + (col + j * TN) * ldb, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[1][j], pc.b.v, bo + (col + j * TN) * ldb + TK, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
        } else if (tiles == 4u) {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda + 0u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + (col + j * TN) * ldb + 0u * TK, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + 1u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[1][j], pc.b.v, bo + (col + j * TN) * ldb + 1u * TK, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda + 2u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + (col + j * TN) * ldb + 2u * TK, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + 3u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[1][j], pc.b.v, bo + (col + j * TN) * ldb + 3u * TK, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
        } else {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + (col + j * TN) * ldb, ldb,
                            gl_CooperativeMatrixLayoutColumnMajor);
            uint t = 0u;
            while (true) {
                if (t + 1u < tiles)
                    for (uint i = 0u; i < RM; i++)
                        coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + (t + 1u) * TK, lda,
                                    gl_CooperativeMatrixLayoutRowMajor);
                if (t + 1u < tiles)
                    for (uint j = 0u; j < RN; j++)
                        coopMatLoad(b[1][j], pc.b.v, bo + (col + j * TN) * ldb + (t + 1u) * TK, ldb,
                                    gl_CooperativeMatrixLayoutColumnMajor);
                for (uint i = 0u; i < RM; i++)
                    for (uint j = 0u; j < RN; j++)
                        acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
                ++t;
                if (t >= tiles) break;
                if (t + 1u < tiles)
                    for (uint i = 0u; i < RM; i++)
                        coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda + (t + 1u) * TK, lda,
                                    gl_CooperativeMatrixLayoutRowMajor);
                if (t + 1u < tiles)
                    for (uint j = 0u; j < RN; j++)
                        coopMatLoad(b[0][j], pc.b.v, bo + (col + j * TN) * ldb + (t + 1u) * TK, ldb,
                                    gl_CooperativeMatrixLayoutColumnMajor);
                for (uint i = 0u; i < RM; i++)
                    for (uint j = 0u; j < RN; j++)
                        acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
                ++t;
                if (t >= tiles) break;
            }
        }
    } else {
        if (tiles == 1u) {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
        } else if (tiles == 2u) {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[1][j], pc.b.v, bo + TK * ldb + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
        } else if (tiles == 4u) {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda + 0u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + 0u * TK * ldb + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + 1u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[1][j], pc.b.v, bo + 1u * TK * ldb + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda + 2u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + 2u * TK * ldb + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + 3u * TK, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[1][j], pc.b.v, bo + 3u * TK * ldb + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
            for (uint i = 0u; i < RM; i++)
                for (uint j = 0u; j < RN; j++)
                    acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
        } else {
            for (uint i = 0u; i < RM; i++)
                coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda, lda,
                            gl_CooperativeMatrixLayoutRowMajor);
            for (uint j = 0u; j < RN; j++)
                coopMatLoad(b[0][j], pc.b.v, bo + col + j * TN, ldb,
                            gl_CooperativeMatrixLayoutRowMajor);
            uint t = 0u;
            while (true) {
                if (t + 1u < tiles)
                    for (uint i = 0u; i < RM; i++)
                        coopMatLoad(a[1][i], pc.a.v, ao + (row + i * TM) * lda + (t + 1u) * TK, lda,
                                    gl_CooperativeMatrixLayoutRowMajor);
                if (t + 1u < tiles)
                    for (uint j = 0u; j < RN; j++)
                        coopMatLoad(b[1][j], pc.b.v, bo + (t + 1u) * TK * ldb + col + j * TN, ldb,
                                    gl_CooperativeMatrixLayoutRowMajor);
                for (uint i = 0u; i < RM; i++)
                    for (uint j = 0u; j < RN; j++)
                        acc[i][j] = coopMatMulAdd(a[0][i], b[0][j], acc[i][j]);
                ++t;
                if (t >= tiles) break;
                if (t + 1u < tiles)
                    for (uint i = 0u; i < RM; i++)
                        coopMatLoad(a[0][i], pc.a.v, ao + (row + i * TM) * lda + (t + 1u) * TK, lda,
                                    gl_CooperativeMatrixLayoutRowMajor);
                if (t + 1u < tiles)
                    for (uint j = 0u; j < RN; j++)
                        coopMatLoad(b[0][j], pc.b.v, bo + (t + 1u) * TK * ldb + col + j * TN, ldb,
                                    gl_CooperativeMatrixLayoutRowMajor);
                for (uint i = 0u; i < RM; i++)
                    for (uint j = 0u; j < RN; j++)
                        acc[i][j] = coopMatMulAdd(a[1][i], b[1][j], acc[i][j]);
                ++t;
                if (t >= tiles) break;
            }
        }
    }

    uint epilogue = (pc.flags >> 8) & 0xFu;
    bool narrow = (pc.flags & 0x1000u) != 0u;

    if (epilogue == 0u && !narrow) {
        for (uint i = 0u; i < RM; i++)
            for (uint j = 0u; j < RN; j++)
                if (row + i * TM < pc.m) {
#if ACC16
                    coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> wide =
                        coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(acc[i][j]);
                    coopMatStore(wide, pc.c.v, co + (row + i * TM) * ldc + col + j * TN,
                                 ldc, gl_CooperativeMatrixLayoutRowMajor);
#else
                    coopMatStore(acc[i][j], pc.c.v, co + (row + i * TM) * ldc + col + j * TN,
                                 ldc, gl_CooperativeMatrixLayoutRowMajor);
#endif
                }
        return;
    }

    if (epilogue == EPI_COSQKV) {
        // M12 cosw fusion: this N tile (BN=32 = head_dim) is exactly one
        // (qkv, head) 32-channel group for BM window tokens, batch = window.
        // cosw's per-(token,head) math is replayed verbatim per lane: lane l
        // owns tile row l (token row+l). c/res/skip = oQW/oKW/oVW f16 bases,
        // cosd = per-head attn_scale fp32 table; nothing is written to C.
        for (uint i = 0u; i < RM; i++)
            for (uint j = 0u; j < RN; j++)
                coopMatStore(acc[i][j], stage, i * TM * BN + j * TN, BN,
                             gl_CooperativeMatrixLayoutRowMajor);

        subgroupMemoryBarrierShared();
        subgroupBarrier();

        uint Cq = pc.n / 3u;                    // channels per qkv part (H*32)
        uint qkv = col / Cq;                    // 0=Q, 1=K, 2=V (32-aligned tiles)
        uint head = (col - qkv * Cq) / 32u;
        uint hcount = Cq / 32u;
        uint64_t dstBuf = (qkv == 0u) ? uint64_t(pc.c)
                        : (qkv == 1u) ? pc.res : pc.skip;
        float scale = half_round(pc.cosd.v[head]);   // consumed by Q only

        uint lane = gl_LocalInvocationID.x;
        uint t = row + lane;                    // window-local token row
        if (t < pc.m) {
            uint outBase = ((gl_WorkGroupID.z * hcount + head) * 64u + t) * 32u;
            uint rb = lane * BN;                // this token's row in the tile
            if (qkv == 2u) {
                // V: plain e4m3 publish (cosine_win V block, verbatim).
                for (uint k = 0u; k < 8u; k++) {
                    f16vec4 out4;
                    for (uint j = 0u; j < 4u; j++)
                        out4[j] = float16_t(e4m3(float(stage[rb + k * 4u + j])));
                    Half4Buf(dstBuf).v4[(outBase >> 2) + k] = out4;
                }
            } else {
                // Q/K: cosine_win normalizeAndWrite() verbatim on the staged
                // row - same fp16 islands, same XOR reduction tree.
                float h[32];
                for (uint k = 0u; k < 8u; k++)
                    for (uint j = 0u; j < 4u; j++)
                        h[k * 4u + j] = half_round(float(stage[rb + k * 4u + j]));

                float partial[4][2];
                for (uint ln = 0u; ln < 4u; ln++)
                    for (uint parity = 0u; parity < 2u; parity++) {
                        uint ch = ln * 2u + parity;
                        float first  = hfma(h[ch + 8u],  h[ch + 8u],  hmul(h[ch],       h[ch]));
                        float second = hfma(h[ch + 24u], h[ch + 24u], hmul(h[ch + 16u], h[ch + 16u]));
                        partial[ln][parity] = hadd(first, second);
                    }
                float two[4][2], one[4][2];
                for (uint ln = 0u; ln < 4u; ln++)
                    for (uint p = 0u; p < 2u; p++) two[ln][p] = hadd(partial[ln][p], partial[ln ^ 2u][p]);
                for (uint ln = 0u; ln < 4u; ln++)
                    for (uint p = 0u; p < 2u; p++) one[ln][p] = hadd(two[ln][p], two[ln ^ 1u][p]);

                float norm = max(hadd(one[0][0], one[0][1]), half_round(COSINE_NORM_FLOOR));
                float reciprocal = half_round(inversesqrt(norm));

                for (uint k = 0u; k < 8u; k++) {
                    f16vec4 out4;
                    for (uint j = 0u; j < 4u; j++) {
                        float value = hmul(h[k * 4u + j], reciprocal);
                        if (qkv == 0u) value = hmul(value, scale);   // Q only
                        out4[j] = float16_t(e4m3(value));
                    }
                    Half4Buf(dstBuf).v4[(outBase >> 2) + k] = out4;
                }
            }
        }
        return;
    }

    if (epilogue == EPI_RESIDUAL_FP32 || epilogue == EPI_RESIDUAL_F16) {
        for (uint i = 0u; i < RM; i++)
            for (uint j = 0u; j < RN; j++)
                coopMatStore(acc[i][j], stage, i * TM * BN + j * TN, BN,
                             gl_CooperativeMatrixLayoutRowMajor);

        subgroupMemoryBarrierShared();
        subgroupBarrier();

        for (uint e = gl_LocalInvocationID.x; e < BM * BN; e += 32u) {
            uint r = row + e / BN;
            uint c = col + e % BN;
            if (r >= pc.m || c >= pc.n) continue;
            uint ch = c % pc.n;
            uint idx = co + r * ldc + c;
            float resVal = (epilogue == EPI_RESIDUAL_F16)
                ? f16_widen(uint(float16BitsToUint16(HalfBuf(pc.res).v[idx])))
                : FloatBuf(pc.res).v[idx];
            float skipVal = FloatBuf(pc.skip).v[ch];
            float acc_val = float(stage[e]) + resVal * skipVal;
            pc.c.v[idx] = acc_val;
        }
        return;
    }

    for (uint i = 0u; i < RM; i++)
        for (uint j = 0u; j < RN; j++) {
            for (uint e = 0u; e < acc[i][j].length(); e++)
                acc[i][j][e] = ACC(publish(epilogue, float(acc[i][j][e])));
            if (narrow) {
                coopMatStore(acc[i][j], stage, i * TM * BN + j * TN, BN,
                             gl_CooperativeMatrixLayoutRowMajor);
                continue;
            }
            if (row + i * TM < pc.m) {
#if ACC16
                coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> wide =
                    coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(acc[i][j]);
                coopMatStore(wide, pc.c.v, co + (row + i * TM) * ldc + col + j * TN,
                             ldc, gl_CooperativeMatrixLayoutRowMajor);
#else
                coopMatStore(acc[i][j], pc.c.v, co + (row + i * TM) * ldc + col + j * TN,
                             ldc, gl_CooperativeMatrixLayoutRowMajor);
#endif
            }
        }
    if (!narrow) return;

    subgroupMemoryBarrierShared();
    subgroupBarrier();
    for (uint e = gl_LocalInvocationID.x * 4u; e < BM * BN; e += 32u * 4u) {
        uint r = row + e / BN;
        if (r >= pc.m) continue;
        uint at = co + r * ldc + col + e % BN;
        if ((at & 3u) == 0u && (uint(uint64_t(pc.c)) & 7u) == 0u) {
            Half4Buf(uint64_t(pc.c)).v4[at >> 2] =
                f16vec4(float(stage[e]), float(stage[e + 1u]),
                        float(stage[e + 2u]), float(stage[e + 3u]));
        } else {
            for (uint i = 0u; i < 4u; ++i)
                HalfBuf(uint64_t(pc.c)).v[at + i] = float16_t(stage[e + i]);
        }
    }
}
