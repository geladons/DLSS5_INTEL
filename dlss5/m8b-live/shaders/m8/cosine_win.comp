#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * cosine_win -- windowed Q/K/V fused publish (Q/K cosine normalized + V plain E4M3 publish).
 *
 * Same math as the M7-validated cosine.comp (SS A.5 fragment tree, fp16 islands), but
 * the proj input is WINDOW-order fp32 [W*64, 3C] and the outputs are [W, H, 64, 32] f16
 * (window-major, head-minor, then local token, then head_dim) for Q, K, and V.
 * Fused into a single unified kernel to eliminate 124 dispatches per frame.
 *
 * One invocation per (window-token, head) 32-channel vector; m = W*64*H.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require

#include "publish.glsl"

layout(local_size_x = 32) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf  { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf   { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer Float4Buf { vec4      v4[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf  { f16vec4   v4[]; };

layout(push_constant, scalar) uniform Push {
    FloatBuf a;      // proj fp32 [W*64, 3C]
    HalfBuf  q;      // out Q f16 [W, H, 64, 32]
    HalfBuf  k;      // out K f16 [W, H, 64, 32]
    HalfBuf  v;      // out V f16 [W, H, 64, 32]
    FloatBuf d;      // per-head fp32 scale (for Q)
    uint m;          // vector count = W*64*H
    uint C;          // channel count = H*32
    uint hcount;     // H (heads)
} pc;

const float COSINE_NORM_FLOOR = 0.00006198883056640625;

float hmul(float l, float r) { precise float t = l * r; return half_round(t); }
float hadd(float l, float r) { precise float t = l + r; return half_round(t); }
float hfma(float l, float r, float acc) { precise float t = l * r + acc; return half_round(t); }

void normalizeAndWrite(uint rd, uint outBase, uint64_t dstBuf, float scale, bool hasScale) {
    float h[32];
    for (uint k = 0u; k < 8u; k++) {
        vec4 in4 = Float4Buf(uint64_t(pc.a)).v4[(rd >> 2) + k];
        h[k * 4u + 0u] = half_round(in4.x);
        h[k * 4u + 1u] = half_round(in4.y);
        h[k * 4u + 2u] = half_round(in4.z);
        h[k * 4u + 3u] = half_round(in4.w);
    }

    float partial[4][2];
    for (uint lane = 0u; lane < 4u; lane++)
        for (uint parity = 0u; parity < 2u; parity++) {
            uint ch = lane * 2u + parity;
            float first  = hfma(h[ch + 8u],  h[ch + 8u],  hmul(h[ch],       h[ch]));
            float second = hfma(h[ch + 24u], h[ch + 24u], hmul(h[ch + 16u], h[ch + 16u]));
            partial[lane][parity] = hadd(first, second);
        }
    float two[4][2], one[4][2];
    for (uint lane = 0u; lane < 4u; lane++)
        for (uint p = 0u; p < 2u; p++) two[lane][p] = hadd(partial[lane][p], partial[lane ^ 2u][p]);
    for (uint lane = 0u; lane < 4u; lane++)
        for (uint p = 0u; p < 2u; p++) one[lane][p] = hadd(two[lane][p], two[lane ^ 1u][p]);

    float norm = max(hadd(one[0][0], one[0][1]), half_round(COSINE_NORM_FLOOR));
    float reciprocal = half_round(inversesqrt(norm));

    for (uint k = 0u; k < 8u; k++) {
        f16vec4 out4;
        for (uint j = 0u; j < 4u; j++) {
            uint i = k * 4u + j;
            float value = hmul(h[i], reciprocal);
            if (hasScale) value = hmul(value, scale);
            out4[j] = float16_t(e4m3(value));
        }
        Half4Buf(dstBuf).v4[(outBase >> 2) + k] = out4;
    }
}

void main() {
    uint vIdx = gl_GlobalInvocationID.x;
    if (vIdx >= pc.m) return;

    uint wt = vIdx / pc.hcount;
    uint head = vIdx % pc.hcount;
    uint w = wt / 64u, t = wt % 64u;
    uint outBase = ((w * pc.hcount + head) * 64u + t) * 32u;

    // Process V
    uint rdV = wt * (3u * pc.C) + 2u * pc.C + head * 32u;
    for (uint k = 0u; k < 8u; k++) {
        vec4 in4 = Float4Buf(uint64_t(pc.a)).v4[(rdV >> 2) + k];
        Half4Buf(uint64_t(pc.v)).v4[(outBase >> 2) + k] = f16vec4(
            float16_t(e4m3(in4.x)),
            float16_t(e4m3(in4.y)),
            float16_t(e4m3(in4.z)),
            float16_t(e4m3(in4.w))
        );
    }

    // Process Q
    uint rdQ = wt * (3u * pc.C) + 0u * pc.C + head * 32u;
    float scale = half_round(pc.d.v[head]);
    normalizeAndWrite(rdQ, outBase, uint64_t(pc.q), scale, true);

    // Process K
    uint rdK = wt * (3u * pc.C) + 1u * pc.C + head * 32u;
    normalizeAndWrite(rdK, outBase, uint64_t(pc.k), 1.0, false);
}
