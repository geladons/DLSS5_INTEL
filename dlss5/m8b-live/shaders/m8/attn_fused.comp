#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * attn_fused.comp -- Direct-Cache Fused Flash-Attention kernel.
 *
 * 1 SIMD32 wave per workgroup (local_size_x = 32), 2 workgroups per (window, head):
 *   - half 0: tokens 0..31 of the window
 *   - half 1: tokens 32..63 of the window
 *
 * Architecture:
 *   - Q[32, 32] staged in shared memory (2 KB).
 *   - K[64, 32] and V[64, 32] streamed directly from L1/L2 cache (pc.k, pc.v)
 *     using coopMatLoad. Eliminates 8 KB shared staging and 16-way bank conflicts.
 *   - S/P[32, 64] stored in shared memory with PADDED stride = 68 (4.25 KB)
 *     to mathematically eliminate all shared memory bank conflicts (gcd(68,32)=4).
 *   - Total shared memory: ONLY 6.25 KB (down from 48 KB hardware cap).
 *   - Wave occupancy: maximum 8 threads/EU on Battlemage Xe2.
 *   - Dispatches: Ww * H * 2 workgroups.
 *   - DRAM traffic for score (oSCW) and prob (oPRW) matrices: 0 bytes.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_shader_subgroup_basic : require

#include "publish.glsl"

layout(local_size_x = 32) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf  { float     v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf   { float16_t v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 8)  buffer Half4Buf  { f16vec4   v4[]; };

layout(push_constant, scalar) uniform Push {
    uint64_t q;        // oQW f16 [Ww*H, 64, 32]
    uint64_t k;        // oKW f16 [Ww*H, 64, 32]
    uint64_t v;        // oVW f16 [Ww*H, 64, 32]
    uint64_t bias;     // attn_bias f16 [H, 64, 64] or 0
    uint64_t dst;      // oMGW fp32 [Ww*H, 64, 32] output; flags bit0: oATW f16
    uint     Ww;       // number of windows
    uint     H;        // number of heads
    uint     flags;    // bit0: fused transpose store -> dst is oATW f16
                       // token-major [Ww, 64, C] (C = H*32), e4m3 published
} pc;

const uint TM = 8u, TN = 16u, TK = 16u;
const uint RM = 4u, RN = 2u;
const uint BM = TM * RM;  // 32
const uint BN = TN * RN;  // 32
const uint PADDED_STRIDE = 66u; // 64 cols + 2 pad: odd 33-word row stride -> zero bank conflicts

const uint STAGE_STRIDE = 34u; // f16 O staging overlay inside sS: odd 17-word stride

shared float16_t sS[32 * PADDED_STRIDE];     // 4224 bytes (scores/probs, then O staging)

/* local_size_x = 32 == one subgroup: a subgroup-scope barrier + SLM memory
 * barrier is the exact legal sync for every hand-off below (cheaper than a
 * full workgroup-scope barrier() which must cater for multi-wave wgs). */
#define WAVE_SYNC() do { subgroupMemoryBarrierShared(); subgroupBarrier(); } while (false)

void main() {
    uint halfId = gl_WorkGroupID.x;
    if (halfId >= pc.Ww * pc.H * 2u) return;

    uint wh = halfId / 2u;
    uint halfIdx = halfId % 2u;
    uint rowBase = halfIdx * 32u;
    uint head = wh % pc.H;
    uint tid = gl_LocalInvocationID.x;  // 0..31

    // ================================================================
    // PHASE 2: S[32, 64] = Q[32, 32] @ K[64, 32]^T
    // Q direct from L1/L2 (pc.q) - sQ staging removed. The A fragments
    // (4 row-tiles x 2 k-steps) are identical for both column passes -
    // load them once, reuse; K^T streams from L1/L2 per pass.
    // ================================================================
    uint qBase = (wh * 64u + rowBase) * 32u;
    uint kBase = wh * (64u * 32u);
    {
        coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a[2][RM];
        for (uint t = 0u; t < 2u; ++t)
            for (uint i = 0u; i < RM; ++i)
                coopMatLoad(a[t][i], HalfBuf(pc.q).v, qBase + (i * TM) * 32u + t * TK, 32u,
                            gl_CooperativeMatrixLayoutRowMajor);

        for (uint colPass = 0u; colPass < 2u; ++colPass) {
            uint colBase = colPass * BN;

            coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> acc[RM][RN];
            for (uint i = 0u; i < RM; ++i)
                for (uint j = 0u; j < RN; ++j)
                    acc[i][j] = coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(float16_t(0.0));

            for (uint t = 0u; t < 2u; ++t) {
                coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> b[RN];
                for (uint j = 0u; j < RN; ++j)
                    coopMatLoad(b[j], HalfBuf(pc.k).v, kBase + (colBase + j * TN) * 32u + t * TK, 32u,
                                gl_CooperativeMatrixLayoutColumnMajor);
                for (uint i = 0u; i < RM; ++i)
                    for (uint j = 0u; j < RN; ++j)
                        acc[i][j] = coopMatMulAdd(a[t][i], b[j], acc[i][j]);
            }

            // Store S tile directly to shared memory sS [32, 66] (bank-conflict free)
            for (uint i = 0u; i < RM; ++i)
                for (uint j = 0u; j < RN; ++j)
                    coopMatStore(acc[i][j], sS, (i * TM) * PADDED_STRIDE + colBase + j * TN,
                                 PADDED_STRIDE, gl_CooperativeMatrixLayoutRowMajor);
        }
    }

    WAVE_SYNC();

    // ================================================================
    // PHASE 3: On-Chip Softmax (M7b Bit-Affine, Exact Match)
    // ================================================================
    uint vBase = wh * (64u * 32u);
    coopmat<float16_t, gl_ScopeSubgroup, TK, TN, gl_MatrixUseB> bV[2][RN];
    // V is independent of sS: issue the first k-step load BEFORE the
    // softmax stretch so its global latency overlaps phase-3 math.
    for (uint j = 0u; j < RN; ++j)
        coopMatLoad(bV[0][j], HalfBuf(pc.v).v, vBase + 0u * TK * 32u + j * TN, 32u,
                    gl_CooperativeMatrixLayoutRowMajor);
    {
        uint base = tid * PADDED_STRIDE;
        uint rowInWindow = rowBase + tid;
        uint bias4 = (pc.bias != 0u) ? ((head * 4096u + rowInWindow * 64u) >> 2u) : 0u;

        float total = 0.0;
        // Pass 3a: compute transformed weights and row total.
        // One f16vec4 bias fetch covers a 4-column quad; the per-element
        // math sequence (widen, add, half_round, scale, clamp, pair-pack)
        // is identical to the scalar loop - bit-exact. The transformed
        // packed pairs are kept in registers (pk[]) instead of bouncing
        // through sS: pass 3b re-unpacks the exact same f16 pair values.
        uint pk[32];
        if (pc.bias != 0u) {
            for (uint i = 0u; i < 16u; ++i) {
                f16vec4 b4 = Half4Buf(pc.bias).v4[bias4 + i];
                vec2 affine0, affine1;
                {
                    float logit = float(sS[base + i * 4u + 0u]) + float(b4.x);
                    precise float scaled = half_round(logit) * 0.044921875 + 1.30078125;
                    affine0.x = clamp(scaled, 1.03125, 1.5693359375);
                }
                {
                    float logit = float(sS[base + i * 4u + 1u]) + float(b4.y);
                    precise float scaled = half_round(logit) * 0.044921875 + 1.30078125;
                    affine0.y = clamp(scaled, 1.03125, 1.5693359375);
                }
                {
                    float logit = float(sS[base + i * 4u + 2u]) + float(b4.z);
                    precise float scaled = half_round(logit) * 0.044921875 + 1.30078125;
                    affine1.x = clamp(scaled, 1.03125, 1.5693359375);
                }
                {
                    float logit = float(sS[base + i * 4u + 3u]) + float(b4.w);
                    precise float scaled = half_round(logit) * 0.044921875 + 1.30078125;
                    affine1.y = clamp(scaled, 1.03125, 1.5693359375);
                }
                uint t0 = (packHalf2x16(affine0) << 5) + 0x7FF88000u;
                uint t1 = (packHalf2x16(affine1) << 5) + 0x7FF88000u;
                pk[i * 2u + 0u] = t0;
                pk[i * 2u + 1u] = t1;
                vec2 w0 = unpackHalf2x16(t0);
                vec2 w1 = unpackHalf2x16(t1);
                total += w0.x + w0.y;
                total += w1.x + w1.y;
            }
        } else {
            for (uint i = 0u; i < 16u; ++i) {
                vec2 affine0, affine1;
                {
                    precise float scaled = half_round(float(sS[base + i * 4u + 0u])) * 0.044921875 + 1.30078125;
                    affine0.x = clamp(scaled, 1.03125, 1.5693359375);
                }
                {
                    precise float scaled = half_round(float(sS[base + i * 4u + 1u])) * 0.044921875 + 1.30078125;
                    affine0.y = clamp(scaled, 1.03125, 1.5693359375);
                }
                {
                    precise float scaled = half_round(float(sS[base + i * 4u + 2u])) * 0.044921875 + 1.30078125;
                    affine1.x = clamp(scaled, 1.03125, 1.5693359375);
                }
                {
                    precise float scaled = half_round(float(sS[base + i * 4u + 3u])) * 0.044921875 + 1.30078125;
                    affine1.y = clamp(scaled, 1.03125, 1.5693359375);
                }
                uint t0 = (packHalf2x16(affine0) << 5) + 0x7FF88000u;
                uint t1 = (packHalf2x16(affine1) << 5) + 0x7FF88000u;
                pk[i * 2u + 0u] = t0;
                pk[i * 2u + 1u] = t1;
                vec2 w0 = unpackHalf2x16(t0);
                vec2 w1 = unpackHalf2x16(t1);
                total += w0.x + w0.y;
                total += w1.x + w1.y;
            }
        }

        // Pass 3b: normalize by reciprocal and apply e4m3.
        // unpackHalf2x16(pk[i]) yields the same f16 values the sS
        // round-trip produced, so p is bit-identical.
        float recip = half_round(1.0 / half_round(total));
        for (uint i = 0u; i < 32u; ++i) {
            vec2 w = unpackHalf2x16(pk[i]);
            precise float p0 = w.x * recip;
            precise float p1 = w.y * recip;
            sS[base + i * 2u + 0u] = float16_t(e4m3(half_round_hw(p0)));
            sS[base + i * 2u + 1u] = float16_t(e4m3(half_round_hw(p1)));
        }
    }

    WAVE_SYNC();

    // ================================================================
    // PHASE 4: O[32, 32] = P[32, 64] @ V[64, 32]
    // P from sS, V directly from L1/L2 cache (pc.v).
    // K-loop software pipeline (same shape as gemm's tiles==4 path):
    // loads for k-tile t+1 issue before the MMAs consuming slot t, so
    // load latency overlaps XMX math. Accumulate order t=0,1,2,3 is
    // unchanged -> bit-exact.
    // ================================================================
    {
        coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> accPV[RM][RN];
        for (uint i = 0u; i < RM; ++i)
            for (uint j = 0u; j < RN; ++j)
                accPV[i][j] = coopmat<float16_t, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(float16_t(0.0));

        coopmat<float16_t, gl_ScopeSubgroup, TM, TK, gl_MatrixUseA> a[2][RM];

        // slot0 <- t0 (b already loaded pre-softmax), slot1 <- t1
        for (uint i = 0u; i < RM; ++i)
            coopMatLoad(a[0][i], sS, (i * TM) * PADDED_STRIDE + 0u * TK, PADDED_STRIDE,
                        gl_CooperativeMatrixLayoutRowMajor);
        for (uint j = 0u; j < RN; ++j)
            coopMatLoad(bV[1][j], HalfBuf(pc.v).v, vBase + 1u * TK * 32u + j * TN, 32u,
                        gl_CooperativeMatrixLayoutRowMajor);
        for (uint i = 0u; i < RM; ++i)
            coopMatLoad(a[1][i], sS, (i * TM) * PADDED_STRIDE + 1u * TK, PADDED_STRIDE,
                        gl_CooperativeMatrixLayoutRowMajor);

        for (uint i = 0u; i < RM; ++i)
            for (uint j = 0u; j < RN; ++j)
                accPV[i][j] = coopMatMulAdd(a[0][i], bV[0][j], accPV[i][j]);

        // slot0 <- t2
        for (uint i = 0u; i < RM; ++i)
            coopMatLoad(a[0][i], sS, (i * TM) * PADDED_STRIDE + 2u * TK, PADDED_STRIDE,
                        gl_CooperativeMatrixLayoutRowMajor);
        for (uint j = 0u; j < RN; ++j)
            coopMatLoad(bV[0][j], HalfBuf(pc.v).v, vBase + 2u * TK * 32u + j * TN, 32u,
                        gl_CooperativeMatrixLayoutRowMajor);

        for (uint i = 0u; i < RM; ++i)
            for (uint j = 0u; j < RN; ++j)
                accPV[i][j] = coopMatMulAdd(a[1][i], bV[1][j], accPV[i][j]);

        // slot1 <- t3
        for (uint i = 0u; i < RM; ++i)
            coopMatLoad(a[1][i], sS, (i * TM) * PADDED_STRIDE + 3u * TK, PADDED_STRIDE,
                        gl_CooperativeMatrixLayoutRowMajor);
        for (uint j = 0u; j < RN; ++j)
            coopMatLoad(bV[1][j], HalfBuf(pc.v).v, vBase + 3u * TK * 32u + j * TN, 32u,
                        gl_CooperativeMatrixLayoutRowMajor);

        for (uint i = 0u; i < RM; ++i)
            for (uint j = 0u; j < RN; ++j)
                accPV[i][j] = coopMatMulAdd(a[0][i], bV[0][j], accPV[i][j]);
        for (uint i = 0u; i < RM; ++i)
            for (uint j = 0u; j < RN; ++j)
                accPV[i][j] = coopMatMulAdd(a[1][i], bV[1][j], accPV[i][j]);

        if ((pc.flags & 1u) != 0u) {
            // M13 fused transpose store: replicate transpose_we.comp bitwise.
            // The PV accumulator is ALREADY f16, so the old fp32 widening
            // stage (sO) is redundant: storing accPV fragments into sS
            // (dead after the last P-load above) and reading them back as
            // f16 widens to the exact same f32 values the sO path produced.
            // Bit-exact by construction; stride 34 keeps the row-gather
            // bank-conflict free (the old stride-32 f32 staging made every
            // lane hit the same bank).
            //   transpose_we: rd = ((w*H + hd)*64 + t)*32 + d   (oMGW fp32)
            //                 wr = (w*64 + t)*C + hd*32 + d     (oATW f16)
            // here wh = w*H + head and the tile row r is token t = rowBase + r.
            subgroupMemoryBarrierShared();  // ordering fence: P reads precede staging writes
            for (uint i = 0u; i < RM; ++i)
                for (uint j = 0u; j < RN; ++j)
                    coopMatStore(accPV[i][j], sS, (i * TM) * STAGE_STRIDE + j * TN,
                                 STAGE_STRIDE, gl_CooperativeMatrixLayoutRowMajor);

            WAVE_SYNC();

            uint w = wh / pc.H;
            uint C = pc.H * 32u;
            uint ioBase = (w * 64u + rowBase + tid) * C + head * 32u;
            uint rb = tid * STAGE_STRIDE;
            for (uint k = 0u; k < 8u; ++k) {
                f16vec4 out4 = f16vec4(
                    float16_t(e4m3(float(sS[rb + k * 4u + 0u]))),
                    float16_t(e4m3(float(sS[rb + k * 4u + 1u]))),
                    float16_t(e4m3(float(sS[rb + k * 4u + 2u]))),
                    float16_t(e4m3(float(sS[rb + k * 4u + 3u]))));
                Half4Buf(pc.dst).v4[(ioBase >> 2u) + k] = out4;
            }
        } else {
            // Store widened to fp32 directly into pc.dst (oMGW)
            uint outBase = (wh * 64u + rowBase) * 32u;
            for (uint i = 0u; i < RM; ++i)
                for (uint j = 0u; j < RN; ++j) {
                    coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator> wide =
                        coopmat<float, gl_ScopeSubgroup, TM, TN, gl_MatrixUseAccumulator>(accPV[i][j]);
                    coopMatStore(wide, FloatBuf(pc.dst).v,
                                 outBase + (i * TM) * 32u + j * TN,
                                 32u, gl_CooperativeMatrixLayoutRowMajor);
                }
        }
    }
}
