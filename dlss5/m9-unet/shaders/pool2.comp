#version 450
#extension GL_GOOGLE_include_directive : require
/*
 * pool2 — M9 U-Net 2x2 average pool (nr_model.average_pool2) with zero
 * pad-to-multiple-of-8 (pad_spatial_end, bottom/right only) fused:
 *   out[y, x, c] = 0.25 * sum_{dy,dx in {0,1}} in[2y+dy, 2x+dx, c]
 * where in reads outside (Hin, Win) return 0 (the pad). Output dims are
 * (Hpad/2, Wpad/2). Input is fp32 (raw window output, ds transitions) or f16
 * (e4m3-published b30 bridge input, flags bit0); output is f16: e4m3-rounded
 * (ds transitions, flags bit1) or plain half_round (b30 bridge).
 * One invocation per output token; loops channels.
 */
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_scalar_block_layout : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

#include "publish.glsl"

layout(local_size_x = 256) in;

layout(buffer_reference, scalar, buffer_reference_align = 16) buffer FloatBuf { float v[]; };
layout(buffer_reference, scalar, buffer_reference_align = 16) buffer HalfBuf  { float16_t v[]; };

layout(push_constant, scalar) uniform Push {
    uint64_t a;      // in: fp32 or f16 [Hin*Win*C]
    uint64_t c;      // out: f16 [(Hpad/2)*(Wpad/2)*C]
    uint Hin, Win;   // valid input dims (pre-pad)
    uint Wpad;       // padded width (output width = Wpad/2)
    uint C;
    uint n;          // output token count = (Hpad/2)*(Wpad/2)
    uint flags;      // bit0: input f16; bit1: output e4m3 (else half_round)
} pc;

void main() {
    uint t = gl_GlobalInvocationID.x;
    if (t >= pc.n) return;
    uint wout = pc.Wpad / 2u;
    uint y = t / wout, x = t % wout;
    uint y0 = y * 2u, x0 = x * 2u;
    bool inF16 = (pc.flags & 1u) != 0u;
    bool outE4 = (pc.flags & 2u) != 0u;
    uint dst = t * pc.C;
    for (uint ch = 0u; ch < pc.C; ++ch) {
        float acc = 0.0;
        // np fold order of average_pool2: ((a[0,0]+a[1,0])+a[0,1])+a[1,1]
        for (uint dx = 0u; dx < 2u; ++dx)
            for (uint dy = 0u; dy < 2u; ++dy) {
                uint yy = y0 + dy, xx = x0 + dx;
                float v = 0.0;
                if (yy < pc.Hin && xx < pc.Win) {
                    uint src = (yy * pc.Win + xx) * pc.C + ch;
                    v = inF16 ? f16_widen(uint(float16BitsToUint16(HalfBuf(pc.a).v[src])))
                              : FloatBuf(pc.a).v[src];
                }
                acc += v;
            }
        float m = acc * 0.25;
        HalfBuf(pc.c).v[dst + ch] = float16_t(outE4 ? e4m3(m) : half_round(m));
    }
}
